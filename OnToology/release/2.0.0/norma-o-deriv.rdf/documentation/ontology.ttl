@prefix : <https://w3id.org/def/norma-o/deriv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/def/norma-o/deriv#> .

<https://w3id.org/def/norma-o/deriv> rdf:type owl:Ontology ;
                                      owl:versionIRI <https://w3id.org/def/norma-o/deriv/1.0> ;
                                      owl:imports <http://www.w3.org/ns/prov-o> ,
                                                  <https://w3id.org/def/norma-o> ;
                                      <http://purl.org/dc/terms/bibliographicCitation> "Leyva-Sánchez, S. et al. (2026). NORMA-O Derivation module (Version 1.0) [Ontology]. https://w3id.org/def/norma-o/deriv/1.0"@en ;
                                      <http://purl.org/dc/terms/contributor> _:genid1 ,
                                                                             _:genid2 ;
                                      <http://purl.org/dc/terms/creator> _:genid3 ;
                                      <http://purl.org/dc/terms/description> "A companion module to the NORMA ontology for describing derived normative graphs: the activity that materialised them, the rule set and its version, and — crucially — the non-monotonic assumptions under which the conclusions hold. NORMA-O states what norms mean and how they defeat one another; this module states under what reading a particular set of conclusions was computed, so that a published derived graph is reproducible and cannot be mistaken for annotated fact."@en ;
                                      <http://purl.org/dc/terms/issued> "2026-11-09"^^xsd:date ;
                                      <http://purl.org/dc/terms/language> <http://id.loc.gov/vocabulary/iso639-1/en> ;
                                      <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                      <http://purl.org/dc/terms/modified> "2026-11-09"^^xsd:date ;
                                      <http://purl.org/dc/terms/publisher> _:genid4 ;
                                      <http://purl.org/dc/terms/source> <https://github.com/sheyls/NORMA-O> ;
                                      <http://purl.org/dc/terms/title> "NORMA-O Derivation: provenance and assumptions of derived normative conclusions"@en ;
                                      <http://purl.org/ontology/bibo/doi> "10.5281/zenodo.24116269" ;
                                      <http://purl.org/ontology/bibo/status> "Published"@en ;
                                      <http://purl.org/vocab/vann/preferredNamespacePrefix> "normad" ;
                                      <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/def/norma-o/deriv#" ;
                                      rdfs:comment "Companion module to NORMA-O 2.0 that describes derived normative graphs: the derivation activity, the rule set and version applied, the assumptions the conclusions depend on, and the prevalence orderings, norm evaluations and cycles they contain."@en ;
                                      rdfs:label "NORMA-O Derivation module"@en ;
                                      rdfs:seeAlso <https://w3id.org/def/norma-o> ;
                                      owl:versionInfo "1.0" ;
                                      <http://xmlns.com/foaf/0.1/logo> <https://sheyls.github.io/NORMA-O/release/2.0.0/norma-o-deriv-v1.svg> ;
                                      <https://schema.org/includedInDataCatalog> <https://zenodo.org/communities/norma> .

_:genid1 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "María Poveda-Villalón" .

_:genid2 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Víctor Rodríguez-Doncel" .

_:genid3 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Sheyla Leyva-Sánchez" .

_:genid4 rdf:type <http://xmlns.com/foaf/0.1/Organization> ;
          <http://xmlns.com/foaf/0.1/name> "NORMA project" .

