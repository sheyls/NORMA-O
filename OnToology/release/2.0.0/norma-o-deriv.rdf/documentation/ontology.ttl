#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/def/norma-o/deriv#citesCompetingPrinciple
:citesCompetingPrinciple rdf:type owl:ObjectProperty ;
                         rdfs:domain :PrevalenceCycle ;
                         rdfs:range <https://w3id.org/def/norma-o#ResolutionPrinciple> ;
                         rdfs:comment "Links a reported cycle to a resolution principle cited by one of the conflict defeaters on it. Two or more values are what make the cycle a second-degree conflict rather than an annotation error."@en ;
                         rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                         rdfs:label "cites competing principle"@en .


###  https://w3id.org/def/norma-o/deriv#computedUnderAssumption
:computedUnderAssumption rdf:type owl:ObjectProperty ;
                         rdfs:domain :DerivationActivity ;
                         rdfs:range :Assumption ;
                         rdfs:comment "Links a derivation activity to an assumption its conclusions depend on. Not functional: a derivation typically relies on several."@en ;
                         rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                         rdfs:label "computed under assumption"@en .


###  https://w3id.org/def/norma-o/deriv#evaluatedNorm
:evaluatedNorm rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :NormEvaluation ;
               rdfs:range <https://w3id.org/def/norma-o#NormativeContent> ;
               rdfs:comment "Links an evaluation to the normative content it is about."@en ;
               rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
               rdfs:label "evaluated norm"@en .


###  https://w3id.org/def/norma-o/deriv#forFactPattern
:forFactPattern rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :PrevalenceOrdering ;
                rdfs:range <https://w3id.org/def/norma-o#FactPattern> ;
                rdfs:comment "Links a prevalence ordering to the single described case it was computed for. Absent on the static ordering over the whole normative system."@en ;
                rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                rdfs:label "for fact pattern"@en .


###  https://w3id.org/def/norma-o/deriv#hasApplicabilityStatus
:hasApplicabilityStatus rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :NormEvaluation ;
                        rdfs:range :ApplicabilityStatus ;
                        rdfs:comment "Associates an evaluation with at most one applicability status: the outcome the case yields for that norm."@en ;
                        rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                        rdfs:label "has applicability status"@en .


###  https://w3id.org/def/norma-o/deriv#hasCycleKind
:hasCycleKind rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :PrevalenceCycle ;
              rdfs:range :CycleKind ;
              rdfs:comment "Associates a reported cycle with its legal reading."@en ;
              rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
              rdfs:label "has cycle kind"@en .


###  https://w3id.org/def/norma-o/deriv#inCycle
:inCycle rdf:type owl:ObjectProperty ;
         rdfs:domain :PrevalenceOrdering ;
         rdfs:range :PrevalenceCycle ;
         rdfs:comment "Links a prevalence ordering to a cycle found while computing it."@en ;
         rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
         rdfs:label "in cycle"@en .


###  https://w3id.org/def/norma-o/deriv#inOrdering
:inOrdering rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :NormEvaluation ;
            rdfs:range :PrevalenceOrdering ;
            rdfs:comment "Links an evaluation to the prevalence ordering it belongs to."@en ;
            rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
            rdfs:label "in ordering"@en .


###  https://w3id.org/def/norma-o/deriv#involvesNorm
:involvesNorm rdf:type owl:ObjectProperty ;
              rdfs:domain :PrevalenceCycle ;
              rdfs:range <https://w3id.org/def/norma-o#NormativeContent> ;
              rdfs:comment "Links a reported cycle to a norm lying on it."@en ;
              rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
              rdfs:label "involves norm"@en .


###  https://w3id.org/def/norma-o/deriv#isAssumptionOf
:isAssumptionOf rdf:type owl:ObjectProperty ;
                owl:inverseOf :computedUnderAssumption ;
                rdfs:domain :Assumption ;
                rdfs:range :DerivationActivity ;
                rdfs:comment "Links an assumption to the derivation activities that rely on it."@en ;
                rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                rdfs:label "is assumption of"@en .


###  https://w3id.org/def/norma-o/deriv#reachesParty
:reachesParty rdf:type owl:ObjectProperty ;
              rdfs:domain :NormEvaluation ;
              rdfs:range <https://w3id.org/def/norma-o#LegalParty> ;
              rdfs:comment "Links a norm evaluation to a concrete party the evaluated norm reaches in that case: either the norm addresses that party directly, or it addresses a role the case places the party in."@en ;
              rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
              rdfs:label "reaches party"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Case-relative by construction, because norma:RoleAssignment is: the same party is reached by different norms in different cases, which is the point of a provision such as article 25(1) of Regulation (EU) 2024/1689. Computed, never annotated — asserting it would desynchronise it from the roles and the facts it follows from."@en ,
                                                              "Reach and applicability are separate questions, and both are needed to answer “what applies to this party”. This property says the norm is ADDRESSED to the party in the case; normad:hasApplicabilityStatus says whether it applies at all. A norm may reach a party and still be normad:Defeated, normad:NotActivated or normad:Invalid, so a consumer joins the two rather than reading either alone."@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/def/norma-o/deriv#derivedGraph
:derivedGraph rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :DerivationActivity ;
              rdfs:range xsd:anyURI ;
              rdfs:comment "Name of the graph into which a derivation activity wrote its conclusions. Keeping derived conclusions in a named graph of their own is what allows them to be regenerated wholesale without touching the annotation graph."@en ;
              rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
              rdfs:label "derived graph"@en .


###  https://w3id.org/def/norma-o/deriv#isAcyclic
:isAcyclic rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :PrevalenceOrdering ;
           rdfs:range xsd:boolean ;
           rdfs:comment "Whether the defeat digraph of this ordering was found to be acyclic. Reported, never assumed: it is the by-product of the topological sort."@en ;
           rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
           rdfs:label "is acyclic"@en .


###  https://w3id.org/def/norma-o/deriv#prevalenceLevel
:prevalenceLevel rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :NormEvaluation ;
                 rdfs:range xsd:nonNegativeInteger ;
                 rdfs:comment "The rung of the ladder: 0 for a norm that nothing prevails over, and otherwise one more than the highest level among the norms that prevail over it. Longest-path layering, so the level is canonical for a given digraph."@en ;
                 rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                 rdfs:label "prevalence level"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A low level means nothing defeats the norm, not that the norm prevails: a norm at level 0 may still be invalid or untriggered, and a norm at a higher level may well apply because everything that defeats it is itself defeated. The level orders the digraph; normad:hasApplicabilityStatus says what the case yields. Computed on the CONDENSATION of the digraph into strongly connected components, so every norm in the system receives a rung: a cycle contracts to a single node and the norms on it share its level. Layering on the digraph itself would leave the acyclic DESCENDANTS of a cycle without a level, although their position in the ladder is perfectly determined by the norms above and below them."@en .


###  https://w3id.org/def/norma-o/deriv#ruleSetVersion
:ruleSetVersion rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :DerivationActivity ;
                rdfs:range xsd:string ;
                rdfs:comment "Identifier of the rule set, and of its version, applied by a derivation activity. Two runs that report the same rule set version over the same input graph must produce the same output graph."@en ;
                rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                rdfs:label "rule set version"@en .


###  https://w3id.org/def/norma-o/deriv#stratumCount
:stratumCount rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :PrevalenceOrdering ;
              rdfs:range xsd:nonNegativeInteger ;
              rdfs:comment "Number of rungs in the ladder: one more than the highest prevalence level reached."@en ;
              rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
              rdfs:label "stratum count"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class .


###  https://w3id.org/def/norma-o#FactPattern
<https://w3id.org/def/norma-o#FactPattern> rdf:type owl:Class .


###  https://w3id.org/def/norma-o#LegalParty
<https://w3id.org/def/norma-o#LegalParty> rdf:type owl:Class .


###  https://w3id.org/def/norma-o#NormativeContent
<https://w3id.org/def/norma-o#NormativeContent> rdf:type owl:Class .


###  https://w3id.org/def/norma-o#ResolutionPrinciple
<https://w3id.org/def/norma-o#ResolutionPrinciple> rdf:type owl:Class .


###  https://w3id.org/def/norma-o/deriv#ApplicabilityStatus
:ApplicabilityStatus rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                     rdfs:comment "The label assigned to a norm by evaluating a described case: whether the norm applies to it, and if not, why not."@en ;
                     rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                     rdfs:label "Applicability Status"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Five values, and three different reasons a norm may fail to apply, which a consumer must be able to tell apart: it may have left the normative system (normad:Invalid), it may be in the system but untriggered by the facts of the case (normad:NotActivated), or it may be triggered and then set aside by a defeater (normad:Defeated). The values are assigned in that order of precedence, so that the most basic reason is the one reported: validity first, activation next, and the defeat labelling only for norms that are valid and activated."@en ,
                                                                     "Named for APPLICABILITY and not for being in force, because NORMA-O separates the two and this evaluation settles only the second: in legal usage a norm is in force as a matter of temporal validity, which norma:TemporalDefeater and norma:NormStatus govern, whereas what a case decides is whether the norm reaches that case. Calling an excepted norm “not in force” would contradict the very distinction the defeasibility layer is built on, since an exception leaves the norm in the system."@en .


###  https://w3id.org/def/norma-o/deriv#Assumption
:Assumption rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
            rdfs:comment "A non-monotonic reading adopted by a derivation activity, without which its conclusions do not follow."@en ;
            rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
            rdfs:label "Assumption"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Extensible: add further assumptions as new derivation layers are defined. Each value names something the annotation graph does not state and the derivation nevertheless relies on."@en ,
                                                            "Some values are mutually exclusive — a closed and an open reading of the case, or defeat considered and not considered — but that exclusion constrains the set of values one activity may carry, which OWL cannot express: it is a constraint on the values of normad:computedUnderAssumption for a single subject. Validate it with SHACL."@en .


###  https://w3id.org/def/norma-o/deriv#CycleKind
:CycleKind rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:comment "The legal reading of a cycle in the defeat digraph."@en ;
           rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
           rdfs:label "Cycle Kind"@en .


###  https://w3id.org/def/norma-o/deriv#DerivationActivity
:DerivationActivity rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :computedUnderAssumption ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Assumption
                                    ] ;
                    rdfs:comment "A provenance activity that materialises normative conclusions from a NORMA annotation graph: deontic closure, weak permissions, typed prevalence edges, or a prevalence ordering."@en ;
                    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                    rdfs:label "Derivation Activity"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "At least one assumption must be recorded. A derived graph with no stated assumptions is not interpretable: the same annotation graph yields different conclusions under different readings of silence, of defeat, and of graph completeness."@en ,
                                                                    "Distinct from norma:AnnotationActivity, which produces annotations from legal sources. A DerivationActivity consumes an annotation graph and produces consequences of it; its output is regenerated rather than maintained, and must never be merged back into the annotation graph. Use prov:used for the input graph, prov:startedAtTime for the run, and normad:ruleSetVersion for the rule set that was applied."@en .


###  https://w3id.org/def/norma-o/deriv#NormEvaluation
:NormEvaluation rdf:type owl:Class ;
                rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :evaluatedNorm ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass <https://w3id.org/def/norma-o#NormativeContent>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :inOrdering ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :PrevalenceOrdering
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasApplicabilityStatus ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :ApplicabilityStatus
                                ] ;
                rdfs:comment "The outcome computed for one norm within one prevalence ordering: its level in the ladder and whether the norm applies to the case."@en ;
                rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                rdfs:label "Norm Evaluation"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Reified following the W3C n-ary relation pattern, as norma:TriggerEvent, norma:LegalPosition, norma:Defeater and norma:WeakPermission are. Reification is not optional here: one norm has as many outcomes as there are cases evaluated, so the status cannot be a property of the norm itself."@en ,
                                                                "The status is optional, and its absence is meaningful: an evaluation belonging to the STATIC ordering carries a level and no status, because the static ladder orders the normative system without deciding any case. Only a case-relative ordering yields a status."@en .


###  https://w3id.org/def/norma-o/deriv#PrevalenceCycle
:PrevalenceCycle rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :involvesNorm ;
                                   owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                   owl:onClass <https://w3id.org/def/norma-o#NormativeContent>
                                 ] ;
                 rdfs:comment "A cycle found in a defeat digraph, reported rather than resolved. Full acyclicity is not expressible in OWL 2 DL, so it is checked by the compilation step: Kahn’s algorithm yields the stratification and the set of nodes it cannot order, while the cycles themselves are the non-trivial strongly connected components of that set."@en ;
                 rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                 rdfs:label "Prevalence Cycle"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A cycle is not automatically an error. Per norma:ConflictDefeater, two conflict defeaters relating the same pair in opposite directions under DIFFERENT resolution principles are a second-degree conflict in Bobbio’s sense: the criteria are genuinely unordered for that pair, and the compilation step must report one ordering per admissible policy instead of silently choosing one. The same pair asserted under the SAME principle is, by contrast, a contradiction in the annotation. normad:CycleKind records which reading applies."@en ,
                                                                 "Lying on a cycle does NOT by itself leave a norm undecided, and the two must not be conflated. Grounded semantics still decides a cycle that is attacked from outside it: where a and b defeat each other and an undefeated c defeats a, the labelling is c applicable, a defeated and b applicable, because b is reinstated once its only attacker falls. Conversely a norm OFF the cycle whose only attackers lie on an undecided one is itself undecided. So normad:Undecided tracks what the fixpoint leaves unlabelled, not cycle membership, and this class reports the cycle as a finding about the annotation independently of how the norms on it end up labelled."@en .


###  https://w3id.org/def/norma-o/deriv#PrevalenceOrdering
:PrevalenceOrdering rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                    rdfs:comment "A computed stratification of a defeat digraph: the “ladder” obtained by flattening the asserted defeaters into prevalence edges and ordering the nodes topologically."@en ;
                    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                    rdfs:label "Prevalence Ordering"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "NORMA-O deliberately represents no prevalence level and no defeat status: norma:FactPattern states that the resulting applicability follows from the described facts and the asserted defeaters, and norma:prevailsOver states that a compilation step may materialise the stratification in a separate derived artefact. This class is that artefact’s root, which is why it lives in the module and not in the core ontology."@en ,
                                                                    "Temporal defeat is also applied FLATLY, where defeat inside the ordering is evaluated under grounded semantics, and the asymmetry is substantive rather than technical: repealing a repealing norm does not revive the norm it repealed, so a chain in which w1 repeals w2 and w2 repealed w3 leaves both w2 and w3 outside the system. A norm merely rendered inapplicable by an exception is reinstated when that exception falls, because it never left the system; a repealed norm has left it. The reading is a DEFAULT recorded as an assumption, not a universal claim. It follows the civil-law tradition, where article 2.2 of the Spanish Civil Code states it expressly, but interpretation acts differ across jurisdictions and nothing in the ontology settles the question: a consumer whose jurisdiction provides otherwise overrides the reading and says so in the activity’s assumptions."@en ,
                                                                    "Temporal defeat is applied before the ordering is built, not as an edge in it. norma:TemporalDefeater bears on validity rather than applicability, so a norm it withdraws is absent from the system being stratified."@en ,
                                                                    "Without normad:forFactPattern the ordering is the STATIC one over the whole normative system, computed on the ungated projection of the defeat digraph; with it, the ordering is case-relative and only the defeaters whose gate fires in that case contribute edges. The two are different graphs and must not be mixed: norma:prevailsOver is the ungated projection, because the property chain that defines it drops norma:appliesWhen, so case evaluation has to traverse the reified norma:Defeater instead."@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/def/norma-o/deriv#AnnotationContradiction
:AnnotationContradiction rdf:type owl:NamedIndividual ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                                  :CycleKind ;
                         rdfs:comment "The cycle is formed by conflict defeaters citing the SAME resolution principle in opposite directions, which one principle cannot sustain."@en ;
                         rdfs:label "Annotation contradiction"@en ;
                         <http://www.w3.org/2004/02/skos/core#inScheme> :CycleKindScheme ;
                         <http://www.w3.org/2004/02/skos/core#notation> "ANNOTATION_CONTRADICTION" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Annotation contradiction"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "An annotation defect to be fixed at source, unlike normad:SecondDegreeConflict."@en ;
                         <http://www.w3.org/2004/02/skos/core#topConceptOf> :CycleKindScheme .


###  https://w3id.org/def/norma-o/deriv#ApplicabilityStatusScheme
:ApplicabilityStatusScheme rdf:type owl:NamedIndividual ,
                                    <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                           rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                           <http://www.w3.org/2004/02/skos/core#definition> "SKOS concept scheme grouping the labels a case evaluation may assign to a norm: whether it applies, and if not, whether because it is outside the system, untriggered, defeated, or left undecided."@en ;
                           <http://www.w3.org/2004/02/skos/core#hasTopConcept> :Applicable ,
                                                                               :Defeated ,
                                                                               :Invalid ,
                                                                               :NotActivated ,
                                                                               :Undecided ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Applicability status scheme"@en .


###  https://w3id.org/def/norma-o/deriv#Applicable
:Applicable rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos/core#Concept> ,
                     :ApplicabilityStatus ;
            rdfs:comment "The norm is valid, is activated by the facts of the case, and every defeater reaching it is itself defeated — or none reaches it. It applies."@en ;
            rdfs:label "Applicable"@en ;
            <http://www.w3.org/2004/02/skos/core#inScheme> :ApplicabilityStatusScheme ;
            <http://www.w3.org/2004/02/skos/core#notation> "APPLICABLE" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Applicable"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Reinstatement lands here. A norm set aside by a defeater whose own defeating norm is defeated becomes applicable again, which is why norma:prevailsOver is deliberately not transitive."@en ;
            <http://www.w3.org/2004/02/skos/core#topConceptOf> :ApplicabilityStatusScheme .


###  https://w3id.org/def/norma-o/deriv#AssumptionScheme
:AssumptionScheme rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                  rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Extensible SKOS concept scheme grouping the non-monotonic assumptions that NORMA derivation activities may rely on."@en ;
                  <http://www.w3.org/2004/02/skos/core#hasTopConcept> :ClosedCaseDescription ,
                                                                      :ClosedGraph ,
                                                                      :DefeatConsidered ,
                                                                      :DefeatNotConsidered ,
                                                                      :GroundedSemantics ,
                                                                      :InstitutionalFactsChained ,
                                                                      :OpenCounterparty ,
                                                                      :ReinstatementNotComputed ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Assumption scheme"@en .


###  https://w3id.org/def/norma-o/deriv#ClosedCaseDescription
:ClosedCaseDescription rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos/core#Concept> ,
                                :Assumption ;
                       rdfs:comment "Silence in a norma:FactPattern about a legal condition is read as that condition not holding, so a norm conditioned on it counts as inactive."@en ;
                       rdfs:label "Closed case description"@en ;
                       <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
                       <http://www.w3.org/2004/02/skos/core#notation> "CLOSED_CASE" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Closed case description"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "The description of the case is taken to be complete. This is what makes a conclusion case-relative and precise — a conditional prohibition does not block in the cases where its condition is not activated — but it also means an incompletely described case yields conclusions that are stronger than the facts warrant. Completeness of the fact pattern is a data-quality obligation on the producer, not something the derivation can check."@en ;
                       <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#ClosedGraph
:ClosedGraph rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos/core#Concept> ,
                      :Assumption ;
             rdfs:comment "The absence of a norm from the evaluated graph is read as the absence of that norm from the normative system: negation by failure over the graph at hand."@en ;
             rdfs:label "Closed graph"@en ;
             <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
             <http://www.w3.org/2004/02/skos/core#notation> "CLOSED_GRAPH" ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Closed graph"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Every weak permission depends on this assumption, since a weak permission is the absence of a prohibition. Pair it with a bounded completeness claim about which sources were analysed, or the conclusion is only as strong as the graph is complete."@en ;
             <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#CycleKindScheme
:CycleKindScheme rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                 rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
                 <http://www.w3.org/2004/02/skos/core#definition> "SKOS concept scheme grouping the legal readings of a cycle in the defeat digraph."@en ;
                 <http://www.w3.org/2004/02/skos/core#hasTopConcept> :AnnotationContradiction ,
                                                                     :IrresolubleAntinomy ,
                                                                     :SecondDegreeConflict ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Cycle kind scheme"@en .


###  https://w3id.org/def/norma-o/deriv#DefeatConsidered
:DefeatConsidered rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#Concept> ,
                           :Assumption ;
                  rdfs:comment "Defeat relations were taken into account: norms withdrawn by an applicable defeater were treated as not holding for the case."@en ;
                  rdfs:label "Defeat considered"@en ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
                  <http://www.w3.org/2004/02/skos/core#notation> "DEFEAT_CONSIDERED" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Defeat considered"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Pairs with normad:DefeatNotConsidered, which is recorded when defeat was skipped. Absence of both is not to be read as either: this is an open-world vocabulary, and inferring a reading from a missing value is the very thing the module exists to prevent. An activity recording neither has simply not stated what it did."@en ;
                  <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#DefeatNotConsidered
:DefeatNotConsidered rdf:type owl:NamedIndividual ,
                              <http://www.w3.org/2004/02/skos/core#Concept> ,
                              :Assumption ;
                     rdfs:comment "Defeat relations were ignored: every valid and activated norm was treated as applying, whatever defeaters reach it."@en ;
                     rdfs:label "Defeat not considered"@en ;
                     <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
                     <http://www.w3.org/2004/02/skos/core#notation> "DEFEAT_NOT_CONSIDERED" ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Defeat not considered"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "A legitimate reading for a fast or partial derivation, and the explicit complement of normad:DefeatConsidered, which exists so that no consumer has to infer the reading from a missing value. Conclusions recorded under it are wrong in exactly the cases the defeasibility layer exists to handle, such as an exception that exempts the agent, so they are provisional. Mutually exclusive with normad:DefeatConsidered; validate with SHACL."@en ;
                     <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#Defeated
:Defeated rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ,
                   :ApplicabilityStatus ;
          rdfs:comment "The norm is valid and activated, but at least one defeater reaching it has a defeating norm that is itself applicable. It does not apply to this case."@en ;
          rdfs:label "Defeated"@en ;
          <http://www.w3.org/2004/02/skos/core#inScheme> :ApplicabilityStatusScheme ;
          <http://www.w3.org/2004/02/skos/core#notation> "DEFEATED" ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Defeated"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Being defeated in a case says nothing about validity: the norm remains a member of the normative system and applies in cases where the defeater does not reach it. Contrast normad:Invalid."@en ;
          <http://www.w3.org/2004/02/skos/core#topConceptOf> :ApplicabilityStatusScheme .


###  https://w3id.org/def/norma-o/deriv#GroundedSemantics
:GroundedSemantics rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ,
                            :Assumption ;
                   rdfs:comment "Defeat was evaluated under Dung's grounded semantics: the unique minimal complete labelling, computed as a monotone fixpoint."@en ;
                   rdfs:label "Grounded semantics"@en ;
                   <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
                   <http://www.w3.org/2004/02/skos/core#notation> "GROUNDED" ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Grounded semantics"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Computed as a monotone fixpoint and deliberately NOT in topological order. A single pass in topological order is wrong wherever a cycle is attacked from outside it: the norms on the cycle are then decided after all, and a norm downstream of them has to be labelled from those decisions, which a pass that skipped the unorderable nodes never made."@en ,
                                                                   "Recorded instead of normad:ReinstatementNotComputed once reinstatement is actually computed. The choice of semantics is not neutral: on a cyclic fragment, preferred or stable semantics would select winners where grounded semantics reports normad:Undecided, so a consumer comparing two derived graphs must compare their assumptions first."@en ;
                   <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#InstitutionalFactsChained
:InstitutionalFactsChained rdf:type owl:NamedIndividual ,
                                    <http://www.w3.org/2004/02/skos/core#Concept> ,
                                    :Assumption ;
                           rdfs:comment "The facts established by the constitutive rules that apply were fed back into the case, and the regulative norms were evaluated against the case so augmented."@en ;
                           rdfs:label "Institutional facts chained"@en ;
                           <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
                           <http://www.w3.org/2004/02/skos/core#notation> "FACTS_CHAINED" ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Institutional facts chained"@en ;
                           <http://www.w3.org/2004/02/skos/core#scopeNote> "Its absence means norma:establishesTrigger was ignored and only the brute facts of the case were used. Conclusions computed that way are wrong wherever a regulative norm is conditioned on an institutional fact, which in Regulation (EU) 2024/1689 is the central case: the obligations of Articles 16 and 26 hang on being high-risk, and that is settled by the defeat chain of Article 6."@en ,
                                                                           "The alternation terminates because the set of established facts only grows. What it cannot do is undo: a fact may gate a defeater that withdraws the very rule that established it, and the fact stays in the case. A derivation that detects this reports it rather than presenting a conclusion that quietly rests on a withdrawn rule."@en ;
                           <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#Invalid
:Invalid rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                  :ApplicabilityStatus ;
         rdfs:comment "The norm is not a member of the normative system being evaluated: it carries a lifecycle status that excludes it, or a temporal defeater has repealed it."@en ;
         rdfs:label "Invalid"@en ;
         <http://www.w3.org/2004/02/skos/core#inScheme> :ApplicabilityStatusScheme ;
         <http://www.w3.org/2004/02/skos/core#notation> "INVALID" ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Invalid"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Reported rather than omitted. Leaving a repealed norm out of the evaluation would make it indistinguishable from a norm absent from the graph, and a consumer asking why a norm does not apply deserves the answer. This is the one value that concerns validity rather than applicability, and it is case-independent: a norm outside the system is outside it in every case."@en ;
         <http://www.w3.org/2004/02/skos/core#topConceptOf> :ApplicabilityStatusScheme .


###  https://w3id.org/def/norma-o/deriv#IrresolubleAntinomy
:IrresolubleAntinomy rdf:type owl:NamedIndividual ,
                              <http://www.w3.org/2004/02/skos/core#Concept> ,
                              :CycleKind ;
                     rdfs:comment "The cycle involves defeat that cites no resolution principle at all, typically a loop of exception defeaters, so nothing in the annotation orients it."@en ;
                     rdfs:label "Irresoluble antinomy"@en ;
                     <http://www.w3.org/2004/02/skos/core#inScheme> :CycleKindScheme ;
                     <http://www.w3.org/2004/02/skos/core#notation> "IRRESOLUBLE" ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Irresoluble antinomy"@en ;
                     <http://www.w3.org/2004/02/skos/core#topConceptOf> :CycleKindScheme .


###  https://w3id.org/def/norma-o/deriv#NotActivated
:NotActivated rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos/core#Concept> ,
                       :ApplicabilityStatus ;
              rdfs:comment "The norm is valid but the facts of the case do not trigger it: none of the trigger events that activate it fires in the described case."@en ;
              rdfs:label "Not activated"@en ;
              <http://www.w3.org/2004/02/skos/core#inScheme> :ApplicabilityStatusScheme ;
              <http://www.w3.org/2004/02/skos/core#notation> "NOT_ACTIVATED" ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Not activated"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinguished from normad:Defeated because the reasons differ and so do the remedies: an untriggered norm is simply silent about this case, whereas a defeated one spoke and was overridden. Collapsing the two would also report an untriggered norm as applicable merely because nothing defeats it, which is the conclusion this value exists to prevent."@en ,
                                                              "Several trigger events activating one norm are read in DISJUNCTION, as elsewhere in NORMA: the norm is activated if any of them fires. A norm with no activation condition at all is unconditional and never carries this value."@en ;
              <http://www.w3.org/2004/02/skos/core#topConceptOf> :ApplicabilityStatusScheme .


###  https://w3id.org/def/norma-o/deriv#OpenCounterparty
:OpenCounterparty rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#Concept> ,
                           :Assumption ;
                  rdfs:comment "A counterparty that no annotator named is read as not disagreeing, rather than as a mismatch, when two norms or two legal positions are compared."@en ;
                  rdfs:label "Open counterparty"@en ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
                  <http://www.w3.org/2004/02/skos/core#notation> "OPEN_COUNTERPARTY" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Open counterparty"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Needed because norma:hasCounterparty is sparse in practice: a corpus annotated without it would yield no equivalence, no contradiction and no jural opposition at all. The permissive reading lets those surface, at the cost of a relation that a later annotation may refute, which makes it non-monotonic. Producers that annotate the counterparty throughout get the strict reading for free and need not record this value."@en ;
                  <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#ReinstatementNotComputed
:ReinstatementNotComputed rdf:type owl:NamedIndividual ,
                                   <http://www.w3.org/2004/02/skos/core#Concept> ,
                                   :Assumption ;
                          rdfs:comment "Defeat was applied one level deep: a norm was treated as withdrawn whenever an applicable defeater exists, without checking whether that defeater is itself withdrawn."@en ;
                          rdfs:label "Reinstatement not computed"@en ;
                          <http://www.w3.org/2004/02/skos/core#inScheme> :AssumptionScheme ;
                          <http://www.w3.org/2004/02/skos/core#notation> "NO_REINSTATEMENT" ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Reinstatement not computed"@en ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Where a defeat chain is longer than one step, the conclusions are wrong: if A defeats B and B defeats C, then C is reinstated, and a one-level reading reports C as withdrawn. Computing reinstatement requires stratifying the prevalence digraph, which belongs to the evaluation layer, so a derivation that records this value is provisional for any case in which a defeater is itself defeated."@en ;
                          <http://www.w3.org/2004/02/skos/core#topConceptOf> :AssumptionScheme .


###  https://w3id.org/def/norma-o/deriv#SecondDegreeConflict
:SecondDegreeConflict rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#Concept> ,
                               :CycleKind ;
                      rdfs:comment "The norms on the cycle are related by conflict defeaters citing different resolution principles, so the criteria themselves are unordered for that pair."@en ;
                      rdfs:label "Second-degree conflict"@en ;
                      <http://www.w3.org/2004/02/skos/core#inScheme> :CycleKindScheme ;
                      <http://www.w3.org/2004/02/skos/core#notation> "SECOND_DEGREE" ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Second-degree conflict"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "A legal phenomenon in Bobbio's sense, not an annotation defect. The compilation step reports one prevalence ordering per admissible policy; normad:citesCompetingPrinciple names the criteria in competition."@en ;
                      <http://www.w3.org/2004/02/skos/core#topConceptOf> :CycleKindScheme .


###  https://w3id.org/def/norma-o/deriv#Undecided
:Undecided rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ,
                    :ApplicabilityStatus ;
           rdfs:comment "The asserted defeaters do not fix a label for the norm: the grounded fixpoint leaves it neither applicable nor defeated."@en ;
           rdfs:label "Undecided"@en ;
           <http://www.w3.org/2004/02/skos/core#inScheme> :ApplicabilityStatusScheme ;
           <http://www.w3.org/2004/02/skos/core#notation> "UNDECIDED" ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Undecided"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Choosing a winner here would require a policy the ontology does not fix. Preferred or stable semantics would select one; see normad:GroundedSemantics."@en ,
                                                           "Not an error value, and NOT a synonym for lying on a cycle. A cycle attacked from outside is still decided, while a norm off any cycle whose only attackers are undecided is itself undecided. What this value tracks is what the fixpoint leaves unlabelled; the cycle itself is reported separately with normad:PrevalenceCycle."@en ;
           <http://www.w3.org/2004/02/skos/core#topConceptOf> :ApplicabilityStatusScheme .


###  Generated by the OWL API (version 5.1.18) https://github.com/owlcs/owlapi/
