<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/def/norma-o/deriv#"
     xml:base="https://w3id.org/def/norma-o/deriv"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/def/norma-o/deriv">
        <owl:versionIRI rdf:resource="https://w3id.org/def/norma-o/deriv/1.0"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
        <owl:imports rdf:resource="https://w3id.org/def/norma-o"/>
        <terms:bibliographicCitation xml:lang="en">Leyva-Sánchez, S. et al. (2026). NORMA-O Derivation module (Version 1.0) [Ontology]. https://w3id.org/def/norma-o/deriv/1.0</terms:bibliographicCitation>
        <terms:contributor rdf:nodeID="genid1"/>
        <terms:contributor rdf:nodeID="genid2"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:description xml:lang="en">A companion module to the NORMA ontology for describing derived normative graphs: the activity that materialised them, the rule set and its version, and — crucially — the non-monotonic assumptions under which the conclusions hold. NORMA-O states what norms mean and how they defeat one another; this module states under what reading a particular set of conclusions was computed, so that a published derived graph is reproducible and cannot be mistaken for annotated fact.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-09</terms:issued>
        <terms:language rdf:resource="http://id.loc.gov/vocabulary/iso639-1/en"/>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-09</terms:modified>
        <terms:publisher rdf:nodeID="genid4"/>
        <terms:source rdf:resource="https://github.com/sheyls/NORMA-O"/>
        <terms:title xml:lang="en">NORMA-O Derivation: provenance and assumptions of derived normative conclusions</terms:title>
        <bibo:doi>10.5281/zenodo.24116269</bibo:doi>
        <bibo:status xml:lang="en">Published</bibo:status>
        <vann:preferredNamespacePrefix>normad</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/def/norma-o/deriv#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Companion module to NORMA-O 2.0 that describes derived normative graphs: the derivation activity, the rule set and version applied, the assumptions the conclusions depend on, and the prevalence orderings, norm evaluations and cycles they contain.</rdfs:comment>
        <rdfs:label xml:lang="en">NORMA-O Derivation module</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/def/norma-o"/>
        <owl:versionInfo>1.0</owl:versionInfo>
        <foaf:logo rdf:resource="https://sheyls.github.io/NORMA-O/release/2.0.0/norma-o-deriv-v1.svg"/>
        <schema:includedInDataCatalog rdf:resource="https://zenodo.org/communities/norma"/>
    </owl:Ontology>
    <rdf:Description rdf:nodeID="genid1">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:name>María Poveda-Villalón</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid2">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:name>Víctor Rodríguez-Doncel</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid3">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:name>Sheyla Leyva-Sánchez</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid4">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <foaf:name>NORMA project</foaf:name>
    </rdf:Description>
    


