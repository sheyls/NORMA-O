    <!-- https://w3id.org/def/norma-o/deriv#citesCompetingPrinciple -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#citesCompetingPrinciple">
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceCycle"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o#ResolutionPrinciple"/>
        <rdfs:comment xml:lang="en">Links a reported cycle to a resolution principle cited by one of the conflict defeaters on it. Two or more values are what make the cycle a second-degree conflict rather than an annotation error.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">cites competing principle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#computedUnderAssumption -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#computedUnderAssumption">
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#DerivationActivity"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o/deriv#Assumption"/>
        <rdfs:comment xml:lang="en">Links a derivation activity to an assumption its conclusions depend on. Not functional: a derivation typically relies on several.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">computed under assumption</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#evaluatedNorm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#evaluatedNorm">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#NormEvaluation"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links an evaluation to the normative content it is about.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">evaluated norm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#forFactPattern -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#forFactPattern">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceOrdering"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o#FactPattern"/>
        <rdfs:comment xml:lang="en">Links a prevalence ordering to the single described case it was computed for. Absent on the static ordering over the whole normative system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">for fact pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#hasApplicabilityStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#hasApplicabilityStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#NormEvaluation"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o/deriv#ApplicabilityStatus"/>
        <rdfs:comment xml:lang="en">Associates an evaluation with at most one applicability status: the outcome the case yields for that norm.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">has applicability status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#hasCycleKind -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#hasCycleKind">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceCycle"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o/deriv#CycleKind"/>
        <rdfs:comment xml:lang="en">Associates a reported cycle with its legal reading.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">has cycle kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#inCycle -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#inCycle">
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceOrdering"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceCycle"/>
        <rdfs:comment xml:lang="en">Links a prevalence ordering to a cycle found while computing it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">in cycle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#inOrdering -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#inOrdering">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#NormEvaluation"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceOrdering"/>
        <rdfs:comment xml:lang="en">Links an evaluation to the prevalence ordering it belongs to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">in ordering</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#involvesNorm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#involvesNorm">
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceCycle"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
        <rdfs:comment xml:lang="en">Links a reported cycle to a norm lying on it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">involves norm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#isAssumptionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#isAssumptionOf">
        <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o/deriv#computedUnderAssumption"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#Assumption"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o/deriv#DerivationActivity"/>
        <rdfs:comment xml:lang="en">Links an assumption to the derivation activities that rely on it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">is assumption of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#reachesParty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o/deriv#reachesParty">
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#NormEvaluation"/>
        <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalParty"/>
        <rdfs:comment xml:lang="en">Links a norm evaluation to a concrete party the evaluated norm reaches in that case: either the norm addresses that party directly, or it addresses a role the case places the party in.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">reaches party</rdfs:label>
        <skos:scopeNote xml:lang="en">Case-relative by construction, because norma:RoleAssignment is: the same party is reached by different norms in different cases, which is the point of a provision such as article 25(1) of Regulation (EU) 2024/1689. Computed, never annotated — asserting it would desynchronise it from the roles and the facts it follows from.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Reach and applicability are separate questions, and both are needed to answer “what applies to this party”. This property says the norm is ADDRESSED to the party in the case; normad:hasApplicabilityStatus says whether it applies at all. A norm may reach a party and still be normad:Defeated, normad:NotActivated or normad:Invalid, so a consumer joins the two rather than reading either alone.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/def/norma-o/deriv#derivedGraph -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o/deriv#derivedGraph">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#DerivationActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Name of the graph into which a derivation activity wrote its conclusions. Keeping derived conclusions in a named graph of their own is what allows them to be regenerated wholesale without touching the annotation graph.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">derived graph</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#isAcyclic -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o/deriv#isAcyclic">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceOrdering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the defeat digraph of this ordering was found to be acyclic. Reported, never assumed: it is the by-product of the topological sort.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">is acyclic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#prevalenceLevel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o/deriv#prevalenceLevel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#NormEvaluation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">The rung of the ladder: 0 for a norm that nothing prevails over, and otherwise one more than the highest level among the norms that prevail over it. Longest-path layering, so the level is canonical for a given digraph.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">prevalence level</rdfs:label>
        <skos:scopeNote xml:lang="en">A low level means nothing defeats the norm, not that the norm prevails: a norm at level 0 may still be invalid or untriggered, and a norm at a higher level may well apply because everything that defeats it is itself defeated. The level orders the digraph; normad:hasApplicabilityStatus says what the case yields. Computed on the CONDENSATION of the digraph into strongly connected components, so every norm in the system receives a rung: a cycle contracts to a single node and the norms on it share its level. Layering on the digraph itself would leave the acyclic DESCENDANTS of a cycle without a level, although their position in the ladder is perfectly determined by the norms above and below them.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#ruleSetVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o/deriv#ruleSetVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#DerivationActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifier of the rule set, and of its version, applied by a derivation activity. Two runs that report the same rule set version over the same input graph must produce the same output graph.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">rule set version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/norma-o/deriv#stratumCount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o/deriv#stratumCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/norma-o/deriv#PrevalenceOrdering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Number of rungs in the ladder: one more than the highest prevalence level reached.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o/deriv"/>
        <rdfs:label xml:lang="en">stratum count</rdfs:label>
    </owl:DatatypeProperty>
    


