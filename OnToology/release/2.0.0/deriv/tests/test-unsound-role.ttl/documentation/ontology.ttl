###  https://example.org/ur#Acme
:Acme rdf:type owl:NamedIndividual ,
               <https://w3id.org/def/norma-o#LegalParty> .


###  https://example.org/ur#C
:C rdf:type owl:NamedIndividual ,
            <https://w3id.org/def/norma-o#FactPattern> ;
   <https://w3id.org/def/norma-o#holdsRoleAssignment> :RA .


###  https://example.org/ur#Provider
:Provider rdf:type owl:NamedIndividual ,
                   <https://w3id.org/def/norma-o#LegalRole> .


###  https://example.org/ur#RA
:RA rdf:type owl:NamedIndividual ,
             <https://w3id.org/def/norma-o#RoleAssignment> ;
    <https://w3id.org/def/norma-o#assignedUnderRule> :fct25 ;
    <https://w3id.org/def/norma-o#hasAssignedParty> :Acme ;
    <https://w3id.org/def/norma-o#hasAssignedRole> :Provider .


###  https://example.org/ur#c
:c rdf:type owl:NamedIndividual ,
            <https://w3id.org/def/norma-o#LegalCondition> ;
   <https://w3id.org/def/norma-o#conditionStatement> "substantial modification?" ;
   <https://w3id.org/def/norma-o#hasTrigger> :te .


###  https://example.org/ur#fct25
:fct25 rdf:type owl:NamedIndividual ,
                <https://w3id.org/def/norma-o#ConstitutiveRule> ;
       <https://w3id.org/def/norma-o#confersRole> :Provider ;
       <https://w3id.org/def/norma-o#deonticId> "fct25" ;
       <https://w3id.org/def/norma-o#factStatement> "counts as provider" .


###  https://example.org/ur#te
:te rdf:type owl:NamedIndividual ,
             <https://w3id.org/def/norma-o#TriggerEvent> ;
    <https://w3id.org/def/norma-o#activatesNorm> :fct25 ;
    <https://w3id.org/def/norma-o#hasOutcome> <https://w3id.org/def/norma-o#TrueOutcome> .


