@prefix : <https://example.org/norma-test#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://example.org/norma-test#> .

<https://example.org/norma-test> rdf:type owl:Ontology ;
                                  owl:imports <https://w3id.org/def/norma-o> .

#################################################################
#    Annotation properties
#################################################################

###  https://w3id.org/def/norma-o#activatesNorm
<https://w3id.org/def/norma-o#activatesNorm> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#appliesWhen
<https://w3id.org/def/norma-o#appliesWhen> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#conditionStatement
<https://w3id.org/def/norma-o#conditionStatement> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#defeatedNorm
<https://w3id.org/def/norma-o#defeatedNorm> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#defeatingNorm
<https://w3id.org/def/norma-o#defeatingNorm> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#deonticId
<https://w3id.org/def/norma-o#deonticId> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#factStatement
<https://w3id.org/def/norma-o#factStatement> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#hasCounterparty
<https://w3id.org/def/norma-o#hasCounterparty> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#hasLegalAction
<https://w3id.org/def/norma-o#hasLegalAction> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#hasLegalAgent
<https://w3id.org/def/norma-o#hasLegalAgent> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#hasNormStatus
<https://w3id.org/def/norma-o#hasNormStatus> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#hasOutcome
<https://w3id.org/def/norma-o#hasOutcome> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#hasTrigger
<https://w3id.org/def/norma-o#hasTrigger> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#holdsTrigger
<https://w3id.org/def/norma-o#holdsTrigger> rdf:type owl:AnnotationProperty .


###  https://w3id.org/def/norma-o#isNegationOf
<https://w3id.org/def/norma-o#isNegationOf> rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/def/norma-o#ConstitutiveRule
<https://w3id.org/def/norma-o#ConstitutiveRule> rdf:type owl:Class .


