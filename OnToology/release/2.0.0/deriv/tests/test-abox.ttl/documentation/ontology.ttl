<https://w3id.org/def/norma-o#Recommendation> rdf:type owl:Class .


###  https://w3id.org/def/norma-o#TriggerEvent
<https://w3id.org/def/norma-o#TriggerEvent> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  https://example.org/norma-test#A
:A rdf:type owl:NamedIndividual ,
            <https://w3id.org/def/norma-o#LegalAgent> ;
   rdfs:label "agent A"@en .


###  https://example.org/norma-test#B
:B rdf:type owl:NamedIndividual ,
            <https://w3id.org/def/norma-o#LegalAgent> ;
   rdfs:label "agent B"@en .


###  https://example.org/norma-test#C
:C rdf:type owl:NamedIndividual ,
            <https://w3id.org/def/norma-o#LegalAgent> ;
   rdfs:label "C"@en .


###  https://example.org/norma-test#C1
:C1 rdf:type owl:NamedIndividual ,
             <https://w3id.org/def/norma-o#FactPattern> ;
    <https://w3id.org/def/norma-o#holdsTrigger> :te_c1_true ,
                                                :te_x_true .


###  https://example.org/norma-test#C2
:C2 rdf:type owl:NamedIndividual ,
             <https://w3id.org/def/norma-o#FactPattern> ;
    <https://w3id.org/def/norma-o#holdsTrigger> :te_c1_false .


###  https://example.org/norma-test#C3
:C3 rdf:type owl:NamedIndividual ,
             <https://w3id.org/def/norma-o#FactPattern> .


