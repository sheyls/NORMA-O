         <https://w3id.org/def/norma-o#deonticId> "fct_exc" ;
         <https://w3id.org/def/norma-o#factStatement> "The rule does not apply to the carved-out class." .


###  https://example.org/norma-test#fct_p1
:fct_p1 rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#ConstitutiveRule> ;
        <https://w3id.org/def/norma-o#deonticId> "fct_p1" ;
        <https://w3id.org/def/norma-o#factStatement> "exception not triggered in C1" .


###  https://example.org/norma-test#fct_p2
:fct_p2 rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#ConstitutiveRule> ;
        <https://w3id.org/def/norma-o#deonticId> "fct_p2" ;
        <https://w3id.org/def/norma-o#factStatement> "repealed exception" ;
        <https://w3id.org/def/norma-o#hasNormStatus> <https://w3id.org/def/norma-o#Superseded> .


