                 <https://w3id.org/def/norma-o#LegalAction> ;
        rdfs:label "eq"@en .


###  https://example.org/norma-test#eq_act_neg
:eq_act_neg rdf:type owl:NamedIndividual ,
                     <https://w3id.org/def/norma-o#LegalAction> ;
            rdfs:label "not eq"@en ;
            <https://w3id.org/def/norma-o#isNegationOf> :eq_act .


###  https://example.org/norma-test#fct_chain
:fct_chain rdf:type owl:NamedIndividual ,
                    <https://w3id.org/def/norma-o#ConstitutiveRule> ;
           <https://w3id.org/def/norma-o#deonticId> "fct_chain" ;
           <https://w3id.org/def/norma-o#factStatement> "intermediate carve-out" .


###  https://example.org/norma-test#fct_exc
:fct_exc rdf:type owl:NamedIndividual ,
