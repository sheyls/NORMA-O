###  https://w3id.org/norma-abox/art25#Action_comply_art16
:Action_comply_art16 rdf:type owl:NamedIndividual ,
                              <https://w3id.org/def/norma-o#LegalAction> ;
                     rdfs:label "comply with the provider obligations of Article 16"@en .


###  https://w3id.org/norma-abox/art25#Action_comply_art26
:Action_comply_art26 rdf:type owl:NamedIndividual ,
                              <https://w3id.org/def/norma-o#LegalAction> ;
                     rdfs:label "comply with the deployer obligations of Article 26"@en .


###  https://w3id.org/norma-abox/art25#Annotator
:Annotator rdf:type owl:NamedIndividual ,
                    <https://w3id.org/def/norma-o#AnnotatorAgent> ;
           rdfs:label "hand annotation for the Art. 25 experiment"@en .


###  https://w3id.org/norma-abox/art25#Case_acme_modified
:Case_acme_modified rdf:type owl:NamedIndividual ,
                             <https://w3id.org/def/norma-o#FactPattern> ;
                    rdfs:label "Acme, deployer, substantially modified system X"@en ;
                    <https://w3id.org/def/norma-o#holdsRoleAssignment> :RA_acme_deployer ,
                                                                       :RA_acme_provider ;
                    <https://w3id.org/def/norma-o#holdsTrigger> :TE_art25_1b .


###  https://w3id.org/norma-abox/art25#Case_acme_unmodified
:Case_acme_unmodified rdf:type owl:NamedIndividual ,
                               <https://w3id.org/def/norma-o#FactPattern> ;
                      rdfs:label "Acme, deployer, made no substantial modification"@en ;
                      <https://w3id.org/def/norma-o#holdsRoleAssignment> :RA_acme_deployer .


###  https://w3id.org/norma-abox/art25#Cond_art25_1b
:Cond_art25_1b rdf:type owl:NamedIndividual ,
                        <https://w3id.org/def/norma-o#LegalCondition> ;
               <https://w3id.org/def/norma-o#conditionStatement> "Has the party made a substantial modification to the high-risk AI system after it was placed on the market?" ;
               <https://w3id.org/def/norma-o#hasTrigger> :TE_art25_1b .


###  https://w3id.org/norma-abox/art25#FCT_Art25_1_counts_as_provider
:FCT_Art25_1_counts_as_provider rdf:type owl:NamedIndividual ,
                                         <https://w3id.org/def/norma-o#ConstitutiveRule> ;
                                <https://w3id.org/def/norma-o#confersRole> :Role_Provider ;
                                <https://w3id.org/def/norma-o#deonticId> "FCT_Art25_1_counts_as_provider" ;
                                <https://w3id.org/def/norma-o#factStatement> "Any distributor, importer, deployer or other third party shall be considered to be a provider of a high-risk AI system in any of the circumstances of Art. 25(1)(a) to (c)." ;
                                <https://w3id.org/def/norma-o#fromArticle> "25" ;
                                <https://w3id.org/def/norma-o#fromParagraph> "1" ;
                                <https://w3id.org/def/norma-o#hasExtractionMethod> <https://w3id.org/def/norma-o#ManualLawyer> ;
                                <https://w3id.org/def/norma-o#hasLegalSource> :Regulation_AIA ;
                                <https://w3id.org/def/norma-o#hasNormStatus> <https://w3id.org/def/norma-o#Active> ;
                                <https://w3id.org/def/norma-o#wasAttributedToAnnotator> :Annotator .


###  https://w3id.org/norma-abox/art25#FCT_Art3_8_operator
:FCT_Art3_8_operator rdf:type owl:NamedIndividual ,
                              <https://w3id.org/def/norma-o#ConstitutiveRule> ;
                     <https://w3id.org/def/norma-o#confersRole> :Role_Operator ;
                     <https://w3id.org/def/norma-o#deonticId> "FCT_Art3_8_operator" ;
                     <https://w3id.org/def/norma-o#factStatement> "'operator' means a provider, product manufacturer, deployer, authorised representative, importer or distributor." ;
                     <https://w3id.org/def/norma-o#fromArticle> "3" ;
                     <https://w3id.org/def/norma-o#fromParagraph> "8" ;
                     <https://w3id.org/def/norma-o#hasExtractionMethod> <https://w3id.org/def/norma-o#ManualLawyer> ;
                     <https://w3id.org/def/norma-o#hasLegalSource> :Regulation_AIA ;
                     <https://w3id.org/def/norma-o#hasNormStatus> <https://w3id.org/def/norma-o#Active> ;
                     <https://w3id.org/def/norma-o#wasAttributedToAnnotator> :Annotator .


###  https://w3id.org/norma-abox/art25#OBL_Art16_provider
:OBL_Art16_provider rdf:type owl:NamedIndividual ,
                             <https://w3id.org/def/norma-o#Obligation> ;
                    <https://w3id.org/def/norma-o#deonticId> "OBL_Art16_provider" ;
                    <https://w3id.org/def/norma-o#fromArticle> "16" ;
                    <https://w3id.org/def/norma-o#hasBindingForce> <https://w3id.org/def/norma-o#HardLaw> ;
                    <https://w3id.org/def/norma-o#hasExtractionMethod> <https://w3id.org/def/norma-o#ManualLawyer> ;
                    <https://w3id.org/def/norma-o#hasLegalAction> :Action_comply_art16 ;
                    <https://w3id.org/def/norma-o#hasLegalAgent> :Role_Provider ;
                    <https://w3id.org/def/norma-o#hasLegalObject> :System_X ;
                    <https://w3id.org/def/norma-o#hasLegalSource> :Regulation_AIA ;
                    <https://w3id.org/def/norma-o#hasNormStatus> <https://w3id.org/def/norma-o#Active> ;
                    <https://w3id.org/def/norma-o#normStatement> "Providers of high-risk AI systems shall comply with the obligations of Article 16." ;
                    <https://w3id.org/def/norma-o#wasAttributedToAnnotator> :Annotator .


###  https://w3id.org/norma-abox/art25#OBL_Art26_deployer
:OBL_Art26_deployer rdf:type owl:NamedIndividual ,
                             <https://w3id.org/def/norma-o#Obligation> ;
