  } ],
  "https://w3id.org/def/norma-o#factStatement" : [ {
    "@value" : "'operator' means a provider, product manufacturer, deployer, authorised representative, importer or distributor."
  } ],
  "https://w3id.org/def/norma-o#fromArticle" : [ {
