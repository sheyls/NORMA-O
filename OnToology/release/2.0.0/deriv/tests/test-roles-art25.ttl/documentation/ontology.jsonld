}, {
  "@id" : "https://w3id.org/norma-abox/art25#FCT_Art25_1_counts_as_provider",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConstitutiveRule"
  } ],
