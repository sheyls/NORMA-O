    "@id" : "https://w3id.org/norma-abox/art25#Role_Provider"
  } ],
  "https://w3id.org/def/norma-o#deonticId" : [ {
    "@value" : "FCT_Art25_1_counts_as_provider"
  } ],
  "https://w3id.org/def/norma-o#factStatement" : [ {
    "@value" : "Any distributor, importer, deployer or other third party shall be considered to be a provider of a high-risk AI system in any of the circumstances of Art. 25(1)(a) to (c)."
  } ],
  "https://w3id.org/def/norma-o#fromArticle" : [ {
    "@value" : "25"
  } ],
  "https://w3id.org/def/norma-o#fromParagraph" : [ {
    "@value" : "1"
  } ],
  "https://w3id.org/def/norma-o#hasExtractionMethod" : [ {
    "@id" : "https://w3id.org/def/norma-o#ManualLawyer"
  } ],
  "https://w3id.org/def/norma-o#hasLegalSource" : [ {
    "@id" : "https://w3id.org/norma-abox/art25#Regulation_AIA"
  } ],
  "https://w3id.org/def/norma-o#hasNormStatus" : [ {
    "@id" : "https://w3id.org/def/norma-o#Active"
  } ],
  "https://w3id.org/def/norma-o#wasAttributedToAnnotator" : [ {
    "@id" : "https://w3id.org/norma-abox/art25#Annotator"
  } ]
