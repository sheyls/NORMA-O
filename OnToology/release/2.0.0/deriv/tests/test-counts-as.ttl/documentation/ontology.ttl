           <https://w3id.org/def/norma-o#defeatedNorm> :fct_63 ;
           <https://w3id.org/def/norma-o#defeatingNorm> :fct_63_prof .


###  https://example.org/norma-countsas#deployer
:deployer rdf:type owl:NamedIndividual ,
                   <https://w3id.org/def/norma-o#LegalRole> ;
          rdfs:label "deployer"@en .


###  https://example.org/norma-countsas#fct_62
:fct_62 rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#ConstitutiveRule> ;
        <https://w3id.org/def/norma-o#deonticId> "fct_62" ;
        <https://w3id.org/def/norma-o#establishesTrigger> :te_hr_16 ,
                                                          :te_hr_26 ;
        <https://w3id.org/def/norma-o#factStatement> "AI systems referred to in Annex III shall be considered to be high-risk." .


###  https://example.org/norma-countsas#fct_63
:fct_63 rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#ConstitutiveRule> ;
        <https://w3id.org/def/norma-o#deonticId> "fct_63" ;
        <https://w3id.org/def/norma-o#factStatement> "By derogation, an Annex III system is not high-risk where it performs a narrow procedural task." .


###  https://example.org/norma-countsas#fct_63_prof
:fct_63_prof rdf:type owl:NamedIndividual ,
                      <https://w3id.org/def/norma-o#ConstitutiveRule> ;
             <https://w3id.org/def/norma-o#deonticId> "fct_63_prof" ;
             <https://w3id.org/def/norma-o#factStatement> "Notwithstanding the first subparagraph, an Annex III system performing profiling is always high-risk." .


