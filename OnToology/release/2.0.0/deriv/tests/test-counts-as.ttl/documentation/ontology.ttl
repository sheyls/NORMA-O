###  https://example.org/norma-countsas#C_annex
:C_annex rdf:type owl:NamedIndividual ,
                  <https://w3id.org/def/norma-o#FactPattern> ;
         rdfs:label "Annex III only"@en ;
         <https://w3id.org/def/norma-o#holdsTrigger> :te_annex .


###  https://example.org/norma-countsas#C_narrow
:C_narrow rdf:type owl:NamedIndividual ,
                   <https://w3id.org/def/norma-o#FactPattern> ;
          rdfs:label "Annex III + narrow procedural task"@en ;
          <https://w3id.org/def/norma-o#holdsTrigger> :te_annex ,
                                                      :te_narrow .


###  https://example.org/norma-countsas#C_prof
:C_prof rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#FactPattern> ;
        rdfs:label "Annex III + narrow task + profiling"@en ;
        <https://w3id.org/def/norma-o#holdsTrigger> :te_annex ,
                                                    :te_narrow ,
                                                    :te_prof .


###  https://example.org/norma-countsas#act_16
:act_16 rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#LegalAction> ;
        rdfs:label "comply with Art. 16"@en .


###  https://example.org/norma-countsas#act_26
:act_26 rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#LegalAction> ;
        rdfs:label "comply with Art. 26"@en .


###  https://example.org/norma-countsas#authority
:authority rdf:type owl:NamedIndividual ,
                    <https://w3id.org/def/norma-o#LegalRole> ;
           rdfs:label "market surveillance authority"@en .


###  https://example.org/norma-countsas#c_annex
:c_annex rdf:type owl:NamedIndividual ,
                  <https://w3id.org/def/norma-o#LegalCondition> ;
         <https://w3id.org/def/norma-o#conditionStatement> "Is the AI system listed in Annex III?" ;
         <https://w3id.org/def/norma-o#hasTrigger> :te_annex .


###  https://example.org/norma-countsas#c_highrisk
:c_highrisk rdf:type owl:NamedIndividual ,
                     <https://w3id.org/def/norma-o#LegalCondition> ;
            <https://w3id.org/def/norma-o#conditionStatement> "Is the AI system high-risk?" ;
            <https://w3id.org/def/norma-o#hasTrigger> :te_hr_16 ,
                                                      :te_hr_26 .


###  https://example.org/norma-countsas#c_narrow
:c_narrow rdf:type owl:NamedIndividual ,
                   <https://w3id.org/def/norma-o#LegalCondition> ;
          <https://w3id.org/def/norma-o#conditionStatement> "Is the system intended to perform a narrow procedural task?" ;
          <https://w3id.org/def/norma-o#hasTrigger> :te_narrow .


###  https://example.org/norma-countsas#c_prof
:c_prof rdf:type owl:NamedIndividual ,
                 <https://w3id.org/def/norma-o#LegalCondition> ;
        <https://w3id.org/def/norma-o#conditionStatement> "Does the AI system perform profiling of natural persons?" ;
        <https://w3id.org/def/norma-o#hasTrigger> :te_prof .


###  https://example.org/norma-countsas#d_63
:d_63 rdf:type owl:NamedIndividual ,
               <https://w3id.org/def/norma-o#ExceptionDefeater> ;
      <https://w3id.org/def/norma-o#appliesWhen> :te_narrow ;
      <https://w3id.org/def/norma-o#defeatedNorm> :fct_62 ;
