}, {
  "@id" : "https://sheyls.github.io/NORMA-O/release/2.0.0/norma-o-v2.svg",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/def/norma-o",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/alternative" : [ {
    "@language" : "en",
    "@value" : "NORMA Ontology"
  } ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "Leyva-Sánchez, S. et al. (2026). NORMA-O: The NORMA Ontology for Legal Norm Annotations (Version 2.0) [Ontology]. https://w3id.org/def/norma-o/2.0"
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@id" : "_:genid1"
  }, {
    "@id" : "_:genid2"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-04-15"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "_:genid3"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The NORMA ontology is a formal semantic model for representing machine-readable legal norm annotations as reusable knowledge graph resources. It distinguishes between regulative norms and constitutive rules; represents legal conditions, their evaluated outcomes, and branch-sensitive activation through a TriggerEvent n-ary relation pattern; and captures the legal agents, actions, objects, sources, provenance metadata, lifecycle status, review status, extraction method, and controlled classification values needed for traceable and interoperable publication. The ontology aligns with PROV-O for provenance, ELI for legal resource modelling, FOAF for agent-oriented metadata, and SKOS for controlled vocabularies, and provides informative alignments with LKIF-Core via SKOS mapping properties. Regulative norms are formally grounded in Standard Deontic Logic, whose interdefinability of operators (F(X) ≡ O(¬X), P(X) ≡ ¬O(¬X), and facultativeness as P(X) ∧ P(¬X)) is captured through action negation and inter-norm deontic equivalence and contradiction relations, and in Hohfeld's scheme of first-order jural correlatives (duty and claim, privilege and no-right), represented as reified, directed legal positions between a holder and a counterparty. Defeasibility is modelled as a reified defeat relation between norms — undercutting exceptions, rebutting conflicts resolved by lex superior, specialis or posterior, and repeal — which flattens into a norm-to-norm prevalence digraph whose stratification, cycles and reinstatements are derived rather than stored. The deontic closure of each norm and the weak permissions holding in a described case are likewise part of the vocabulary but never annotated: they are materialised by a rule set into a derived graph, whose activity records the non-monotonic assumptions it relied on through the companion NORMA-O Derivation module."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-11-09"
  } ],
  "http://purl.org/dc/terms/language" : [ {
    "@id" : "http://id.loc.gov/vocabulary/iso639-1/en"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-11-09"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "_:genid4"
  } ],
  "http://purl.org/dc/terms/source" : [ {
