}, {
  "@id" : "https://w3id.org/def/norma-o#AnnotationActivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A provenance activity that produces a NORMA annotation (i.e. a NormativeContent) from one or more LegalSources."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Annotation Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#Activity"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#AnnotatorAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A provenance agent responsible for creating, reviewing, or attesting to a NORMA annotation. May represent a person (legal expert, analyst), a software system (LLM extractor, rule engine), or an organization. For finer-grained typing use the corresponding PROV-O subclasses (prov:Person, prov:SoftwareAgent, prov:Organization). Integrity constraint (not OWL-enforced): for a given NormativeContent, `prov:wasAttributedTo` and `prov:wasAssociatedWith` (via its generating AnnotationActivity) should resolve to the same agent; validate with SHACL."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Annotator Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#Agent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Approved",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Review status indicating that the annotation has been validated and accepted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Approved"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "APPROVED"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Approved"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#BindingForce",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Binding force of a norm."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Binding Force"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#BindingForceScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SKOS concept scheme grouping binding-force values used by NORMA regulative norms."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#Contractual"
  }, {
    "@id" : "https://w3id.org/def/norma-o#HardLaw"
  }, {
    "@id" : "https://w3id.org/def/norma-o#InternalPolicy"
  }, {
    "@id" : "https://w3id.org/def/norma-o#SoftLaw"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Binding force scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Claim",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal position in which the holder is entitled, as against the counterparty, that the counterparty realise the concerned action content."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Claim"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  }, {
    "@id" : "_:genid18"
  }, {
    "@id" : "_:genid19"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Claim-right"
  }, {
    "@language" : "en",
    "@value" : "Right"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Hohfeldian right in the strict sense (claim). Correlative: Duty. Jural opposite: No-right."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ComplianceCriticality",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Criticality level associated with non-compliance with a regulative norm."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Compliance Criticality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ComplianceCriticalityScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SKOS concept scheme grouping compliance criticality values used by NORMA regulative norms."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#Critical"
  }, {
    "@id" : "https://w3id.org/def/norma-o#High"
  }, {
    "@id" : "https://w3id.org/def/norma-o#Low"
  }, {
    "@id" : "https://w3id.org/def/norma-o#Medium"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Compliance criticality scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ConditionOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A controlled outcome value produced by evaluating a LegalCondition. It is modelled as an extensible SKOS concept class so binary branches, multi-way gateway branches, exception branches, and decision-table outcomes can all be represented consistently."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Condition Outcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ConditionOutcomeScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Extensible SKOS scheme grouping condition outcome values used by NORMA trigger events."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#FalseOutcome"
  }, {
    "@id" : "https://w3id.org/def/norma-o#TrueOutcome"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Condition outcome scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ConflictDefeater",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A defeater in which the defeating norm asserts an opposing deontic status and prevails by a priority principle, which fixes the resulting status."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Conflict Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  }, {
    "@id" : "_:genid20"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Rebutting defeat in Pollock's sense. Presupposes a conflict detected at the deontic layer (norma:deonticallyConflictsWith, norma:deonticallyContradicts) and records the legal principle that resolves it."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Neither presupposition is OWL-enforceable: that the two related norms are in conflict joins two roles of the same node, and the existential restriction on norma:hasResolutionPrinciple is satisfied in the open world by an unnamed principle, so a missing principle is not detected by a reasoner. Validate both with SHACL."
  }, {
    "@language" : "en",
    "@value" : "Two conflict defeaters relating the same pair of norms in opposite directions, each citing a different resolution principle, represent a second-degree conflict in Bobbio's sense rather than an annotation error: the criteria are genuinely unordered for that pair, and the direction of prevalence then depends on a policy that the ontology does not fix. norma:conflictPrevailsOver is deliberately left outside the asymmetric norma:directlyPrevailsOver so that such a pair remains representable, and consuming applications should report one prevalence ordering per admissible policy instead of silently choosing one. A pair asserted in opposite directions under the same principle is, by contrast, a contradiction in the annotation."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ConstitutionalRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Rank of constitutional or founding instruments, including treaties where these head the legal order."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Constitutional"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "CONSTITUTIONAL"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Constitutional"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "https://w3id.org/def/norma-o#rankLevel" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "40"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ConstitutiveRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A normative content item that defines, classifies, or constitutes a legal concept, status, or institutional fact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Constitutive Rule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/lkif-top.owl#counts_as"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "LKIF-Core does not reify constitutive rules as a class; it expresses constitutive force through the lkif:counts_as property on Subjective_Entity (Searle-style institutional facts). The reference is informative only — no formal alignment is asserted because a class cannot be subsumed by a property."
  }, {
    "@language" : "en",
    "@value" : "Scope carve-outs belong here. A clause stating that a norm does not apply to a class of addressees, systems, or circumstances delimits the field of application without granting any liberty, so it is constitutive rather than regulative; modelling it as a norma:Permission would assert a strong permission that the source does not grant. Stating it as a ConstitutiveRule also gives the carve-out a node in the prevalence digraph, so that it can in turn be limited by a further defeater."
  }, {
    "@language" : "en",
    "@value" : "The Searle reading is given formal consequence by norma:confersRole. A constitutive rule that constitutes a role says so, and the role it confers reaches a party through a norma:RoleAssignment in a case; the ‘context C’ of ‘X counts as Y in C’ is the rule’s own activation condition. Without that property the class carries a text and a node in the prevalence digraph and nothing else, which is how it stood before: a rule could be evaluated as applicable and still produce no consequence at all."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Contractual",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForce"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Binding force category for obligations, permissions, or constraints arising from a contract or agreement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Contractual"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "CONTRACTUAL"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Contractual"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Critical",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Compliance criticality level indicating that non-compliance may cause severe legal, financial, operational, or safety consequences."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Critical"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticalityScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "CRITICAL"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Critical"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticalityScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Defeasible",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStrength"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Strength value for a norm that may be withdrawn by an applicable defeater. The default reading when no strength is stated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Defeasible"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStrengthScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "DEFEASIBLE"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Defeasible"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStrengthScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Defeater",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Reified defeat relation by which one piece of normative content withdraws or overrides the normative effect of another. Abstract superclass: use norma:ExceptionDefeater, norma:ConflictDefeater or norma:TemporalDefeater. Follows the same W3C n-ary relation pattern as norma:TriggerEvent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://plato.stanford.edu/entries/reasoning-defeasible/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#Entity"
  }, {
    "@id" : "_:genid21"
  }, {
    "@id" : "_:genid22"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Defeasibility is a derived status rather than a class: a norm has a known defeater if and only if it is the norma:defeatedNorm of some Defeater. Under the open-world assumption the absence of a defeater does not entail that a norm is indefeasible; norms known to admit no defeat are marked with norma:hasNormStrength norma:Strict."
  }, {
    "@language" : "en",
    "@value" : "Defeat chains require the intermediate carve-out to be normative content: because norma:defeatedNorm ranges over norma:NormativeContent, an exception can itself be excepted only when it is stated as a norm — a norma:Permission where the source grants a liberty, a norma:ConstitutiveRule where it merely delimits the field of application. A defeater that names no defeating norm contributes no edge to norma:prevailsOver and cannot itself be defeated, so it is an incomplete annotation rather than a modelling option. The minimum cardinality on norma:defeatingNorm records that commitment but does not detect its breach, since under the open-world assumption an unnamed defeating norm is always assumed to exist; enforce it with SHACL."
  }, {
    "@language" : "en",
    "@value" : "Provenance: a Defeater is a prov:Entity, so use prov:wasAttributedTo and prov:wasGeneratedBy directly. Do not use norma:wasAttributedToAnnotator, whose domain is norma:NormativeContent: Defeater is disjoint from NormativeContent and such an assertion would make the graph inconsistent."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#DelegatedRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Rank of delegated acts, technical annexes, and equivalent instruments issued under a specific delegation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Delegated"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "DELEGATED"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Delegated"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "https://w3id.org/def/norma-o#rankLevel" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "10"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Disputed",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Legally or interpretively disputed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Disputed"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "DISPUTED"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Disputed"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatusScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Duty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal position in which the holder is bound, toward the counterparty, to realise the concerned action content: to perform the action, or to refrain from it when the content is a negated action."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Duty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  }, {
    "@id" : "_:genid23"
  }, {
    "@id" : "_:genid24"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Hohfeldian duty. Correlative: Claim. Jural opposite: Privilege — a Duty concerning X is the negation of a Privilege concerning ¬X, mirroring O(X) ≡ ¬P(¬X)."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ExceptionDefeater",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A defeater that switches off the applicability of the defeated norm under a condition, without asserting the opposite deontic status."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Exception Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Undercutting defeat in Pollock's sense. In SDL terms, undercutting O(X) yields not-O(X) — a weak permission to omit X — and not F(X). In Hohfeld's terms the Duty conferred by the defeated norm is withdrawn together with its correlative Claim, leaving the agent at liberty. NORMA records that outcome as legal positions (norma:Privilege with its norma:NoRight), never by minting a new norma:Permission individual, which would assert an explicit legislative grant that the source text does not make."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Several norma:appliesWhen gates on one defeater are read conjunctively, while alternative defeaters on the same defeated norm are read disjunctively. An exception that offers several alternative qualifying circumstances is therefore modelled as several ExceptionDefeaters."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ExtractionMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Method used to produce the annotation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Extraction Method"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ExtractionMethodScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SKOS concept scheme grouping annotation extraction method values used by NORMA."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#LLMExtraction"
  }, {
    "@id" : "https://w3id.org/def/norma-o#ManualAnalyst"
  }, {
    "@id" : "https://w3id.org/def/norma-o#ManualLawyer"
  }, {
    "@id" : "https://w3id.org/def/norma-o#PatternMatching"
  }, {
    "@id" : "https://w3id.org/def/norma-o#RuleBased"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Extraction method scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#FactPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A described case: the trigger events that fire in a concrete situation, that is, the legal conditions together with the outcomes they take, and the roles the parties involved occupy in it. An input to norm applicability, not a result of it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Fact Pattern"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A FactPattern selects the active subgraph of activation and defeat relations for a case. The resulting applicability — which norms survive, at which level of the prevalence ordering, and which are reinstated — is deliberately not represented in the ontology: it follows from the described facts and the asserted defeaters, and publishing it as annotated fact would desynchronise it from the normative system from which it follows."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Facultative",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A permission under which a legal action is optional: the legal agent is permitted both to perform it and to omit it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Facultative"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#Permission"
  }, {
    "@id" : "_:genid25"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SDL: P(X) ∧ P(¬X), equivalently ¬O(¬X) ∧ ¬O(X) — X is neither forbidden nor obligatory. Hohfeld: the legal agent (A) holds two Privileges toward the counterparty (B), one concerning X and one concerning ¬X (a bilateral liberty), each with a correlative No-right held by B."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "FAC"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Modelled as a subclass of norma:Permission because it is the conjunction of two permissions. It thereby inherits disjointness from norma:Obligation and norma:Prohibition, as SDL requires: P(¬X) contradicts O(X) and P(X) contradicts F(X)."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#FalseOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConditionOutcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Condition outcome indicating that the condition does not hold, corresponding to a false or no branch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "False Outcome"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConditionOutcomeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "FALSE"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "False outcome"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConditionOutcomeScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#HardLaw",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForce"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Binding force category for legally binding instruments such as statutes, regulations, or enforceable legal acts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hard Law"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "HARD_LAW"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hard Law"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#High",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Compliance criticality level indicating a high level of legal, operational, or business risk in case of non-compliance."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "High"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticalityScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "HIGH"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "High"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticalityScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#InternalPolicy",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForce"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Binding force category for internal organizational policies, procedures, or governance rules."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Internal Policy"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "INTERNAL_POLICY"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Internal Policy"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LLMExtraction",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethod"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Extraction method indicating that the annotation was produced using a large language model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "LLM extraction"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethodScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "LLM_EXTRACTION"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "LLM extraction"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethodScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A normalized legal action that is prescribed, prohibited, permitted, or recommended by a regulative norm. Consumers may work with the literal shortcut `norma:actionText` for low-ceremony use and mint LegalAction individuals only when the knowledge graph needs action-level reuse across norms."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/legal-action.owl#Legal_Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "EVERY inference across norms joins on this class. The deontic closure, the equivalence and conflict relations, the Hohfeldian positions and the weak permission all compare norms through the action they regulate, so two annotators who mint separate individuals for one and the same conduct produce two unrelated islands and the derivation silently finds nothing — no equivalence, no conflict, no blocking of a weak permission. The ontology provides NO mechanism for aligning actions across annotators or regulations: assert owl:sameAs between them, or draw the individuals from a vocabulary of actions agreed beforehand. This is the main data-quality obligation a producer carries, and no reasoner can discharge it."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An entity that bears the legally relevant role of subject of a regulative norm: the party that is obliged, prohibited, permitted, or recommended to perform a legal action."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/legal-action.owl#Legal_Person"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Conceptually close to lkif-la:Legal_Person (Natural_Person, Private_Legal_Person, Public_Body). rdfs:seeAlso is used rather than rdfs:subClassOf because lkif-la:Legal_Person also covers Legislative_Body — entities that utter norms rather than bear them — which falls outside NORMA's LegalAgent role, and because lkif-core/legal-action.owl is not imported. foaf:Agent is intentionally not asserted as a TBox parent because it is broader than legal personhood (it includes software agents and other non-legal entities); FOAF classes remain available for instance-level annotation."
  }, {
    "@language" : "en",
    "@value" : "Deliberately left as the common parent of norma:LegalRole and norma:LegalParty rather than being split away, because a norm may be annotated as addressing either, and legacy annotations that commit to neither remain valid. Real legislation almost always addresses a role: in Regulation (EU) 2024/1689 the addressees are the provider, the deployer, the importer and so on, never a named undertaking. Which concrete party bears a norm is therefore a fact about a case, not about the norm, and is stated with norma:RoleAssignment."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalCondition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legally relevant condition, fact pattern, or decision criterion whose evaluated outcome determines whether normative content becomes applicable or is triggered. Branch-specific activation is represented using the n-ary TriggerEvent pattern via norma:hasTrigger."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Condition"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalObject",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The entity, resource, person, document, system, content, or data item toward which the regulated action is directed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Object"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalParty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A concrete natural or legal person, public authority, agency or body: the entity that occupies a role in a described case, as opposed to the role itself."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Party"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalRole"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Parties belong to cases, not to norms. A norm that names a party directly is possible — an individual decision, a sanction — but in general legislation addresses roles, and the link between the two is made per case with norma:RoleAssignment."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalPosition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "Hohfeld, W. N. (1913). Some Fundamental Legal Conceptions as Applied in Judicial Reasoning. The Yale Law Journal, 23(1), 16–59."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A directed, first-order jural relation in Hohfeld's sense, held by one legal agent (the holder) against another (the counterparty) and concerning a legal action or its negation, as conferred by normative content. Reified following the W3C n-ary relation pattern so that holder, counterparty, action content, and correlative position can be stated explicitly."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Position"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://doi.org/10.2307/785533"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid26"
  }, {
    "@id" : "_:genid27"
  }, {
    "@id" : "_:genid28"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Hohfeld's correlatives describe one and the same jural relation from the standpoint of each party: whenever A holds a position toward B concerning X, B necessarily holds the correlative position toward A concerning X. NORMA encodes this with norma:isCorrelativeOf (symmetric, functional, irreflexive) and two OWL 2 property chains that derive the counterparty and propagate the action content across correlatives. The square's other axis, between positions of the same party over negated contents, is norma:isJuralOppositeOf. The mapping from deontic operators is: O(X) ⇒ Duty(A→B, X) ⟷ Claim(B→A, X); F(X) ≡ O(¬X) ⇒ Duty(A→B, ¬X) ⟷ Claim(B→A, ¬X); P(X) ⇒ Privilege(A→B, X) ⟷ NoRight(B→A, X), where A is the norm's legal agent (norma:hasLegalAgent) and B its counterparty (norma:hasCounterparty). OWL reasoning cannot mint these positions, because minting requires creating individuals: they are materialised from the deontic closure by the derivation rule set, which needs only the norm's operator, action, agent and counterparty to be annotated. Once minted, the counterparty and the correlative's content follow by the property chains and need not be written. Only first-order positions are modelled; second-order positions (power, liability, immunity, disability) are out of scope."
  }, {
    "@language" : "en",
    "@value" : "PRIMA FACIE, and not a conclusion about any case. A position is conferred by the norm AS ENACTED, so it is derived from the norm alone and never consults the norm’s status in a described situation: a norm that a case renders inapplicable — defeated by an exception, untriggered by the facts, or outside the system altogether — still confers its position here. “A bears a duty toward B concerning X” therefore reads as what the provision establishes, not as what A owes in a given case. Whether that duty bites is settled by evaluating the case, in the derivation module, and a consumer answering a compliance question must join the two."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An abstract addressee defined by a legal source: the capacity in which a party is bound, such as provider, deployer, importer or distributor. What norms name, as opposed to the party that happens to occupy it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A role is itself constituted by a norma:ConstitutiveRule — a legal definition — and so is part of the normative system rather than of the facts. Annotating the defining provision gives the role a source: article 3(3) of Regulation (EU) 2024/1689 defines the provider, article 3(8) defines the operator as a provider, product manufacturer, deployer, authorised representative, importer or distributor."
  }, {
    "@language" : "en",
    "@value" : "NO SPECIALISATION RELATION between roles is asserted, and the omission is deliberate rather than an oversight. A hierarchy would only change a derivation where a norm addresses a supertype, and in Regulation (EU) 2024/1689 the substantive duties are addressed to the leaf roles while ‘operator’ serves as a scope and enforcement term: article 74 does not impose duties on operators but refers the word back to the scope of article 2(1). Adding the relation before a corpus exercises it would put untested structure in the ontology. Note also that co-specialisations do not join: a norm addressed to the provider does not reach the deployer merely because both are operators."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal resource (in the ELI sense: a work-level identity) from which normative content is extracted, cited, or traced."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Source"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/norm.owl#Legal_Document"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://data.europa.eu/eli/ontology#LegalResource"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Conceptually related to lkif:Legal_Document. NORMA aligns formally to eli:LegalResource (the maintained W3C-adjacent legal-resource standard) rather than to lkif:Legal_Document, because lkif:Legal_Document is itself an expression:Medium subclass with restrictions on bears/utterer that are incompatible with NORMA's source-as-reference pattern. The LKIF reference is informative only."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegalSourceExpression",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A concrete legal expression of a LegalSource: a specific language, consolidation, or published version of the underlying legal resource. Follows the ELI work/expression pattern: a LegalSource is realised by one or more LegalSourceExpressions via `norma:hasSourceExpression` (subproperty of `eli:is_realized_by`)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legal Source Expression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://data.europa.eu/eli/ontology#LegalExpression"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LegislativeRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Rank of primary legislation: statutes, regulations, and equivalent legislative acts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legislative"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "LEGISLATIVE"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Legislative"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "https://w3id.org/def/norma-o#rankLevel" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "30"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#LexPosterior",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ResolutionPrinciple"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Resolution principle giving precedence to the later norm over the earlier one."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Lex posterior"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ResolutionPrincipleScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "LEX_POSTERIOR"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
