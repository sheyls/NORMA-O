  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NegativeRecommendation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A regulative norm stating that a legal action is discouraged."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Negative Recommendation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  }, {
    "@id" : "_:genid29"
  }, {
    "@id" : "_:genid33"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Performing X is discouraged but not forbidden. By analogy with F(X) ≡ O(¬X), a Negative Recommendation of X is deontically equivalent to a Recommendation of ¬X. Like Recommendation, it confers no Hohfeldian legal position."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "REC_NOT"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NoRight",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal position in which the holder has no claim, as against the counterparty, that the counterparty refrain from realising the concerned action content."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "No-right"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  }, {
    "@id" : "_:genid34"
  }, {
    "@id" : "_:genid35"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Hohfeldian no-right. Correlative: Privilege. Jural opposite: Claim."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NormStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Lifecycle status of a normative content item."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Norm Status"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NormStatusScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SKOS concept scheme grouping lifecycle status values used by NORMA normative content."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#Active"
  }, {
    "@id" : "https://w3id.org/def/norma-o#Disputed"
  }, {
    "@id" : "https://w3id.org/def/norma-o#NotYetInForce"
  }, {
    "@id" : "https://w3id.org/def/norma-o#Superseded"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Norm status scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NormStrength",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Whether a norm admits defeat at all."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Norm Strength"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinguishes strict norms, which no defeater may withdraw, from defeasible ones. Consumers should refuse to apply a defeater whose defeated norm is strict; OWL cannot enforce this because the constraint joins two roles of the same node."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NormStrengthScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SKOS concept scheme grouping the norm strength values used by NORMA normative content."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeasible"
  }, {
    "@id" : "https://w3id.org/def/norma-o#Strict"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Norm strength scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NormativeContent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An informational entity that expresses machine-readable legal-normative content extracted or formulated from a legal source, either a regulative norm or a constitutive rule. Jurisdiction is represented only with eli:jurisdiction, whose value must be an eli:AdministrativeArea. If no authoritative URI is available yet, use a local provisional resource typed as eli:AdministrativeArea and provide its rdfs:label."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Normative Content"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#Entity"
  }, {
    "@id" : "_:genid36"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Do not attach jurisdiction strings directly to NormativeContent. For extracted labels such as \"Spain\" or \"California\", mint a local jurisdiction resource, type it as eli:AdministrativeArea, attach the extracted text as rdfs:label, and later align or replace it with an authoritative URI when available."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NormativeRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Rank of a legal source in the hierarchy of sources, from constitutional instruments down to organisational ones."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Normative Rank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinct from norma:BindingForce: two hard-law norms may differ in rank. The integer norma:rankLevel makes lex superior computable by comparison within a single legal order; conflicts across legal orders, and questions of competence, are out of scope."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Extensible SKOS concept scheme grouping the normative rank values used by NORMA legal sources. Extend it for jurisdictions whose hierarchy of sources needs finer distinctions."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConstitutionalRank"
  }, {
    "@id" : "https://w3id.org/def/norma-o#DelegatedRank"
  }, {
    "@id" : "https://w3id.org/def/norma-o#LegislativeRank"
  }, {
    "@id" : "https://w3id.org/def/norma-o#OrganisationalRank"
  }, {
    "@id" : "https://w3id.org/def/norma-o#RegulatoryRank"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Normative rank scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NotReviewed",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Review status indicating that the normative content has not yet been reviewed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Not Reviewed"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "NOT_REVIEWED"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Not Reviewed"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#NotYetInForce",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Published or known but not yet effective."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Not Yet In Force"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "NOT_YET_IN_FORCE"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Not Yet In Force"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatusScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Obligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A regulative norm stating that a legal action is required."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/norm.owl#Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  }, {
    "@id" : "_:genid37"
  }, {
    "@id" : "_:genid38"
  }, {
    "@id" : "_:genid42"
  }, {
    "@id" : "_:genid43"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SDL: O(X) — the legal agent is obliged to perform X. Hohfeld: the legal agent (A) bears a Duty toward the counterparty (B) concerning X, and B holds the correlative Claim against A concerning X."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "OBL"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#OrganisationalRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Rank of internal organisational instruments, which yield to every external source."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Organisational"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ORGANISATIONAL"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Organisational"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "https://w3id.org/def/norma-o#rankLevel" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "0"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#PatternMatching",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethod"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Extraction method indicating that annotation content was produced by matching textual or structural patterns."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Pattern matching"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethodScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "PATTERN_MATCHING"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Pattern matching"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethodScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#PendingReview",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Review status indicating that the annotation is waiting for review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Pending Review"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "PENDING_REVIEW"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Pending Review"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Permission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A regulative norm stating that a legal action is allowed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/norm.owl#Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  }, {
    "@id" : "_:genid47"
  }, {
    "@id" : "_:genid48"
  }, {
    "@id" : "_:genid52"
  }, {
    "@id" : "_:genid56"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SDL: P(X) ≡ ¬F(X) ≡ ¬O(¬X) — the legal agent is permitted to perform X, i.e. is not forbidden to perform it; a Permission of X deontically contradicts (norma:deonticallyContradicts) a Prohibition of X, and a Permission of ¬X contradicts an Obligation of X. Hohfeld: the legal agent (A) holds a Privilege toward the counterparty (B) concerning X — the jural opposite of a Duty concerning ¬X — and B has the correlative No-right against A concerning X."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "PER"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Privilege",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal position in which the holder is free, as against the counterparty, to realise the concerned action content, because the holder has no duty toward the counterparty to the contrary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Privilege"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  }, {
    "@id" : "_:genid57"
  }, {
    "@id" : "_:genid58"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Liberty"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Hohfeldian privilege (liberty). Correlative: No-right. Jural opposite: Duty — a Privilege concerning X is the negation of a Duty concerning ¬X, mirroring P(X) ≡ ¬O(¬X)."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Prohibition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A regulative norm stating that a legal action is forbidden."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Prohibition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/norm.owl#Prohibition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  }, {
    "@id" : "_:genid59"
  }, {
    "@id" : "_:genid60"
  }, {
    "@id" : "_:genid64"
  }, {
    "@id" : "_:genid65"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SDL: F(X) ≡ O(¬X) — the legal agent is forbidden to perform X, i.e. obliged not to perform it; a Prohibition of X is therefore deontically equivalent (norma:isDeonticallyEquivalentTo) to an Obligation of the negated action ¬X (norma:isNegationOf). Hohfeld: the legal agent (A) bears a Duty toward the counterparty (B) concerning ¬X, and B holds the correlative Claim against A concerning ¬X."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "PRH"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Annotate the positive action X with norma:hasLegalAction and norma:actionText, since the negation is already carried by the operator: an action text such as \"must not develop\" under a Prohibition would read as F(¬X) ≡ O(X)."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Recommendation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A regulative norm stating that a legal action is recommended."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Recommendation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  }, {
    "@id" : "_:genid69"
  }, {
    "@id" : "_:genid73"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Performing X is recommended but not required. Recommendation is a non-binding operator outside the O/P/F core of SDL and confers no Hohfeldian legal position: omitting X breaches no duty and infringes no claim."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "REC"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#RegulativeNorm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A normative content item that regulates conduct by prescribing, prohibiting, permitting, or recommending a legal action."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Regulative Norm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/norm.owl#Norm"
  }, {
    "@id" : "https://plato.stanford.edu/entries/logic-deontic/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Conceptually close to lkif:Norm in LKIF-Core. rdfs:seeAlso is used rather than rdfs:subClassOf because lkif:Norm is equivalentClass to a restriction on lkif:qualifies (a property NORMA does not use) and because LKIF axiomatises the deontic operators as interdefinable (lkif:Obligation owl:equivalentClass lkif:Prohibition), which would conflict with NORMA's pairwise disjointness of regulative subclasses if formal subsumption were asserted."
  }, {
    "@language" : "en",
    "@value" : "Formal grounding in Standard Deontic Logic (SDL). The subclasses of RegulativeNorm classify the deontic operator explicitly used by the annotated legal statement (its surface modality), which is why they are pairwise disjoint. SDL interdefinability — F(X) ≡ O(¬X), P(X) ≡ ¬F(X) ≡ ¬O(¬X), and facultativeness as P(X) ∧ P(¬X) — is therefore not asserted as class equivalence, which would collapse the disjoint annotation classes as in LKIF-Core, but as relations between norms mediated by action negation: norma:isNegationOf between legal actions, and norma:isDeonticallyEquivalentTo, norma:deonticallyContradicts and norma:deonticallyConflictsWith between regulative norms. Likewise, the SDL theorem O(X) → P(X) (axiom D) is a logical consequence of an obligation and does not make an Obligation annotation a Permission annotation. The intersubjective reading of each operator is given by the Hohfeldian legal positions it confers (norma:confersLegalPosition)."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#RegulatoryRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Rank of secondary or implementing instruments issued under primary legislation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Regulatory"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "REGULATORY"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Regulatory"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRankScheme"
  } ],
  "https://w3id.org/def/norma-o#rankLevel" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "20"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ResolutionPrinciple",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal principle that orients the resolution of a conflict between norms."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Resolution Principle"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Resolution principles may themselves conflict — lex specialis against lex posterior is the classic second-degree conflict — which is why norma:hasResolutionPrinciple is not functional and why the order in which principles are applied is a policy of the consuming application rather than an ontological truth."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ResolutionPrincipleScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SKOS concept scheme grouping the conflict resolution principles used by NORMA conflict defeaters."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#LexPosterior"
  }, {
    "@id" : "https://w3id.org/def/norma-o#LexSpecialis"
  }, {
    "@id" : "https://w3id.org/def/norma-o#LexSuperior"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Resolution principle scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ReviewStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Legal review status of an annotation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Review Status"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SKOS concept scheme grouping review status values used by NORMA annotations."
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://w3id.org/def/norma-o#Approved"
  }, {
    "@id" : "https://w3id.org/def/norma-o#NotReviewed"
  }, {
    "@id" : "https://w3id.org/def/norma-o#PendingReview"
  }, {
    "@id" : "https://w3id.org/def/norma-o#UnderReview"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Review status scheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#RoleAssignment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The fact that a given party occupies a given role. Reified following the W3C n-ary relation pattern, as norma:TriggerEvent, norma:LegalPosition, norma:Defeater and norma:WeakPermission are, because the relation is ternary: a party occupies a role IN A CASE."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Role Assignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid74"
  }, {
    "@id" : "_:genid75"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "ASSERTED, not derived, and this is the one place where the ontology departs from its own principle of deriving what is not generative. The reason is a GAP IN THE MODEL and not an impossibility, which is worth stating precisely. Judging the facts of a case is not the obstacle: a norma:FactPattern already asserts norma:holdsTrigger, and “a substantial modification was made” is as much a judgement about facts as “Acme made it”. The obstacle is that a norma:TriggerEvent records WHAT happened and not WHO did it, so although a constitutive rule names the role it confers (norma:confersRole) and the circumstances that bring it about (its own activation conditions), nothing in the graph connects those circumstances to a party. Were the trigger to carry the party that performed the conduct, a rule could mint the assignment; until then the annotator asserts it, cites the rule with norma:assignedUnderRule, and what the derivation computes is the REACH of each norm."
  }, {
    "@language" : "en",
    "@value" : "Because the assignment is asserted and never retracted, a case may hold one whose justifying rule turns out to be inapplicable there, whether untriggered by the facts or defeated. That is detectable without deriving anything, and a derivation reports it rather than presenting a reach that rests on a rule which does not apply."
  }, {
    "@language" : "en",
    "@value" : "Held by a norma:FactPattern, which thereby describes both what happened and in what capacity each party acted. An assignment asserted outside any fact pattern makes no claim about any case."
  }, {
    "@language" : "en",
    "@value" : "Reification is not optional: the same party occupies different roles in different cases, and one case may assign several roles to one party. A binary property from party to role would fix the assignment for all cases at once and could not represent the reclassification that a constitutive rule performs."
  }, {
    "@language" : "en",
    "@value" : "Why it must be case-relative, with the clearest example in current law: article 25(1) of Regulation (EU) 2024/1689 provides that a distributor, importer, deployer or other third party SHALL BE CONSIDERED TO BE A PROVIDER of a high-risk AI system where it puts its name on the system, makes a substantial modification, or modifies the intended purpose. That is Searle’s ‘X counts as Y in context C’ stated as positive law, and article 25(2) withdraws the role from the original provider in the same breath. The assignment therefore holds under circumstances, which a case-independent property could not express. It is NOT itself defeasible: norma:defeatedNorm ranges over norma:NormativeContent and a role assignment is disjoint from it, so no defeater can target one. What is defeasible is the constitutive rule that justifies the assignment, through norma:assignedUnderRule. Withdrawing that rule does not retract an assignment already asserted in a case, so the withdrawal of a role — article 25(2) of Regulation (EU) 2024/1689, which stops treating the original provider as a provider — is out of scope in this version."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#RuleBased",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethod"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Extraction method indicating that the annotation was produced by deterministic rules."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Rule-based extraction"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethodScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "RULE_BASED"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Rule-based extraction"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethodScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#SoftLaw",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForce"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Binding force category for non-binding guidance, recommendations, codes of conduct, or policy instruments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Soft Law"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.estrellaproject.org/lkif-core/norm.owl#Soft_Law"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SOFT_LAW"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Soft Law"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForceScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Strict",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStrength"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Strength value for a norm that admits no defeat, such as a peremptory or constitutional-core norm."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Strict"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStrengthScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "STRICT"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Strict"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStrengthScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#Superseded",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Replaced by another norm."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Superseded"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SUPERSEDED"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Superseded"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatusScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#TemporalDefeater",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A defeater in which a later norm withdraws an earlier one: repeal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Temporal Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Derogation under lex posterior. Unlike an ExceptionDefeater it is total rather than case-conditional, and it concerns the validity of the defeated norm — its membership of the normative system — rather than its applicability to a particular case."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Pairs with the norma:supersedes shortcut and the norma:Superseded lifecycle value. Because repeal bears on validity and not on applicability, consumers that stratify the defeat digraph should apply temporal defeat as a filter selecting the normative system in force at a given time, before building the case-specific graph, rather than as a step of that graph."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#TriggerEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Reified instance of the triggering relation between a legal condition, one evaluated condition outcome, and one activated normative content item. Represents true, false, and other branch-specific activations without using separate branch-label datatype properties. Follows Pattern 1 / Use Case 1 of the W3C Working Group Note Defining N-ary Relations on the Semantic Web."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Trigger Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid76"
  }, {
    "@id" : "_:genid77"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#TrueOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConditionOutcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Condition outcome indicating that the condition holds, corresponding to a true or yes branch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "True Outcome"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConditionOutcomeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "TRUE"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "True outcome"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConditionOutcomeScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#UnderReview",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Review status indicating that the annotation is currently under legal, editorial, or analytical review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Under Review"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "UNDER_REVIEW"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Under Review"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Moved from norma:NormStatus to norma:ReviewStatus in version 2.0. Reviewing an annotation does not change whether the norm itself is in force, so the value belongs to the review lifecycle of the annotation — between norma:PendingReview and norma:Approved — and not to the lifecycle of the normative content. Consumers of version 1.0 graphs that used it as a norm status should remap it."
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatusScheme"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#WeakPermission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A derived, case-relative statement that a legal action is not forbidden for a legal agent under a described fact pattern. Reified following the W3C n-ary relation pattern, as norma:TriggerEvent, norma:LegalPosition and norma:Defeater are."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Weak Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://w3id.org/def/norma-o/deriv"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#Entity"
  }, {
    "@id" : "_:genid78"
  }, {
    "@id" : "_:genid79"
  }, {
    "@id" : "_:genid80"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Weak permission in the sense of von Wright and of Alchourron and Bulygin: not-F(x) holding by absence of a prohibition, as opposed to strong permission, which is an enacted norma:Permission. A WeakPermission is therefore not a norm — it has no legal source and no text — and is disjoint from norma:NormativeContent."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A prohibition whose own status is undecided BLOCKS the weak permission: the reading is sceptical, not credulous. If the fate of a prohibition is not fixed by the asserted defeaters, then it cannot be asserted that the action is not forbidden, and the honest result is the absence of a weak permission rather than one that a later resolution may withdraw. A credulous reading would also compound an optimism the conclusion already carries, since a weak permission is a closed-world conclusion to begin with."
  }, {
    "@language" : "en",
    "@value" : "Not monotonic, and not an entailment of the annotation graph on its own: it is computed under a closed-world reading of the described case, of the evaluated graph, or of both. Adding a norm, or adding a fact to the case, can withdraw it. Instances therefore belong only in a derived graph, carry prov:wasGeneratedBy toward the activity that produced them, and that activity must record the assumptions it relied on with normad:computedUnderAssumption from the NORMA-O Derivation module."
  }, {
    "@language" : "en",
    "@value" : "Relative to the agent and NOT to a counterparty, deliberately. This follows the Standard Deontic Logic reading, where the conclusion is that no norm of the system prohibits the action to that agent. It does not translate directly into a Hohfeldian position, which would be directed and would read as a liberty against a particular party: a norma:Privilege is conferred by an enacted norma:Permission, whereas a weak permission is the mere absence of a prohibition and so names no counterparty to hold the correlative norma:NoRight against."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#aboutAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a weak permission to the single legal action it concerns."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#WeakPermission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "about action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#actionText",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Raw textual form of the regulated action as entered in the annotation template."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "action text"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A LOW-CEREMONY SHORTCUT, and the derivation does not read it. The same holds for norma:agentText, norma:objectText, norma:conditionTrigger and the norma:from… literals: they record what the text said without committing to an individual, which is useful while annotating and useless for inference. A norm that carries only norma:actionText and no norma:hasLegalAction falls OUT of the deontic closure, confers no Hohfeldian position and blocks no weak permission. Mint the individuals as soon as the graph has to reason across norms."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#activatesNorm",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a trigger event to the normative content it activates. Declared functional because each trigger event activates exactly one normative content item. Declared as a subproperty of rdf:value to mark the activated norm as the main value of the reified n-ary relation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "activates norm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#value"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#agentText",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Raw textual form of the legal agent as entered in the annotation template."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "agent text"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#annotationDate",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Date on which the annotation activity took place. Convenience shortcut; for instant-level precision use `prov:startedAtTime`/`prov:endedAtTime` from PROV-O (both are valid on prov:Activity, unlike prov:generatedAtTime which is defined on prov:Entity)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#AnnotationActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "annotation date"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#date"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#appliesWhen",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a defeater to a trigger event that activates it. The range is norma:TriggerEvent rather than norma:ConditionOutcome so that the gate identifies both the legal condition and the branch it takes: an outcome value on its own is shared by every condition in the graph and therefore identifies nothing."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "applies when"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "For the same reason a defeater whose defeating norm is invalid — repealed, or carrying a lifecycle status that excludes it — withdraws nothing. The defeated norm then simply remains applicable: it never lost its own validity, which is the same principle that bars a repealed repealing norm from reviving what it repealed."
  }, {
    "@language" : "en",
    "@value" : "The condition of an exception may be annotated in two places, and a consumer must read them in CONJUNCTION. This property gates the defeat relation: it says when the defeater reaches the defeated norm. The activation of the defeating norm, through norma:activatesNorm, says whether that norm is operative in the case at all. A norm the case does not trigger is not operative and therefore defeats nothing, however its defeater is gated — so an evaluation that honoured only this property would let an untriggered exception withdraw its rule. Requiring both lets an annotator state the condition in either place and still get the right answer, and where the two differ it yields their conjunction, which is the conservative reading."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#articleNumber",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Article, section, or equivalent unit number. Not functional: a single LegalSource may cover multiple articles."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "article number"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#assignedUnderRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a role assignment to the normative content that justifies it: the constitutive rule under which this party counts as occupying this role in this case."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assigned under rule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isRuleOfRoleAssignment"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Not required by an axiom. An assignment may record a party’s original capacity, which no reclassifying rule confers and which the facts of the case simply state; it is the reclassified ones that need the citation. Enforce it where a corpus demands it with SHACL."
  }, {
    "@language" : "en",
    "@value" : "Without it an assignment is a bare assertion with no legal basis, which defeats the purpose of an ontology built for source traceability: a consumer asking why a party counts as a provider must be able to reach article 25(1) rather than take the annotator’s word for it. It also makes the assignment auditable against the rule, since the rule names the role it confers with norma:confersRole and the circumstances with its own activation conditions."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#concernsLegalAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal position to the legal action that forms its content. The action is always one to be realised by the party who is bound or free: the holder of a Duty or Privilege, and the counterparty of a Claim or No-right. For positions conferred by a Prohibition, the content is the negated action (see norma:isNegationOf). Implemented with the OWL 2 property chain isCorrelativeOf ∘ concernsLegalAction, so that correlative positions share the same content, as Hohfeld's correlativity requires."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "concerns legal action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isContentOfLegalPosition"
  } ],
  "http://www.w3.org/2002/07/owl#propertyChainAxiom" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/def/norma-o#isCorrelativeOf"
    }, {
      "@id" : "https://w3id.org/def/norma-o#concernsLegalAction"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#conditionStatement",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Plain-language formulation of the legal condition being evaluated. In the NORMA toolkit it is taken from the label of the annotated condition, but the property itself is independent of any authoring tool."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalCondition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "condition statement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#conditionTrigger",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Raw textual description of the condition under which the norm applies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "condition trigger"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#confersLegalPosition",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links normative content to a Hohfeldian legal position it creates. A binding regulative norm confers a pair of correlative positions: an Obligation or Prohibition confers a Duty and its Claim, a Permission a Privilege and its No-right. The domain is NormativeContent rather than RegulativeNorm so that second-order positions conferred by constitutive rules can be added by future extensions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "confers legal position"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isLegalPositionConferredBy"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#confersRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links normative content to a legal role it attributes. On a norma:ConstitutiveRule this is the rule’s constitutive effect: the role that the parties satisfying its circumstances come to occupy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "confers role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalRole"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isRoleConferredBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "This is what gives norma:ConstitutiveRule a formal consequence instead of only a text. A definitional provision that constitutes a role, and a reclassifying provision such as article 25(1) of Regulation (UE) 2024/1689, both state which role results; the circumstances under which it results are the rule’s own activation conditions, through norma:activatesNorm, so a reclassification that the case does not trigger confers nothing."
  }, {
    "@language" : "en",
    "@value" : "Whether a particular party comes to occupy the role is not stated here. The rule says which role follows; norma:RoleAssignment in a norma:FactPattern says who occupies it in a case. Keeping the two apart is what lets one rule serve every case."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#confidenceScore",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Confidence score the annotation activity assigned to its output, constrained to the closed interval [0,1]. Placed on the activity rather than the annotation entity to attribute uncertainty to the extraction process; downstream consumers traverse `prov:wasGeneratedBy` to reach it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#AnnotationActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "confidence score"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid13"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#conflictPrevailsOver",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Typed prevalence edge for rebutting defeat resolved by a priority principle. Materialised by the compilation step in the derived artefact and never asserted by annotators: rebutting defeat always goes through a reified norma:ConflictDefeater, which carries the resolution principle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "conflict prevails over"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#prevailsOver"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#deadline",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Deadline, sunset date, end date, or textual temporal constraint associated with the normative content."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "deadline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#defeatedNorm",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a defeater to the normative content whose normative effect it withdraws. Deliberately not functional, because a single repeal may withdraw a block of norms; enforce the cardinality your domain requires with SHACL."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "defeated norm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#defeatingNorm",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a defeater to the normative content that performs the overriding. Required in practice: a defeater that names none contributes no edge to norma:prevailsOver, so the defeat it records stays invisible in the flat prevalence digraph and cannot itself be defeated. Where the source expresses a carve-out without granting a liberty, state it as a norma:ConstitutiveRule rather than leaving this property empty."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "defeating norm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#deonticId",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Unique identifier for a norm or constitutive rule within a regulation pack. Any stable local identifier is acceptable; the NORMA toolkit composes one from the modality notation and a slug of the annotated element label (e.g. OBL_Mark_AI_generated_content). Uniqueness is a producer invariant, not an OWL one; to enforce global uniqueness across graphs, declare InverseFunctionalProperty or add a SHACL uniqueness constraint."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "deontic ID"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#deonticallyConflictsWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links two regulative norms that cannot both hold for the same legal agent, counterparty, and circumstances under Standard Deontic Logic. Covers contradictory pairs (see norma:deonticallyContradicts) and contrary pairs, which cannot both hold but may both fail to hold, such as an Obligation of X and a Prohibition of X (O(X) and O(¬X), jointly inconsistent under axiom D). Intended to support norm-conflict detection."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "deontically conflicts with"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#relatesTo"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Conflict is detected BETWEEN ROLES, not between parties. Both this relation and norma:WeakPermission compare the norma:hasLegalAgent of two norms, which in real legislation is a norma:LegalRole, so a clash between the duties of two roles that one and the same norma:LegalParty occupies in a case is NOT detected — and article 25(1) of Regulation (EU) 2024/1689, under which a deployer comes to count as a provider as well, is exactly that situation. Projecting the comparison onto parties is future work."
  }, {
    "@language" : "en",
    "@value" : "Derived, never annotated. Contradictory pairs come from norma:deonticallyContradicts and are entailed through the subproperty axiom. Contrary pairs are a separate join over the closure: one norm entails norma:entailsObligatory of an action and the other norma:entailsForbidden of that same action, for the same legal agent, without disagreeing on the counterparty, without activation conditions that cannot hold together, and with both ends outside the norma:Permission subtree."
  }, {
    "@language" : "en",
    "@value" : "Irreflexive: no norm conflicts with itself. A derived conflict is a finding about the normative system, not an inconsistency in the graph — real legal corpora contain antinomies, and resolving them is the business of the defeasibility layer, not of the reasoner."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#deonticallyContradicts",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links two regulative norms whose deontic contents are the negation of each other, so that exactly one of them holds: a Permission of X and a Prohibition of X (P(X) ≡ ¬F(X)), or a Permission of ¬X and an Obligation of X (P(¬X) ≡ ¬O(X)). In Hohfeld's terms, the Privilege conferred by the permission is the jural opposite of the Duty conferred by the other norm."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "deontically contradicts"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#deonticallyConflictsWith"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Circumstances cannot be dropped from the comparison. Two norms activated by OPPOSITE branches of one norma:LegalCondition never meet in any case, so reporting them as in conflict is a false positive, and the derivation excludes that pair. What remains is a POTENTIAL conflict: this property has no slot for a case, so whether the conflict is realised — both norms valid, activated and undefeated in a described norma:FactPattern — is settled by evaluating that case, not by this relation."
  }, {
    "@language" : "en",
    "@value" : "Derived, never annotated. Given the closure, the join is: one norm entails norma:entailsPermitted of an action and the other norma:entailsNotPermitted of that same action, for the same legal agent, without disagreeing on the counterparty, and without activation conditions that cannot hold together."
  }, {
    "@language" : "en",
    "@value" : "Irreflexive: no norm contradicts itself. The Hohfeldian face of this relation is norma:isJuralOppositeOf holding between positions conferred by the two norms."
  }, {
    "@language" : "en",
    "@value" : "The derivation must start from the PERMISSION side, and the class-level restrictions are what force this. Axiom D gives an Obligation of X the entailment P(X), so a join taken in either direction would also fire between an Obligation and a Prohibition of the same action — a CONTRARY pair, which can fail together and therefore does not belong here. Worse, emitting it would be inconsistent: norma:Obligation is restricted to contradict only norma:Permission, so the prohibition would be typed as a Permission, and the two classes are disjoint. Restricting one end to the norma:Permission subtree distinguishes a norm’s own deontic content from what merely follows by D; contraries are recorded with the superproperty norma:deonticallyConflictsWith."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#directlyPrevailsOver",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Superproperty of the asserted prevalence shortcuts. Declared asymmetric and irreflexive so that no norm prevails over itself and two norms cannot each be asserted to prevail directly over the other."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "directly prevails over"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#prevailsOver"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A deliberately partial guard: it catches self-loops and two-cycles among asserted shortcuts only. Full acyclicity of the defeat digraph is not expressible in OWL 2 DL and must be checked by the consuming application, where a cycle signals an antinomy to be resolved by a norma:ResolutionPrinciple or reported as irresoluble."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#effectiveDate",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Date from which the normative content is effective."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "effective date"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#date"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsDiscouraged",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is discouraged."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails discouraged"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsForbidden",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is forbidden, F(x), equivalently that its negation is obligatory, O(not-x)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails forbidden"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentProperty" : [ {
    "@id" : "https://w3id.org/def/norma-o#entailsNotPermitted"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsNotForbidden",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is not forbidden, not-F(x). Equivalent to entailing that the action is permitted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails not forbidden"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentProperty" : [ {
    "@id" : "https://w3id.org/def/norma-o#entailsPermitted"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsNotObligatory",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is not obligatory, not-O(x). Follows from a prohibition of the action, or from a permission of its negation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails not obligatory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2002/07/owl#propertyDisjointWith" : [ {
    "@id" : "https://w3id.org/def/norma-o#entailsObligatory"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsNotPermitted",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is not permitted, not-P(x). Equivalent to entailing that the action is forbidden."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails not permitted"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2002/07/owl#propertyDisjointWith" : [ {
    "@id" : "https://w3id.org/def/norma-o#entailsPermitted"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsObligatory",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is obligatory, O(x)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails obligatory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Both members of each equivalent pair are materialised — F(x) alongside not-P(x) — so that queries succeed without reasoning; under reasoning they are the same relation."
  }, {
    "@language" : "en",
    "@value" : "Derived, never annotated. The closure is materialised by a rule set rather than entailed by OWL, because the equivalences that flip the action — F(x) equivalent to O(not-x), and P(x) to not-O(not-x) — would need property chains over norma:isNegationOf in both directions. That violates the regularity condition of OWL 2 DL, since it would require entailsObligatory to precede entailsForbidden and entailsForbidden to precede entailsObligatory at once, and it would make the properties non-simple, so they could no longer be declared disjoint. Only the two equivalences that keep the same action are asserted as axioms."
  }, {
    "@language" : "en",
    "@value" : "The eight norma:entails... properties make the Standard Deontic Logic closure of an annotated norm explicit, so that it can be queried without a reasoner. They are scoped to a single norm: each says what that norm implies about the action for its own legal agent, toward its own counterparty and under its own conditions — not what status the action holds in the normative system as a whole, which other norms may settle differently. Two norms entailing opposite statuses for the same action is a norm conflict, to be recorded with norma:deonticallyConflictsWith, and not an inconsistency."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsPermitted",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is permitted, P(x). Equivalent to entailing that the action is not forbidden, and implied by an obligation of the action through the SDL axiom D."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails permitted"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#entailsRecommended",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Derived: the regulative norm entails that the legal action is recommended."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entails recommended"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The recommendation operators receive no analogue of the SDL axiom D: nothing of the form Rec(x) implies not-Rec(not-x) is generated, because a non-binding operator licenses no such inference. Only the action-flipping analogy holds, so a recommendation of x entails that not-x is discouraged."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#establishesTrigger",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links normative content to a trigger event that HOLDS whenever that content applies: the institutional fact the content brings about. On a norma:ConstitutiveRule this is its counts-as conclusion expressed as a fact of the case, so that regulative norms conditioned on that fact become activated by it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "establishes trigger"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Evaluation therefore ALTERNATES: the institutional facts established by the constitutive rules that apply are added to the case, and the regulative norms are evaluated against the case so augmented, until no new fact appears. The classic counts-as problem (Searle; Jones and Sergot). Because the set of established facts only grows, the alternation terminates; but a fact may gate a defeater that withdraws the very rule that established it, and a consumer must be told when that happened rather than shown a conclusion that quietly rests on it."
  }, {
    "@language" : "en",
    "@value" : "This is what chains constitutive rules to regulative ones, and without it the two layers never meet. norma:confersRole covers the counts-as that attributes a ROLE; this covers the counts-as that establishes a FACT. Article 6(2) of Regulation (EU) 2024/1689 is the case that demands it: systems listed in Annex III count as high-risk, and the obligations of Articles 16 and 26 are conditioned on being high-risk rather than on being listed."
  }, {
    "@language" : "en",
    "@value" : "Why it cannot be replaced by annotating the fact in the norma:FactPattern: a fact asserted in the case is brute and no defeater can touch it, whereas an institutional fact is DEFEASIBLE. Article 6(3) withdraws the classification of Article 6(2), and the final subparagraph withdraws that withdrawal, so whether the system counts as high-risk is the outcome of evaluating a defeat chain. A regulative norm wired directly to the defeated rule would skip a rung: everything else depending on the same classification by another path would stay undefeated."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#exception",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Exception or carve-out under which the norm does not apply."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "exception"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2002/07/owl#deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Deprecated in favour of the defeasibility layer: use norma:ExceptionDefeater, or the norma:isExceptionTo shortcut, so that the carve-out carries its condition, its provenance, and a place in the prevalence digraph. Retained for backwards compatibility with published graphs and as a last-resort literal for carve-outs that have not yet been analysed."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#exceptionPrevailsOver",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Typed prevalence edge for undercutting defeat, so that the kind of defeat survives the flattening of the reified Defeater into the norm-to-norm digraph. It is entailed wherever the norma:isExceptionTo shortcut is used, and materialised by the compilation step in the derived artefact for defeat stated through a reified norma:ExceptionDefeater; annotators never assert it directly."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "exception prevails over"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#prevailsOver"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#factStatement",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Plain-language statement of the constitutive rule."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConstitutiveRule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fact statement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#forAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a weak permission to the single legal agent for whom the action is not forbidden."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#WeakPermission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "for agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#fromArticle",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Denormalised article identifier copied from the linked LegalSource."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "from article"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#fromParagraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Denormalised paragraph identifier copied from the linked LegalSource."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "from paragraph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#fromRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Denormalised normative rank copied from the norm's legal source, in the same way as norma:fromRegulation and norma:fromArticle. A property chain over hasLegalSource and hasRank is deliberately not used, because it would make the property non-simple and therefore unable to be functional."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "from rank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRank"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#fromRegulation",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Denormalised regulation name copied from the linked LegalSource for convenient querying and SWRL rule generation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "from regulation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#generatedNormativeContent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links an annotation activity to normative content that it generated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#AnnotationActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "generated normative content"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasAssignedParty",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a role assignment to the single party that occupies the role."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has assigned party"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalParty"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasAssignedRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a role assignment to the single role the party occupies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has assigned role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalRole"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isAssignedRoleOf"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasBindingForce",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a regulative norm with exactly one binding-force value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has binding force"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForce"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isBindingForceOf"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasComplianceCriticality",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a regulative norm with exactly one compliance-criticality value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has compliance criticality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticality"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasCounterparty",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a regulative norm to the legal agent in relation to whom the norm-bearing legal agent is bound or free: the holder of the correlative Claim of an Obligation or Prohibition, or of the correlative No-right of a Permission. Together with norma:hasLegalAgent it makes both ends of the Hohfeldian relation explicit at norm level."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has counterparty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "When the legal text names no beneficiary, as is common in public-law regulation, the counterparty is typically the competent public authority or the class of persons the norm protects; mint a LegalAgent for it rather than leaving the relation implicit."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasExtractionMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a normative content item with the method used to produce its annotation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has extraction method"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethod"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasLegalAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a regulative norm to the legal action it regulates. The producer may instead use the literal shortcut `norma:actionText`; both forms are permitted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has legal action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasLegalAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a regulative norm to its norm-bearing legal agent (the subject obliged, prohibited, permitted, or recommended)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has legal agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasLegalObject",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a regulative norm to the legal object of the action it regulates."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has legal object"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalObject"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasLegalSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links normative content to the legal source (work-level resource) from which it is extracted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has legal source"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalSource"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isLegalSourceOf"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasNormStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a normative content item with exactly one lifecycle status."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has norm status"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStatus"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasNormStrength",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a normative content item with exactly one strength value, stating whether it admits defeat."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has norm strength"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormStrength"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isNormStrengthOf"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a trigger event to the condition outcome that characterises it, for example the true branch, false branch, or another controlled outcome. Declared functional because each trigger event has exactly one outcome."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has outcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConditionOutcome"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasPositionCounterparty",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal position to the legal agent against whom it is held (B in \"A has a duty toward B\"). Implemented with the OWL 2 property chain isCorrelativeOf ∘ hasPositionHolder, which encodes Hohfeld's correlativity: the counterparty of a position is the holder of its correlative. Because it is defined by a property chain, the property is non-simple in OWL 2 DL and cannot be declared functional; validate the uniqueness of the counterparty with SHACL."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has position counterparty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ],
  "http://www.w3.org/2002/07/owl#propertyChainAxiom" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/def/norma-o#isCorrelativeOf"
    }, {
      "@id" : "https://w3id.org/def/norma-o#hasPositionHolder"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasPositionHolder",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal position to the single legal agent who holds it (A in \"A has a duty toward B\")."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has position holder"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasRank",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a legal source with exactly one rank in the hierarchy of sources. Rank is a property of the source rather than of the individual norm; norms carry the denormalised copy norma:fromRank."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has rank"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeRank"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasResolutionPrinciple",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a conflict defeater with the legal principle that orients it. Not functional: lex specialis and lex posterior may be invoked together, and they may point in opposite directions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#ConflictDefeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has resolution principle"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#ResolutionPrinciple"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasReviewStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Associates a normative content item with one review status."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has review status"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#ReviewStatus"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasSourceExpression",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a LegalSource (ELI work-level) to a specific LegalSourceExpression (language, version, consolidation). Subproperty of `eli:is_realized_by` to preserve ELI semantics."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has source expression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalSourceExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://data.europa.eu/eli/ontology#is_realized_by"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#hasTrigger",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal condition to one of its trigger events. A condition may have several trigger events, for example one trigger event for the true branch and one trigger event for the false branch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalCondition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has trigger"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isTriggerOfCondition"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#holdsRoleAssignment",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a fact pattern to a role assignment that holds in it: who acted, and in what capacity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#FactPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "holds role assignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RoleAssignment"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Together with norma:holdsTrigger this completes the description of a case: the triggers say what happened, the role assignments say in what capacity each party acted. A norm addressed to a role reaches, in that case, the parties the case places in that role; the reach itself is a consequence and belongs in a derived artefact, not here."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#holdsTrigger",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a fact pattern to a trigger event that fires in it, that is, to a legal condition together with the outcome it takes in the described case. The trigger events a fact pattern holds select the active subgraph of activation and defeat relations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#FactPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "holds trigger"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#isHeldInFactPattern"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#inFactPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a weak permission to the single described case relative to which it was computed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#WeakPermission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "in fact pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#FactPattern"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isActivatedByTriggerEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links normative content to a trigger event that activates it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is activated by trigger event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#activatesNorm"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isAnnotatorOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links an annotator agent to normative content attributed to that annotator."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#AnnotatorAgent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is annotator of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#wasAttributedToAnnotator"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isAssignedPartyOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a party to the role assignments that place it in a role."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalParty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is assigned party of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RoleAssignment"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#hasAssignedParty"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isAssignedRoleOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a role to the role assignments that place a party in it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is assigned role of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RoleAssignment"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isBindingForceOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a binding-force value to regulative norms classified with that value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#BindingForce"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is binding force of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isComplianceCriticalityOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a compliance-criticality value to regulative norms classified with that value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#ComplianceCriticality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is compliance criticality of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#hasComplianceCriticality"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isContentOfLegalPosition",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal action to a legal position whose content it forms."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is content of legal position"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isCorrelativeOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal position to its Hohfeldian correlative: the position necessarily held by the counterparty toward the holder concerning the same action (Duty ⟷ Claim, Privilege ⟷ No-right). Symmetric because correlativity is mutual, functional because each position has exactly one correlative, and irreflexive because no position is its own correlative. It drives the property chains of norma:hasPositionCounterparty and norma:concernsLegalAction."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is correlative of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isCounterpartyOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal agent to a regulative norm for which it is the counterparty."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is counterparty of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#hasCounterparty"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isDefeatedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links normative content to a defeater that withdraws its normative effect."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is defeated by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#defeatedNorm"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isDefeatingNormOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links normative content to a defeater in which it performs the overriding."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is defeating norm of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#defeatingNorm"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isDeonticallyEquivalentTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links two regulative norms that express the same deontic content for the same legal agent, counterparty, and circumstances under the interdefinability of deontic operators, even when annotated with different operators: e.g. a Prohibition of X and an Obligation of ¬X (F(X) ≡ O(¬X)), or a Negative Recommendation of X and a Recommendation of ¬X. Symmetric and transitive. Class-level restrictions on the RegulativeNorm subclasses keep equivalences within compatible operator families, so asserting, for instance, that an Obligation is equivalent to a Permission makes the knowledge graph inconsistent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is deontically equivalent to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#relatesTo"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "SWRL derivation: norma:Prohibition(?n1) ^ norma:hasLegalAction(?n1, ?x) ^ norma:Obligation(?n2) ^ norma:hasLegalAction(?n2, ?y) ^ norma:isNegationOf(?x, ?y) ^ norma:hasLegalAgent(?n1, ?a) ^ norma:hasLegalAgent(?n2, ?a) -> norma:isDeonticallyEquivalentTo(?n1, ?n2), additionally requiring the same counterparty, legal object, and triggering conditions where these are annotated."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "An unannotated counterparty is treated as not disagreeing rather than as a mismatch. This is a declared reading, not a neutral one: it lets equivalences surface in corpora where the counterparty is not yet annotated, at the cost of asserting an equivalence that a later annotation may refute. Producers that annotate norma:hasCounterparty throughout get the strict reading for free."
  }, {
    "@language" : "en",
    "@value" : "Circumstances are compared as the set of (norma:LegalCondition, outcome) pairs activating each norm, not as trigger-event identity: a producer that mints one norma:TriggerEvent per norm would otherwise never find two norms equivalent. Two norms with the same content but different activating conditions are not equivalent, which is why the comparison cannot be dropped."
  }, {
    "@language" : "en",
    "@value" : "Derived, never annotated. Given the closure, the general join replaces the operator-by-operator rule above: two norms are equivalent when they share the legal agent, do not disagree on the counterparty, are activated in the same circumstances, and their CLOSURES COINCIDE term by term. Set equality is what makes the test sound — a Permission and a Facultative over the same action share norma:entailsPermitted, so a join on a single shared entailment would wrongly equate them, while the facultative additionally entails P(¬X) and ¬O(X)."
  }, {
    "@language" : "en",
    "@value" : "PRIMA FACIE, like the Hohfeldian positions and for the same reason: the relation holds between the norms AS ENACTED and does not consult their status in any case. Two norms stay equivalent even where an exception defeats one of them, and a conflict stays recorded even where the facts of a case activate only one side. Realising or dissolving either in a particular situation is the business of the case evaluation."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isExceptionTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Low-ceremony shortcut stating that the subject norm is a carve-out from the object norm, without reifying a Defeater. Mint a norma:ExceptionDefeater instead when the carve-out needs a condition, a principle, or provenance of its own."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is exception to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#directlyPrevailsOver"
  }, {
    "@id" : "https://w3id.org/def/norma-o#exceptionPrevailsOver"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isExtractionMethodOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links an extraction method to normative content produced using that method."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#ExtractionMethod"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is extraction method of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#hasExtractionMethod"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isGateOfDefeater",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a trigger event to a defeater it activates."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is gate of defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#Defeater"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#appliesWhen"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isHeldInFactPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a trigger event to fact patterns in which it fires."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#TriggerEvent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is held in fact pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#FactPattern"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isJuralOppositeOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal position to its Hohfeldian jural opposite: the position held by the SAME agent TOWARD THE SAME COUNTERPARTY whose content is the negation of this one's, so that exactly one of the two obtains (Duty ⟷ Privilege, Claim ⟷ No-right). A Duty of A toward B concerning X is the opposite of a Privilege of A toward B concerning ¬X, mirroring O(X) ≡ ¬P(¬X). Symmetric because opposition is mutual, and irreflexive because no position is its own opposite."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is jural opposite of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Deliberately NOT functional, unlike norma:isCorrelativeOf. A position has exactly one correlative, minted with it by the same norm, but its opposite may be conferred by several different norms at once, and in a conflicting normative system it may be conferred by none. Deliberately NOT transitive either: the opposite of the opposite is the position itself, so transitivity would make every position its own opposite and contradict irreflexivity."
  }, {
    "@language" : "en",
    "@value" : "Derived, never annotated. The join is: same norma:hasPositionHolder, same counterparty, contents related by norma:isNegationOf, and classes drawn from one axis of the square. The counterparty is compared on the CONFERRING NORMS, through norma:hasCounterparty, because the position's own norma:hasPositionCounterparty follows from a property chain and is not materialised. Because each position is conferred by a norm, deriving an opposition between positions conferred by two DIFFERENT norms is the Hohfeldian face of norma:deonticallyContradicts specifically, and not of its superproperty: a CONTRARY pair confers two Duties, never a Duty and its opposite, so contraries have no Hohfeldian face at all. Under the subproperty axiom the pair is also in norma:deonticallyConflictsWith, which is what a query over the derived graph will find. The two are NOT independent evidence of a conflict, and must not be presented as such: both are computed from the same deontic closure, so their agreement is an internal coherence check on the two joins — worth running, since either can be written wrongly — and not a second confirmation of the conflict itself. Independent evidence would have to come from outside the closure, such as from the legal text."
  }, {
    "@language" : "en",
    "@value" : "THE COUNTERPARTY MUST BE COMPARED, because legal positions are directed. What the comparison does with silence is a separate decision: a counterparty that no annotator named is read as NOT DISAGREEING rather than as a mismatch, which lets oppositions surface in corpora where the counterparty is not yet annotated, at the cost of an opposition that a later annotation may refute. That reading is non-monotonic and a derivation that adopts it records normad:OpenCounterparty. One agent may bear a Duty toward B concerning X and at the same time hold a Privilege against C concerning ¬X, and those are two distinct jural relations rather than an opposition — Hohfeld's own multital analysis. Comparing holders alone would collapse them and report a contradiction where none exists."
  }, {
    "@language" : "en",
    "@value" : "The second axis of Hohfeld's square, and the counterpart of norma:isCorrelativeOf. The two must not be confused: a correlative is the same jural relation seen from the other party, concerning the same action, whereas an opposite is held by the same party toward the same party and concerns the negated action. Correlativity therefore swaps holder and counterparty, while opposition preserves both and negates the content."
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isLegalActionOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal action to the regulative norm that regulates it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is legal action of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#hasLegalAction"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isLegalAgentOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal agent to the regulative norm for which it is the norm-bearing subject."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAgent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is legal agent of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#hasLegalAgent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isLegalObjectOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal object to the regulative norm in which it is regulated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalObject"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is legal object of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#RegulativeNorm"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/def/norma-o#hasLegalObject"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isLegalPositionConferredBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal position to the normative content that confers it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalPosition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is legal position conferred by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isLegalSourceOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal source to normative content extracted or derived from it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is legal source of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#NormativeContent"
  } ]
}, {
  "@id" : "https://w3id.org/def/norma-o#isNegationOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a legal action X to the legal action ¬X that consists in not performing X, and vice versa. Provides the action-level negation that Standard Deontic Logic needs to state F(X) ≡ O(¬X) and P(X) ≡ ¬O(¬X). Symmetric because ¬¬X ≡ X; functional because an action has a single negation (two actions declared as negations of the same action are inferred to be the same action); irreflexive because no action is its own negation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/def/norma-o"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is negation of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/norma-o#LegalAction"
  } ]
