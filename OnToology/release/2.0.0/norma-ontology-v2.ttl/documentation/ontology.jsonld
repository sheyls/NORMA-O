  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "NORMA-O: The NORMA Ontology for Legal Norm Annotations"
  } ],
  "http://purl.org/ontology/bibo/doi" : [ {
