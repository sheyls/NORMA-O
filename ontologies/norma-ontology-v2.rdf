<?xml version="1.0" encoding="UTF-8"?>

<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:norma="https://w3id.org/def/norma-o#"
  xmlns:eli="http://data.europa.eu/eli/ontology#"
  xmlns:bibo="http://purl.org/ontology/bibo/"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:lkif="http://www.estrellaproject.org/lkif-core/norm.owl#"
  xmlns:lkif-la="http://www.estrellaproject.org/lkif-core/legal-action.owl#"
  xmlns:prov="http://www.w3.org/ns/prov#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:schema="https://schema.org/"
  xmlns:vann="http://purl.org/vocab/vann/"
>

  <!-- Ontology metadata -->
  <owl:Ontology rdf:about="https://w3id.org/def/norma-o">
    <rdfs:label xml:lang="en">NORMA ontology</rdfs:label>
    <dcterms:title xml:lang="en">NORMA-O: The NORMA Ontology for Legal Norm Annotations</dcterms:title>
    <dcterms:alternative xml:lang="en">NORMA Ontology</dcterms:alternative>
    <rdfs:comment xml:lang="en">Formal ontology for representing machine-readable legal norm annotations, their legal context, conditional applicability, provenance, source traceability, lifecycle status, and controlled classification values in the NORMA toolkit.</rdfs:comment>
    <dcterms:description xml:lang="en">The NORMA ontology is a formal semantic model for representing machine-readable legal norm annotations as reusable knowledge graph resources. It distinguishes between regulative norms and constitutive rules; represents legal conditions, their evaluated outcomes, and branch-sensitive activation through a TriggerEvent n-ary relation pattern; and captures the legal agents, actions, objects, sources, provenance metadata, lifecycle status, review status, extraction method, and controlled classification values needed for traceable and interoperable publication. The ontology aligns with PROV-O for provenance, ELI for legal resource modelling, FOAF for agent-oriented metadata, and SKOS for controlled vocabularies, and provides informative alignments with LKIF-Core via SKOS mapping properties. Regulative norms are formally grounded in Standard Deontic Logic, whose interdefinability of operators (F(X) ≡ O(¬X), P(X) ≡ ¬O(¬X), and facultativeness as P(X) ∧ P(¬X)) is captured through action negation and inter-norm deontic equivalence and contradiction relations, and in Hohfeld's scheme of first-order jural correlatives (duty and claim, privilege and no-right), represented as reified, directed legal positions between a holder and a counterparty. Defeasibility is modelled as a reified defeat relation between norms — undercutting exceptions, rebutting conflicts resolved by lex superior, specialis or posterior, and repeal — which flattens into a norm-to-norm prevalence digraph whose stratification, cycles and reinstatements are derived rather than stored. The deontic closure of each norm and the weak permissions holding in a described case are likewise part of the vocabulary but never annotated: they are materialised by a rule set into a derived graph, whose activity records the non-monotonic assumptions it relied on through the companion NORMA-O Derivation module.</dcterms:description>
      <dcterms:creator>
      <foaf:Person>
        <foaf:name>Sheyla Leyva-Sánchez</foaf:name>
      </foaf:Person>
    </dcterms:creator>
    <dcterms:contributor>
      <foaf:Person>
        <foaf:name>María Poveda-Villalón</foaf:name>
      </foaf:Person>
    </dcterms:contributor>
    <dcterms:contributor>
      <foaf:Person>
        <foaf:name>Víctor Rodríguez-Doncel</foaf:name>
      </foaf:Person>
    </dcterms:contributor>
    <dcterms:publisher>
      <foaf:Organization>
        <foaf:name>NORMA project</foaf:name>
      </foaf:Organization>
    </dcterms:publisher>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-15</dcterms:created>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-09</dcterms:issued>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-09</dcterms:modified>
    <dcterms:language rdf:resource="http://id.loc.gov/vocabulary/iso639-1/en"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:source rdf:resource="https://github.com/sheyls/NORMA-O"/>
    <dcterms:bibliographicCitation xml:lang="en">Leyva-Sánchez, S. et al. (2026). NORMA-O: The NORMA Ontology for Legal Norm Annotations (Version 2.0) [Ontology]. https://w3id.org/def/norma-o/2.0</dcterms:bibliographicCitation>
    <bibo:doi>10.5281/zenodo.24116269</bibo:doi>
    <bibo:status xml:lang="en">Published</bibo:status>
    <vann:preferredNamespacePrefix>norma</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/def/norma-o#</vann:preferredNamespaceUri>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/norm.owl"/>
    <rdfs:seeAlso rdf:resource="https://doi.org/10.2307/785533"/>
    <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/logic-deontic/"/>
    <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/reasoning-defeasible/"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/def/norma-o/deriv"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/swbp-n-aryRelations/"/>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
    <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <owl:priorVersion rdf:resource="https://w3id.org/def/norma-o/1.0"/>
    <owl:versionIRI rdf:resource="https://w3id.org/def/norma-o/2.0"/>
    <owl:versionInfo>2.0</owl:versionInfo>
    <foaf:logo rdf:resource="https://raw.githubusercontent.com/sheyls/NORMA-O/main/release/2.0.0/norma-o-v2.svg"/>
    <schema:includedInDataCatalog rdf:resource="https://zenodo.org/communities/norma"/>
  </owl:Ontology>


  <!-- Core class hierarchy and conceptual model -->
  <owl:Class rdf:about="https://w3id.org/def/norma-o#NormativeContent">
    <rdfs:label xml:lang="en">Normative Content</rdfs:label>
    <rdfs:comment xml:lang="en">An informational entity that expresses machine-readable legal-normative content extracted or formulated from a legal source, either a regulative norm or a constitutive rule. Jurisdiction is represented only with eli:jurisdiction, whose value must be an eli:AdministrativeArea. If no authoritative URI is available yet, use a local provisional resource typed as eli:AdministrativeArea and provide its rdfs:label.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://data.europa.eu/eli/ontology#jurisdiction"/>
        <owl:allValuesFrom rdf:resource="http://data.europa.eu/eli/ontology#AdministrativeArea"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:scopeNote xml:lang="en">Do not attach jurisdiction strings directly to NormativeContent. For extracted labels such as &quot;Spain&quot; or &quot;California&quot;, mint a local jurisdiction resource, type it as eli:AdministrativeArea, attach the extracted text as rdfs:label, and later align or replace it with an authoritative URI when available.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#RegulativeNorm">
    <rdfs:label xml:lang="en">Regulative Norm</rdfs:label>
    <rdfs:comment xml:lang="en">A normative content item that regulates conduct by prescribing, prohibiting, permitting, or recommending a legal action.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:disjointWith rdf:resource="https://w3id.org/def/norma-o#ConstitutiveRule"/>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/norm.owl#Norm"/>
    <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/logic-deontic/"/>
    <skos:scopeNote xml:lang="en">Conceptually close to lkif:Norm in LKIF-Core. rdfs:seeAlso is used rather than rdfs:subClassOf because lkif:Norm is equivalentClass to a restriction on lkif:qualifies (a property NORMA does not use) and because LKIF axiomatises the deontic operators as interdefinable (lkif:Obligation owl:equivalentClass lkif:Prohibition), which would conflict with NORMA's pairwise disjointness of regulative subclasses if formal subsumption were asserted.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Formal grounding in Standard Deontic Logic (SDL). The subclasses of RegulativeNorm classify the deontic operator explicitly used by the annotated legal statement (its surface modality), which is why they are pairwise disjoint. SDL interdefinability — F(X) ≡ O(¬X), P(X) ≡ ¬F(X) ≡ ¬O(¬X), and facultativeness as P(X) ∧ P(¬X) — is therefore not asserted as class equivalence, which would collapse the disjoint annotation classes as in LKIF-Core, but as relations between norms mediated by action negation: norma:isNegationOf between legal actions, and norma:isDeonticallyEquivalentTo, norma:deonticallyContradicts and norma:deonticallyConflictsWith between regulative norms. Likewise, the SDL theorem O(X) → P(X) (axiom D) is a logical consequence of an obligation and does not make an Obligation annotation a Permission annotation. The intersubjective reading of each operator is given by the Hohfeldian legal positions it confers (norma:confersLegalPosition).</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ConstitutiveRule">
    <rdfs:label xml:lang="en">Constitutive Rule</rdfs:label>
    <rdfs:comment xml:lang="en">A normative content item that defines, classifies, or constitutes a legal concept, status, or institutional fact.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-top.owl#counts_as"/>
    <skos:scopeNote xml:lang="en">LKIF-Core does not reify constitutive rules as a class; it expresses constitutive force through the lkif:counts_as property on Subjective_Entity (Searle-style institutional facts). The reference is informative only — no formal alignment is asserted because a class cannot be subsumed by a property.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Scope carve-outs belong here. A clause stating that a norm does not apply to a class of addressees, systems, or circumstances delimits the field of application without granting any liberty, so it is constitutive rather than regulative; modelling it as a norma:Permission would assert a strong permission that the source does not grant. Stating it as a ConstitutiveRule also gives the carve-out a node in the prevalence digraph, so that it can in turn be limited by a further defeater.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The Searle reading is given formal consequence by norma:confersRole. A constitutive rule that constitutes a role says so, and the role it confers reaches a party through a norma:RoleAssignment in a case; the ‘context C’ of ‘X counts as Y in C’ is the rule’s own activation condition. Without that property the class carries a text and a node in the prevalence digraph and nothing else, which is how it stood before: a rule could be evaluated as applicable and still produce no consequence at all.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Obligation">
    <rdfs:label xml:lang="en">Obligation</rdfs:label>
    <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is required.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#deonticallyContradicts"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/def/norma-o#Permission"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Duty"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Claim"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#Duty"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isDeonticallyEquivalentTo"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Obligation"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Prohibition"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/norm.owl#Obligation"/>
    <skos:notation>OBL</skos:notation>
    <skos:definition xml:lang="en">SDL: O(X) — the legal agent is obliged to perform X. Hohfeld: the legal agent (A) bears a Duty toward the counterparty (B) concerning X, and B holds the correlative Claim against A concerning X.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Prohibition">
    <rdfs:label xml:lang="en">Prohibition</rdfs:label>
    <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is forbidden.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#deonticallyContradicts"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/def/norma-o#Permission"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Duty"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Claim"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#Duty"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isDeonticallyEquivalentTo"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Obligation"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Prohibition"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/norm.owl#Prohibition"/>
    <skos:notation>PRH</skos:notation>
    <skos:definition xml:lang="en">SDL: F(X) ≡ O(¬X) — the legal agent is forbidden to perform X, i.e. obliged not to perform it; a Prohibition of X is therefore deontically equivalent (norma:isDeonticallyEquivalentTo) to an Obligation of the negated action ¬X (norma:isNegationOf). Hohfeld: the legal agent (A) bears a Duty toward the counterparty (B) concerning ¬X, and B holds the correlative Claim against A concerning ¬X.</skos:definition>
    <skos:scopeNote xml:lang="en">Annotate the positive action X with norma:hasLegalAction and norma:actionText, since the negation is already carried by the operator: an action text such as &quot;must not develop&quot; under a Prohibition would read as F(¬X) ≡ O(X).</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Permission">
    <rdfs:label xml:lang="en">Permission</rdfs:label>
    <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is allowed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isDeonticallyEquivalentTo"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/def/norma-o#Permission"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Privilege"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#NoRight"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#Privilege"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#deonticallyContradicts"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Obligation"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Prohibition"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/norm.owl#Permission"/>
    <skos:notation>PER</skos:notation>
    <skos:definition xml:lang="en">SDL: P(X) ≡ ¬F(X) ≡ ¬O(¬X) — the legal agent is permitted to perform X, i.e. is not forbidden to perform it; a Permission of X deontically contradicts (norma:deonticallyContradicts) a Prohibition of X, and a Permission of ¬X contradicts an Obligation of X. Hohfeld: the legal agent (A) holds a Privilege toward the counterparty (B) concerning X — the jural opposite of a Duty concerning ¬X — and B has the correlative No-right against A concerning X.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Facultative">
    <rdfs:label xml:lang="en">Facultative</rdfs:label>
    <rdfs:comment xml:lang="en">A permission under which a legal action is optional: the legal agent is permitted both to perform it and to omit it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#Permission"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#Privilege"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:notation>FAC</skos:notation>
    <skos:definition xml:lang="en">SDL: P(X) ∧ P(¬X), equivalently ¬O(¬X) ∧ ¬O(X) — X is neither forbidden nor obligatory. Hohfeld: the legal agent (A) holds two Privileges toward the counterparty (B), one concerning X and one concerning ¬X (a bilateral liberty), each with a correlative No-right held by B.</skos:definition>
    <skos:scopeNote xml:lang="en">Modelled as a subclass of norma:Permission because it is the conjunction of two permissions. It thereby inherits disjointness from norma:Obligation and norma:Prohibition, as SDL requires: P(¬X) contradicts O(X) and P(X) contradicts F(X).</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Recommendation">
    <rdfs:label xml:lang="en">Recommendation</rdfs:label>
    <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is recommended.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isDeonticallyEquivalentTo"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Recommendation"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#NegativeRecommendation"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:notation>REC</skos:notation>
    <skos:definition xml:lang="en">Performing X is recommended but not required. Recommendation is a non-binding operator outside the O/P/F core of SDL and confers no Hohfeldian legal position: omitting X breaches no duty and infringes no claim.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#NegativeRecommendation">
    <rdfs:label xml:lang="en">Negative Recommendation</rdfs:label>
    <rdfs:comment xml:lang="en">A regulative norm stating that a legal action is discouraged.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isDeonticallyEquivalentTo"/>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#Recommendation"/>
              <rdf:Description rdf:about="https://w3id.org/def/norma-o#NegativeRecommendation"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:notation>REC_NOT</skos:notation>
    <skos:definition xml:lang="en">Performing X is discouraged but not forbidden. By analogy with F(X) ≡ O(¬X), a Negative Recommendation of X is deontically equivalent to a Recommendation of ¬X. Like Recommendation, it confers no Hohfeldian legal position.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalPosition">
    <rdfs:label xml:lang="en">Legal Position</rdfs:label>
    <rdfs:comment xml:lang="en">A directed, first-order jural relation in Hohfeld's sense, held by one legal agent (the holder) against another (the counterparty) and concerning a legal action or its negation, as conferred by normative content. Reified following the W3C n-ary relation pattern so that holder, counterparty, action content, and correlative position can be stated explicitly.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#concernsLegalAction"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#hasPositionCounterparty"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#hasPositionHolder"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:seeAlso rdf:resource="https://doi.org/10.2307/785533"/>
    <skos:scopeNote xml:lang="en">Hohfeld's correlatives describe one and the same jural relation from the standpoint of each party: whenever A holds a position toward B concerning X, B necessarily holds the correlative position toward A concerning X. NORMA encodes this with norma:isCorrelativeOf (symmetric, functional, irreflexive) and two OWL 2 property chains that derive the counterparty and propagate the action content across correlatives. The square's other axis, between positions of the same party over negated contents, is norma:isJuralOppositeOf. The mapping from deontic operators is: O(X) ⇒ Duty(A→B, X) ⟷ Claim(B→A, X); F(X) ≡ O(¬X) ⇒ Duty(A→B, ¬X) ⟷ Claim(B→A, ¬X); P(X) ⇒ Privilege(A→B, X) ⟷ NoRight(B→A, X), where A is the norm's legal agent (norma:hasLegalAgent) and B its counterparty (norma:hasCounterparty). OWL reasoning cannot mint these positions, because minting requires creating individuals: they are materialised from the deontic closure by the derivation rule set, which needs only the norm's operator, action, agent and counterparty to be annotated. Once minted, the counterparty and the correlative's content follow by the property chains and need not be written. Only first-order positions are modelled; second-order positions (power, liability, immunity, disability) are out of scope.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">PRIMA FACIE, and not a conclusion about any case. A position is conferred by the norm AS ENACTED, so it is derived from the norm alone and never consults the norm’s status in a described situation: a norm that a case renders inapplicable — defeated by an exception, untriggered by the facts, or outside the system altogether — still confers its position here. “A bears a duty toward B concerning X” therefore reads as what the provision establishes, not as what A owes in a given case. Whether that duty bites is settled by evaluating the case, in the derivation module, and a consumer answering a compliance question must join the two.</skos:scopeNote>
    <dcterms:bibliographicCitation xml:lang="en">Hohfeld, W. N. (1913). Some Fundamental Legal Conceptions as Applied in Judicial Reasoning. The Yale Law Journal, 23(1), 16–59.</dcterms:bibliographicCitation>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Duty">
    <rdfs:label xml:lang="en">Duty</rdfs:label>
    <rdfs:comment xml:lang="en">A legal position in which the holder is bound, toward the counterparty, to realise the concerned action content: to perform the action, or to refrain from it when the content is a negated action.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isJuralOppositeOf"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/def/norma-o#Privilege"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isCorrelativeOf"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#Claim"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition xml:lang="en">Hohfeldian duty. Correlative: Claim. Jural opposite: Privilege — a Duty concerning X is the negation of a Privilege concerning ¬X, mirroring O(X) ≡ ¬P(¬X).</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Claim">
    <rdfs:label xml:lang="en">Claim</rdfs:label>
    <skos:altLabel xml:lang="en">Claim-right</skos:altLabel>
    <skos:altLabel xml:lang="en">Right</skos:altLabel>
    <rdfs:comment xml:lang="en">A legal position in which the holder is entitled, as against the counterparty, that the counterparty realise the concerned action content.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isJuralOppositeOf"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/def/norma-o#NoRight"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isCorrelativeOf"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#Duty"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition xml:lang="en">Hohfeldian right in the strict sense (claim). Correlative: Duty. Jural opposite: No-right.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Privilege">
    <rdfs:label xml:lang="en">Privilege</rdfs:label>
    <skos:altLabel xml:lang="en">Liberty</skos:altLabel>
    <rdfs:comment xml:lang="en">A legal position in which the holder is free, as against the counterparty, to realise the concerned action content, because the holder has no duty toward the counterparty to the contrary.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isJuralOppositeOf"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/def/norma-o#Duty"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isCorrelativeOf"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#NoRight"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition xml:lang="en">Hohfeldian privilege (liberty). Correlative: No-right. Jural opposite: Duty — a Privilege concerning X is the negation of a Duty concerning ¬X, mirroring P(X) ≡ ¬O(¬X).</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#NoRight">
    <rdfs:label xml:lang="en">No-right</rdfs:label>
    <rdfs:comment xml:lang="en">A legal position in which the holder has no claim, as against the counterparty, that the counterparty refrain from realising the concerned action content.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isJuralOppositeOf"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/def/norma-o#Claim"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#isCorrelativeOf"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#Privilege"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition xml:lang="en">Hohfeldian no-right. Correlative: Privilege. Jural opposite: Claim.</skos:definition>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#Defeater">
    <rdfs:label xml:lang="en">Defeater</rdfs:label>
    <rdfs:comment xml:lang="en">Reified defeat relation by which one piece of normative content withdraws or overrides the normative effect of another. Abstract superclass: use norma:ExceptionDefeater, norma:ConflictDefeater or norma:TemporalDefeater. Follows the same W3C n-ary relation pattern as norma:TriggerEvent.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#defeatedNorm"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#defeatingNorm"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/reasoning-defeasible/"/>
    <skos:scopeNote xml:lang="en">Defeasibility is a derived status rather than a class: a norm has a known defeater if and only if it is the norma:defeatedNorm of some Defeater. Under the open-world assumption the absence of a defeater does not entail that a norm is indefeasible; norms known to admit no defeat are marked with norma:hasNormStrength norma:Strict.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Defeat chains require the intermediate carve-out to be normative content: because norma:defeatedNorm ranges over norma:NormativeContent, an exception can itself be excepted only when it is stated as a norm — a norma:Permission where the source grants a liberty, a norma:ConstitutiveRule where it merely delimits the field of application. A defeater that names no defeating norm contributes no edge to norma:prevailsOver and cannot itself be defeated, so it is an incomplete annotation rather than a modelling option. The minimum cardinality on norma:defeatingNorm records that commitment but does not detect its breach, since under the open-world assumption an unnamed defeating norm is always assumed to exist; enforce it with SHACL.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Provenance: a Defeater is a prov:Entity, so use prov:wasAttributedTo and prov:wasGeneratedBy directly. Do not use norma:wasAttributedToAnnotator, whose domain is norma:NormativeContent: Defeater is disjoint from NormativeContent and such an assertion would make the graph inconsistent.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ExceptionDefeater">
    <rdfs:label xml:lang="en">Exception Defeater</rdfs:label>
    <rdfs:comment xml:lang="en">A defeater that switches off the applicability of the defeated norm under a condition, without asserting the opposite deontic status.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <skos:definition xml:lang="en">Undercutting defeat in Pollock's sense. In SDL terms, undercutting O(X) yields not-O(X) — a weak permission to omit X — and not F(X). In Hohfeld's terms the Duty conferred by the defeated norm is withdrawn together with its correlative Claim, leaving the agent at liberty. NORMA records that outcome as legal positions (norma:Privilege with its norma:NoRight), never by minting a new norma:Permission individual, which would assert an explicit legislative grant that the source text does not make.</skos:definition>
    <skos:scopeNote xml:lang="en">Several norma:appliesWhen gates on one defeater are read conjunctively, while alternative defeaters on the same defeated norm are read disjunctively. An exception that offers several alternative qualifying circumstances is therefore modelled as several ExceptionDefeaters.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ConflictDefeater">
    <rdfs:label xml:lang="en">Conflict Defeater</rdfs:label>
    <rdfs:comment xml:lang="en">A defeater in which the defeating norm asserts an opposing deontic status and prevails by a priority principle, which fixes the resulting status.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#hasResolutionPrinciple"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/def/norma-o#ResolutionPrinciple"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition xml:lang="en">Rebutting defeat in Pollock's sense. Presupposes a conflict detected at the deontic layer (norma:deonticallyConflictsWith, norma:deonticallyContradicts) and records the legal principle that resolves it.</skos:definition>
    <skos:scopeNote xml:lang="en">Neither presupposition is OWL-enforceable: that the two related norms are in conflict joins two roles of the same node, and the existential restriction on norma:hasResolutionPrinciple is satisfied in the open world by an unnamed principle, so a missing principle is not detected by a reasoner. Validate both with SHACL.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Two conflict defeaters relating the same pair of norms in opposite directions, each citing a different resolution principle, represent a second-degree conflict in Bobbio's sense rather than an annotation error: the criteria are genuinely unordered for that pair, and the direction of prevalence then depends on a policy that the ontology does not fix. norma:conflictPrevailsOver is deliberately left outside the asymmetric norma:directlyPrevailsOver so that such a pair remains representable, and consuming applications should report one prevalence ordering per admissible policy instead of silently choosing one. A pair asserted in opposite directions under the same principle is, by contrast, a contradiction in the annotation.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#TemporalDefeater">
    <rdfs:label xml:lang="en">Temporal Defeater</rdfs:label>
    <rdfs:comment xml:lang="en">A defeater in which a later norm withdraws an earlier one: repeal.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <skos:definition xml:lang="en">Derogation under lex posterior. Unlike an ExceptionDefeater it is total rather than case-conditional, and it concerns the validity of the defeated norm — its membership of the normative system — rather than its applicability to a particular case.</skos:definition>
    <skos:scopeNote xml:lang="en">Pairs with the norma:supersedes shortcut and the norma:Superseded lifecycle value. Because repeal bears on validity and not on applicability, consumers that stratify the defeat digraph should apply temporal defeat as a filter selecting the normative system in force at a given time, before building the case-specific graph, rather than as a step of that graph.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#FactPattern">
    <rdfs:label xml:lang="en">Fact Pattern</rdfs:label>
    <rdfs:comment xml:lang="en">A described case: the trigger events that fire in a concrete situation, that is, the legal conditions together with the outcomes they take, and the roles the parties involved occupy in it. An input to norm applicability, not a result of it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:scopeNote xml:lang="en">A FactPattern selects the active subgraph of activation and defeat relations for a case. The resulting applicability — which norms survive, at which level of the prevalence ordering, and which are reinstated — is deliberately not represented in the ontology: it follows from the described facts and the asserted defeaters, and publishing it as annotated fact would desynchronise it from the normative system from which it follows.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ResolutionPrinciple">
    <rdfs:label xml:lang="en">Resolution Principle</rdfs:label>
    <rdfs:comment xml:lang="en">A legal principle that orients the resolution of a conflict between norms.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:scopeNote xml:lang="en">Resolution principles may themselves conflict — lex specialis against lex posterior is the classic second-degree conflict — which is why norma:hasResolutionPrinciple is not functional and why the order in which principles are applied is a policy of the consuming application rather than an ontological truth.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#NormativeRank">
    <rdfs:label xml:lang="en">Normative Rank</rdfs:label>
    <rdfs:comment xml:lang="en">Rank of a legal source in the hierarchy of sources, from constitutional instruments down to organisational ones.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:scopeNote xml:lang="en">Distinct from norma:BindingForce: two hard-law norms may differ in rank. The integer norma:rankLevel makes lex superior computable by comparison within a single legal order; conflicts across legal orders, and questions of competence, are out of scope.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#NormStrength">
    <rdfs:label xml:lang="en">Norm Strength</rdfs:label>
    <rdfs:comment xml:lang="en">Whether a norm admits defeat at all.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:scopeNote xml:lang="en">Distinguishes strict norms, which no defeater may withdraw, from defeasible ones. Consumers should refuse to apply a defeater whose defeated norm is strict; OWL cannot enforce this because the constraint joins two roles of the same node.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#WeakPermission">
    <rdfs:label xml:lang="en">Weak Permission</rdfs:label>
    <rdfs:comment xml:lang="en">A derived, case-relative statement that a legal action is not forbidden for a legal agent under a described fact pattern. Reified following the W3C n-ary relation pattern, as norma:TriggerEvent, norma:LegalPosition and norma:Defeater are.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#inFactPattern"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#FactPattern"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#aboutAction"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#forAgent"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:seeAlso rdf:resource="https://w3id.org/def/norma-o/deriv"/>
    <skos:definition xml:lang="en">Weak permission in the sense of von Wright and of Alchourron and Bulygin: not-F(x) holding by absence of a prohibition, as opposed to strong permission, which is an enacted norma:Permission. A WeakPermission is therefore not a norm — it has no legal source and no text — and is disjoint from norma:NormativeContent.</skos:definition>
    <skos:scopeNote xml:lang="en">A prohibition whose own status is undecided BLOCKS the weak permission: the reading is sceptical, not credulous. If the fate of a prohibition is not fixed by the asserted defeaters, then it cannot be asserted that the action is not forbidden, and the honest result is the absence of a weak permission rather than one that a later resolution may withdraw. A credulous reading would also compound an optimism the conclusion already carries, since a weak permission is a closed-world conclusion to begin with.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Not monotonic, and not an entailment of the annotation graph on its own: it is computed under a closed-world reading of the described case, of the evaluated graph, or of both. Adding a norm, or adding a fact to the case, can withdraw it. Instances therefore belong only in a derived graph, carry prov:wasGeneratedBy toward the activity that produced them, and that activity must record the assumptions it relied on with normad:computedUnderAssumption from the NORMA-O Derivation module.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Relative to the agent and NOT to a counterparty, deliberately. This follows the Standard Deontic Logic reading, where the conclusion is that no norm of the system prohibits the action to that agent. It does not translate directly into a Hohfeldian position, which would be directed and would read as a liberty against a particular party: a norma:Privilege is conferred by an enacted norma:Permission, whereas a weak permission is the mere absence of a prohibition and so names no counterparty to hold the correlative norma:NoRight against.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalRole">
    <rdfs:label xml:lang="en">Legal Role</rdfs:label>
    <rdfs:comment xml:lang="en">An abstract addressee defined by a legal source: the capacity in which a party is bound, such as provider, deployer, importer or distributor. What norms name, as opposed to the party that happens to occupy it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <owl:disjointWith rdf:resource="https://w3id.org/def/norma-o#LegalParty"/>
    <skos:scopeNote xml:lang="en">A role is itself constituted by a norma:ConstitutiveRule — a legal definition — and so is part of the normative system rather than of the facts. Annotating the defining provision gives the role a source: article 3(3) of Regulation (EU) 2024/1689 defines the provider, article 3(8) defines the operator as a provider, product manufacturer, deployer, authorised representative, importer or distributor.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">NO SPECIALISATION RELATION between roles is asserted, and the omission is deliberate rather than an oversight. A hierarchy would only change a derivation where a norm addresses a supertype, and in Regulation (EU) 2024/1689 the substantive duties are addressed to the leaf roles while ‘operator’ serves as a scope and enforcement term: article 74 does not impose duties on operators but refers the word back to the scope of article 2(1). Adding the relation before a corpus exercises it would put untested structure in the ontology. Note also that co-specialisations do not join: a norm addressed to the provider does not reach the deployer merely because both are operators.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalParty">
    <rdfs:label xml:lang="en">Legal Party</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete natural or legal person, public authority, agency or body: the entity that occupies a role in a described case, as opposed to the role itself.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <skos:scopeNote xml:lang="en">Parties belong to cases, not to norms. A norm that names a party directly is possible — an individual decision, a sanction — but in general legislation addresses roles, and the link between the two is made per case with norma:RoleAssignment.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#RoleAssignment">
    <rdfs:label xml:lang="en">Role Assignment</rdfs:label>
    <rdfs:comment xml:lang="en">The fact that a given party occupies a given role. Reified following the W3C n-ary relation pattern, as norma:TriggerEvent, norma:LegalPosition, norma:Defeater and norma:WeakPermission are, because the relation is ternary: a party occupies a role IN A CASE.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#hasAssignedParty"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#LegalParty"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#hasAssignedRole"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#LegalRole"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:scopeNote xml:lang="en">ASSERTED, not derived, and this is the one place where the ontology departs from its own principle of deriving what is not generative. The reason is a GAP IN THE MODEL and not an impossibility, which is worth stating precisely. Judging the facts of a case is not the obstacle: a norma:FactPattern already asserts norma:holdsTrigger, and “a substantial modification was made” is as much a judgement about facts as “Acme made it”. The obstacle is that a norma:TriggerEvent records WHAT happened and not WHO did it, so although a constitutive rule names the role it confers (norma:confersRole) and the circumstances that bring it about (its own activation conditions), nothing in the graph connects those circumstances to a party. Were the trigger to carry the party that performed the conduct, a rule could mint the assignment; until then the annotator asserts it, cites the rule with norma:assignedUnderRule, and what the derivation computes is the REACH of each norm.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Because the assignment is asserted and never retracted, a case may hold one whose justifying rule turns out to be inapplicable there, whether untriggered by the facts or defeated. That is detectable without deriving anything, and a derivation reports it rather than presenting a reach that rests on a rule which does not apply.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Held by a norma:FactPattern, which thereby describes both what happened and in what capacity each party acted. An assignment asserted outside any fact pattern makes no claim about any case.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Reification is not optional: the same party occupies different roles in different cases, and one case may assign several roles to one party. A binary property from party to role would fix the assignment for all cases at once and could not represent the reclassification that a constitutive rule performs.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Why it must be case-relative, with the clearest example in current law: article 25(1) of Regulation (EU) 2024/1689 provides that a distributor, importer, deployer or other third party SHALL BE CONSIDERED TO BE A PROVIDER of a high-risk AI system where it puts its name on the system, makes a substantial modification, or modifies the intended purpose. That is Searle’s ‘X counts as Y in context C’ stated as positive law, and article 25(2) withdraws the role from the original provider in the same breath. The assignment therefore holds under circumstances, which a case-independent property could not express. It is NOT itself defeasible: norma:defeatedNorm ranges over norma:NormativeContent and a role assignment is disjoint from it, so no defeater can target one. What is defeasible is the constitutive rule that justifies the assignment, through norma:assignedUnderRule. Withdrawing that rule does not retract an assignment already asserted in a case, so the withdrawal of a role — article 25(2) of Regulation (EU) 2024/1689, which stops treating the original provider as a provider — is out of scope in this version.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalCondition">
    <rdfs:label xml:lang="en">Legal Condition</rdfs:label>
    <rdfs:comment xml:lang="en">A legally relevant condition, fact pattern, or decision criterion whose evaluated outcome determines whether normative content becomes applicable or is triggered. Branch-specific activation is represented using the n-ary TriggerEvent pattern via norma:hasTrigger.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#TriggerEvent">
    <rdfs:label xml:lang="en">Trigger Event</rdfs:label>
    <rdfs:comment xml:lang="en">Reified instance of the triggering relation between a legal condition, one evaluated condition outcome, and one activated normative content item. Represents true, false, and other branch-specific activations without using separate branch-label datatype properties. Follows Pattern 1 / Use Case 1 of the W3C Working Group Note Defining N-ary Relations on the Semantic Web.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#hasOutcome"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#ConditionOutcome"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/def/norma-o#activatesNorm"/>
        <owl:onClass rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalAction">
    <rdfs:label xml:lang="en">Legal Action</rdfs:label>
    <rdfs:comment xml:lang="en">A normalized legal action that is prescribed, prohibited, permitted, or recommended by a regulative norm. Consumers may work with the literal shortcut `norma:actionText` for low-ceremony use and mint LegalAction individuals only when the knowledge graph needs action-level reuse across norms.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/legal-action.owl#Legal_Action"/>
    <skos:scopeNote xml:lang="en">EVERY inference across norms joins on this class. The deontic closure, the equivalence and conflict relations, the Hohfeldian positions and the weak permission all compare norms through the action they regulate, so two annotators who mint separate individuals for one and the same conduct produce two unrelated islands and the derivation silently finds nothing — no equivalence, no conflict, no blocking of a weak permission. The ontology provides NO mechanism for aligning actions across annotators or regulations: assert owl:sameAs between them, or draw the individuals from a vocabulary of actions agreed beforehand. This is the main data-quality obligation a producer carries, and no reasoner can discharge it.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalObject">
    <rdfs:label xml:lang="en">Legal Object</rdfs:label>
    <rdfs:comment xml:lang="en">The entity, resource, person, document, system, content, or data item toward which the regulated action is directed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalAgent">
    <rdfs:label xml:lang="en">Legal Agent</rdfs:label>
    <rdfs:comment xml:lang="en">An entity that bears the legally relevant role of subject of a regulative norm: the party that is obliged, prohibited, permitted, or recommended to perform a legal action.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/legal-action.owl#Legal_Person"/>
    <skos:scopeNote xml:lang="en">Conceptually close to lkif-la:Legal_Person (Natural_Person, Private_Legal_Person, Public_Body). rdfs:seeAlso is used rather than rdfs:subClassOf because lkif-la:Legal_Person also covers Legislative_Body — entities that utter norms rather than bear them — which falls outside NORMA's LegalAgent role, and because lkif-core/legal-action.owl is not imported. foaf:Agent is intentionally not asserted as a TBox parent because it is broader than legal personhood (it includes software agents and other non-legal entities); FOAF classes remain available for instance-level annotation.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Deliberately left as the common parent of norma:LegalRole and norma:LegalParty rather than being split away, because a norm may be annotated as addressing either, and legacy annotations that commit to neither remain valid. Real legislation almost always addresses a role: in Regulation (EU) 2024/1689 the addressees are the provider, the deployer, the importer and so on, never a named undertaking. Which concrete party bears a norm is therefore a fact about a case, not about the norm, and is stated with norma:RoleAssignment.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#AnnotatorAgent">
    <rdfs:label xml:lang="en">Annotator Agent</rdfs:label>
    <rdfs:comment xml:lang="en">A provenance agent responsible for creating, reviewing, or attesting to a NORMA annotation. May represent a person (legal expert, analyst), a software system (LLM extractor, rule engine), or an organization. For finer-grained typing use the corresponding PROV-O subclasses (prov:Person, prov:SoftwareAgent, prov:Organization). Integrity constraint (not OWL-enforced): for a given NormativeContent, `prov:wasAttributedTo` and `prov:wasAssociatedWith` (via its generating AnnotationActivity) should resolve to the same agent; validate with SHACL.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalSource">
    <rdfs:label xml:lang="en">Legal Source</rdfs:label>
    <rdfs:comment xml:lang="en">A legal resource (in the ELI sense: a work-level identity) from which normative content is extracted, cited, or traced.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/norm.owl#Legal_Document"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
    <skos:scopeNote xml:lang="en">Conceptually related to lkif:Legal_Document. NORMA aligns formally to eli:LegalResource (the maintained W3C-adjacent legal-resource standard) rather than to lkif:Legal_Document, because lkif:Legal_Document is itself an expression:Medium subclass with restrictions on bears/utterer that are incompatible with NORMA's source-as-reference pattern. The LKIF reference is informative only.</skos:scopeNote>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#LegalSourceExpression">
    <rdfs:label xml:lang="en">Legal Source Expression</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete legal expression of a LegalSource: a specific language, consolidation, or published version of the underlying legal resource. Follows the ELI work/expression pattern: a LegalSource is realised by one or more LegalSourceExpressions via `norma:hasSourceExpression` (subproperty of `eli:is_realized_by`).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#AnnotationActivity">
    <rdfs:label xml:lang="en">Annotation Activity</rdfs:label>
    <rdfs:comment xml:lang="en">A provenance activity that produces a NORMA annotation (i.e. a NormativeContent) from one or more LegalSources.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#BindingForce">
    <rdfs:label xml:lang="en">Binding Force</rdfs:label>
    <rdfs:comment xml:lang="en">Binding force of a norm.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ComplianceCriticality">
    <rdfs:label xml:lang="en">Compliance Criticality</rdfs:label>
    <rdfs:comment xml:lang="en">Criticality level associated with non-compliance with a regulative norm.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ConditionOutcome">
    <rdfs:label xml:lang="en">Condition Outcome</rdfs:label>
    <rdfs:comment xml:lang="en">A controlled outcome value produced by evaluating a LegalCondition. It is modelled as an extensible SKOS concept class so binary branches, multi-way gateway branches, exception branches, and decision-table outcomes can all be represented consistently.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ExtractionMethod">
    <rdfs:label xml:lang="en">Extraction Method</rdfs:label>
    <rdfs:comment xml:lang="en">Method used to produce the annotation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#NormStatus">
    <rdfs:label xml:lang="en">Norm Status</rdfs:label>
    <rdfs:comment xml:lang="en">Lifecycle status of a normative content item.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/def/norma-o#ReviewStatus">
    <rdfs:label xml:lang="en">Review Status</rdfs:label>
    <rdfs:comment xml:lang="en">Legal review status of an annotation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>


  <!-- Object properties -->
  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#activatesNorm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">activates norm</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trigger event to the normative content it activates. Declared functional because each trigger event activates exactly one normative content item. Declared as a subproperty of rdf:value to mark the activated norm as the main value of the reified n-ary relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isActivatedByTriggerEvent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#generatedNormativeContent">
    <rdfs:label xml:lang="en">generated normative content</rdfs:label>
    <rdfs:comment xml:lang="en">Links an annotation activity to normative content that it generated.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#wasGeneratedByAnnotationActivity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasBindingForce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has binding force</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a regulative norm with exactly one binding-force value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#BindingForce"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isBindingForceOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasComplianceCriticality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has compliance criticality</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a regulative norm with exactly one compliance-criticality value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticality"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isComplianceCriticalityOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasExtractionMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has extraction method</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a normative content item with the method used to produce its annotation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#ExtractionMethod"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isExtractionMethodOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasLegalAction">
    <rdfs:label xml:lang="en">has legal action</rdfs:label>
    <rdfs:comment xml:lang="en">Links a regulative norm to the legal action it regulates. The producer may instead use the literal shortcut `norma:actionText`; both forms are permitted.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isLegalActionOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasLegalAgent">
    <rdfs:label xml:lang="en">has legal agent</rdfs:label>
    <rdfs:comment xml:lang="en">Links a regulative norm to its norm-bearing legal agent (the subject obliged, prohibited, permitted, or recommended).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isLegalAgentOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasLegalObject">
    <rdfs:label xml:lang="en">has legal object</rdfs:label>
    <rdfs:comment xml:lang="en">Links a regulative norm to the legal object of the action it regulates.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalObject"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isLegalObjectOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasLegalSource">
    <rdfs:label xml:lang="en">has legal source</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to the legal source (work-level resource) from which it is extracted.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isLegalSourceOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasNormStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has norm status</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a normative content item with exactly one lifecycle status.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormStatus"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isNormStatusOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has outcome</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trigger event to the condition outcome that characterises it, for example the true branch, false branch, or another controlled outcome. Declared functional because each trigger event has exactly one outcome.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#ConditionOutcome"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isOutcomeOfTriggerEvent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasReviewStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has review status</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a normative content item with one review status.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#ReviewStatus"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isReviewStatusOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasSourceExpression">
    <rdfs:label xml:lang="en">has source expression</rdfs:label>
    <rdfs:comment xml:lang="en">Links a LegalSource (ELI work-level) to a specific LegalSourceExpression (language, version, consolidation). Subproperty of `eli:is_realized_by` to preserve ELI semantics.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#is_realized_by"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalSourceExpression"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isSourceExpressionOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasTrigger">
    <rdfs:label xml:lang="en">has trigger</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal condition to one of its trigger events. A condition may have several trigger events, for example one trigger event for the true branch and one trigger event for the false branch.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalCondition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isTriggerOfCondition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isActivatedByTriggerEvent">
    <rdfs:label xml:lang="en">is activated by trigger event</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to a trigger event that activates it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#activatesNorm"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isAnnotatorOf">
    <rdfs:label xml:lang="en">is annotator of</rdfs:label>
    <rdfs:comment xml:lang="en">Links an annotator agent to normative content attributed to that annotator.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#AnnotatorAgent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#wasAttributedToAnnotator"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isBindingForceOf">
    <rdfs:label xml:lang="en">is binding force of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a binding-force value to regulative norms classified with that value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#BindingForce"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasBindingForce"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isComplianceCriticalityOf">
    <rdfs:label xml:lang="en">is compliance criticality of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a compliance-criticality value to regulative norms classified with that value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticality"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasComplianceCriticality"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isExtractionMethodOf">
    <rdfs:label xml:lang="en">is extraction method of</rdfs:label>
    <rdfs:comment xml:lang="en">Links an extraction method to normative content produced using that method.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#ExtractionMethod"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasExtractionMethod"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isLegalActionOf">
    <rdfs:label xml:lang="en">is legal action of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal action to the regulative norm that regulates it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasLegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isLegalAgentOf">
    <rdfs:label xml:lang="en">is legal agent of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal agent to the regulative norm for which it is the norm-bearing subject.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasLegalAgent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isLegalObjectOf">
    <rdfs:label xml:lang="en">is legal object of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal object to the regulative norm in which it is regulated.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalObject"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasLegalObject"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isLegalSourceOf">
    <rdfs:label xml:lang="en">is legal source of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal source to normative content extracted or derived from it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasLegalSource"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isNormStatusOf">
    <rdfs:label xml:lang="en">is norm status of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a norm-status value to normative content carrying that lifecycle status.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormStatus"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasNormStatus"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isOutcomeOfTriggerEvent">
    <rdfs:label xml:lang="en">is outcome of trigger event</rdfs:label>
    <rdfs:comment xml:lang="en">Links a condition outcome to trigger events characterised by that outcome.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#ConditionOutcome"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasOutcome"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isReviewStatusOf">
    <rdfs:label xml:lang="en">is review status of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a review-status value to normative content carrying that status.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#ReviewStatus"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasReviewStatus"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isSourceExpressionOf">
    <rdfs:label xml:lang="en">is source expression of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal source expression to the legal source it realizes or expresses.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSourceExpression"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasSourceExpression"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isSourceForDerivedNormativeContent">
    <rdfs:label xml:lang="en">is source for derived normative content</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal source to normative content derived from it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#wasDerivedFromSource"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isTriggerOfCondition">
    <rdfs:label xml:lang="en">is trigger of condition</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trigger event back to the legal condition whose branch or outcome it represents.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalCondition"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasTrigger"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isTriggeredByCondition">
    <rdfs:label xml:lang="en">is triggered by condition</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to the legal condition that triggers it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalCondition"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#triggersNorm"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#relatesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="en">relates to</rdfs:label>
    <rdfs:comment xml:lang="en">Generic symmetric association between two normative content items (e.g. cross-references, thematic links). Prefer more specific properties when available.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#supersededBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">superseded by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a superseded normative content item to the single item that replaces it. Pairs with the `norma:Superseded` NormStatus value. (Note: declared FunctionalProperty; relax this if your domain allows a norm to be split across multiple successors.)</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#supersedes"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#supersedes">
    <rdfs:label xml:lang="en">supersedes</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to an earlier normative content item that it replaces.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#directlyPrevailsOver"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#temporalPrevailsOver"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#supersededBy"/>
    <skos:scopeNote xml:lang="en">Supersession is the low-ceremony form of temporal defeat, so it feeds the prevalence digraph through norma:temporalPrevailsOver. Mint a norma:TemporalDefeater instead when the repeal needs its own condition, provenance, or several defeated norms.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#triggersNorm">
    <rdfs:label xml:lang="en">triggers norm</rdfs:label>
    <rdfs:comment xml:lang="en">Shortcut: links a legal condition to a normative content item whenever the condition has a trigger event that activates that norm. Implemented as the OWL 2 property chain hasTrigger ∘ activatesNorm. The outcome branch is not recoverable from this shortcut alone; clients that need the true, false, or other branch outcome must traverse the reified TriggerEvent node.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalCondition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isTriggeredByCondition"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#hasTrigger"/>
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#activatesNorm"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#usedLegalSource">
    <rdfs:label xml:lang="en">used legal source</rdfs:label>
    <rdfs:comment xml:lang="en">Links an annotation activity to the legal source it used as input.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#wasUsedByAnnotationActivity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#wasAnnotatorAssociatedWithActivity">
    <rdfs:label xml:lang="en">was annotator associated with activity</rdfs:label>
    <rdfs:comment xml:lang="en">Links an annotator agent to an annotation activity with which the agent was associated.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#AnnotatorAgent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#wasAssociatedWithAnnotator"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#wasAssociatedWithAnnotator">
    <rdfs:label xml:lang="en">was associated with annotator</rdfs:label>
    <rdfs:comment xml:lang="en">Links an annotation activity to the annotator agent that performed it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#AnnotatorAgent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#wasAnnotatorAssociatedWithActivity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#wasAttributedToAnnotator">
    <rdfs:label xml:lang="en">was attributed to annotator</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to the annotator agent responsible for it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#AnnotatorAgent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isAnnotatorOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#wasDerivedFromSource">
    <rdfs:label xml:lang="en">was derived from source</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to the legal source from which it was derived (entity-to-entity derivation shortcut).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isSourceForDerivedNormativeContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#wasGeneratedByAnnotationActivity">
    <rdfs:label xml:lang="en">was generated by annotation activity</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to the annotation activity that generated it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#generatedNormativeContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#wasUsedByAnnotationActivity">
    <rdfs:label xml:lang="en">was used by annotation activity</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal source to the annotation activity that used it as input.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#usedLegalSource"/>
  </owl:ObjectProperty>


  <!-- Deontic-logic (SDL) and Hohfeldian legal-position object properties -->
  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isNegationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">is negation of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal action X to the legal action ¬X that consists in not performing X, and vice versa. Provides the action-level negation that Standard Deontic Logic needs to state F(X) ≡ O(¬X) and P(X) ≡ ¬O(¬X). Symmetric because ¬¬X ≡ X; functional because an action has a single negation (two actions declared as negations of the same action are inferred to be the same action); irreflexive because no action is its own negation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isDeonticallyEquivalentTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">is deontically equivalent to</rdfs:label>
    <rdfs:comment xml:lang="en">Links two regulative norms that express the same deontic content for the same legal agent, counterparty, and circumstances under the interdefinability of deontic operators, even when annotated with different operators: e.g. a Prohibition of X and an Obligation of ¬X (F(X) ≡ O(¬X)), or a Negative Recommendation of X and a Recommendation of ¬X. Symmetric and transitive. Class-level restrictions on the RegulativeNorm subclasses keep equivalences within compatible operator families, so asserting, for instance, that an Obligation is equivalent to a Permission makes the knowledge graph inconsistent.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#relatesTo"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <skos:scopeNote xml:lang="en">An unannotated counterparty is treated as not disagreeing rather than as a mismatch. This is a declared reading, not a neutral one: it lets equivalences surface in corpora where the counterparty is not yet annotated, at the cost of asserting an equivalence that a later annotation may refute. Producers that annotate norma:hasCounterparty throughout get the strict reading for free.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Circumstances are compared as the set of (norma:LegalCondition, outcome) pairs activating each norm, not as trigger-event identity: a producer that mints one norma:TriggerEvent per norm would otherwise never find two norms equivalent. Two norms with the same content but different activating conditions are not equivalent, which is why the comparison cannot be dropped.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Derived, never annotated. Given the closure, the general join replaces the operator-by-operator rule above: two norms are equivalent when they share the legal agent, do not disagree on the counterparty, are activated in the same circumstances, and their CLOSURES COINCIDE term by term. Set equality is what makes the test sound — a Permission and a Facultative over the same action share norma:entailsPermitted, so a join on a single shared entailment would wrongly equate them, while the facultative additionally entails P(¬X) and ¬O(X).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">PRIMA FACIE, like the Hohfeldian positions and for the same reason: the relation holds between the norms AS ENACTED and does not consult their status in any case. Two norms stay equivalent even where an exception defeats one of them, and a conflict stays recorded even where the facts of a case activate only one side. Realising or dissolving either in a particular situation is the business of the case evaluation.</skos:scopeNote>
    <skos:example xml:lang="en">SWRL derivation: norma:Prohibition(?n1) ^ norma:hasLegalAction(?n1, ?x) ^ norma:Obligation(?n2) ^ norma:hasLegalAction(?n2, ?y) ^ norma:isNegationOf(?x, ?y) ^ norma:hasLegalAgent(?n1, ?a) ^ norma:hasLegalAgent(?n2, ?a) -&gt; norma:isDeonticallyEquivalentTo(?n1, ?n2), additionally requiring the same counterparty, legal object, and triggering conditions where these are annotated.</skos:example>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#deonticallyConflictsWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">deontically conflicts with</rdfs:label>
    <rdfs:comment xml:lang="en">Links two regulative norms that cannot both hold for the same legal agent, counterparty, and circumstances under Standard Deontic Logic. Covers contradictory pairs (see norma:deonticallyContradicts) and contrary pairs, which cannot both hold but may both fail to hold, such as an Obligation of X and a Prohibition of X (O(X) and O(¬X), jointly inconsistent under axiom D). Intended to support norm-conflict detection.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#relatesTo"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <skos:scopeNote xml:lang="en">Conflict is detected BETWEEN ROLES, not between parties. Both this relation and norma:WeakPermission compare the norma:hasLegalAgent of two norms, which in real legislation is a norma:LegalRole, so a clash between the duties of two roles that one and the same norma:LegalParty occupies in a case is NOT detected — and article 25(1) of Regulation (EU) 2024/1689, under which a deployer comes to count as a provider as well, is exactly that situation. Projecting the comparison onto parties is future work.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Derived, never annotated. Contradictory pairs come from norma:deonticallyContradicts and are entailed through the subproperty axiom. Contrary pairs are a separate join over the closure: one norm entails norma:entailsObligatory of an action and the other norma:entailsForbidden of that same action, for the same legal agent, without disagreeing on the counterparty, without activation conditions that cannot hold together, and with both ends outside the norma:Permission subtree.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Irreflexive: no norm conflicts with itself. A derived conflict is a finding about the normative system, not an inconsistency in the graph — real legal corpora contain antinomies, and resolving them is the business of the defeasibility layer, not of the reasoner.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#deonticallyContradicts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">deontically contradicts</rdfs:label>
    <rdfs:comment xml:lang="en">Links two regulative norms whose deontic contents are the negation of each other, so that exactly one of them holds: a Permission of X and a Prohibition of X (P(X) ≡ ¬F(X)), or a Permission of ¬X and an Obligation of X (P(¬X) ≡ ¬O(X)). In Hohfeld's terms, the Privilege conferred by the permission is the jural opposite of the Duty conferred by the other norm.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#deonticallyConflictsWith"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <skos:scopeNote xml:lang="en">Circumstances cannot be dropped from the comparison. Two norms activated by OPPOSITE branches of one norma:LegalCondition never meet in any case, so reporting them as in conflict is a false positive, and the derivation excludes that pair. What remains is a POTENTIAL conflict: this property has no slot for a case, so whether the conflict is realised — both norms valid, activated and undefeated in a described norma:FactPattern — is settled by evaluating that case, not by this relation.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Derived, never annotated. Given the closure, the join is: one norm entails norma:entailsPermitted of an action and the other norma:entailsNotPermitted of that same action, for the same legal agent, without disagreeing on the counterparty, and without activation conditions that cannot hold together.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Irreflexive: no norm contradicts itself. The Hohfeldian face of this relation is norma:isJuralOppositeOf holding between positions conferred by the two norms.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The derivation must start from the PERMISSION side, and the class-level restrictions are what force this. Axiom D gives an Obligation of X the entailment P(X), so a join taken in either direction would also fire between an Obligation and a Prohibition of the same action — a CONTRARY pair, which can fail together and therefore does not belong here. Worse, emitting it would be inconsistent: norma:Obligation is restricted to contradict only norma:Permission, so the prohibition would be typed as a Permission, and the two classes are disjoint. Restricting one end to the norma:Permission subtree distinguishes a norm’s own deontic content from what merely follows by D; contraries are recorded with the superproperty norma:deonticallyConflictsWith.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasCounterparty">
    <rdfs:label xml:lang="en">has counterparty</rdfs:label>
    <rdfs:comment xml:lang="en">Links a regulative norm to the legal agent in relation to whom the norm-bearing legal agent is bound or free: the holder of the correlative Claim of an Obligation or Prohibition, or of the correlative No-right of a Permission. Together with norma:hasLegalAgent it makes both ends of the Hohfeldian relation explicit at norm level.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isCounterpartyOf"/>
    <skos:scopeNote xml:lang="en">When the legal text names no beneficiary, as is common in public-law regulation, the counterparty is typically the competent public authority or the class of persons the norm protects; mint a LegalAgent for it rather than leaving the relation implicit.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isCounterpartyOf">
    <rdfs:label xml:lang="en">is counterparty of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal agent to a regulative norm for which it is the counterparty.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasCounterparty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#confersLegalPosition">
    <rdfs:label xml:lang="en">confers legal position</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to a Hohfeldian legal position it creates. A binding regulative norm confers a pair of correlative positions: an Obligation or Prohibition confers a Duty and its Claim, a Permission a Privilege and its No-right. The domain is NormativeContent rather than RegulativeNorm so that second-order positions conferred by constitutive rules can be added by future extensions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isLegalPositionConferredBy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isLegalPositionConferredBy">
    <rdfs:label xml:lang="en">is legal position conferred by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal position to the normative content that confers it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#confersLegalPosition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasPositionHolder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has position holder</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal position to the single legal agent who holds it (A in &quot;A has a duty toward B&quot;).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isPositionHolderOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isPositionHolderOf">
    <rdfs:label xml:lang="en">is position holder of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal agent to a legal position it holds.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasPositionHolder"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasPositionCounterparty">
    <rdfs:label xml:lang="en">has position counterparty</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal position to the legal agent against whom it is held (B in &quot;A has a duty toward B&quot;). Implemented with the OWL 2 property chain isCorrelativeOf ∘ hasPositionHolder, which encodes Hohfeld's correlativity: the counterparty of a position is the holder of its correlative. Because it is defined by a property chain, the property is non-simple in OWL 2 DL and cannot be declared functional; validate the uniqueness of the counterparty with SHACL.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isPositionCounterpartyOf"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#isCorrelativeOf"/>
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#hasPositionHolder"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isPositionCounterpartyOf">
    <rdfs:label xml:lang="en">is position counterparty of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal agent to a legal position held against it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasPositionCounterparty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#concernsLegalAction">
    <rdfs:label xml:lang="en">concerns legal action</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal position to the legal action that forms its content. The action is always one to be realised by the party who is bound or free: the holder of a Duty or Privilege, and the counterparty of a Claim or No-right. For positions conferred by a Prohibition, the content is the negated action (see norma:isNegationOf). Implemented with the OWL 2 property chain isCorrelativeOf ∘ concernsLegalAction, so that correlative positions share the same content, as Hohfeld's correlativity requires.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isContentOfLegalPosition"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#isCorrelativeOf"/>
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#concernsLegalAction"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isContentOfLegalPosition">
    <rdfs:label xml:lang="en">is content of legal position</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal action to a legal position whose content it forms.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#concernsLegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isCorrelativeOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">is correlative of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal position to its Hohfeldian correlative: the position necessarily held by the counterparty toward the holder concerning the same action (Duty ⟷ Claim, Privilege ⟷ No-right). Symmetric because correlativity is mutual, functional because each position has exactly one correlative, and irreflexive because no position is its own correlative. It drives the property chains of norma:hasPositionCounterparty and norma:concernsLegalAction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isJuralOppositeOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">is jural opposite of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal position to its Hohfeldian jural opposite: the position held by the SAME agent TOWARD THE SAME COUNTERPARTY whose content is the negation of this one's, so that exactly one of the two obtains (Duty ⟷ Privilege, Claim ⟷ No-right). A Duty of A toward B concerning X is the opposite of a Privilege of A toward B concerning ¬X, mirroring O(X) ≡ ¬P(¬X). Symmetric because opposition is mutual, and irreflexive because no position is its own opposite.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalPosition"/>
    <skos:scopeNote xml:lang="en">Deliberately NOT functional, unlike norma:isCorrelativeOf. A position has exactly one correlative, minted with it by the same norm, but its opposite may be conferred by several different norms at once, and in a conflicting normative system it may be conferred by none. Deliberately NOT transitive either: the opposite of the opposite is the position itself, so transitivity would make every position its own opposite and contradict irreflexivity.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Derived, never annotated. The join is: same norma:hasPositionHolder, same counterparty, contents related by norma:isNegationOf, and classes drawn from one axis of the square. The counterparty is compared on the CONFERRING NORMS, through norma:hasCounterparty, because the position's own norma:hasPositionCounterparty follows from a property chain and is not materialised. Because each position is conferred by a norm, deriving an opposition between positions conferred by two DIFFERENT norms is the Hohfeldian face of norma:deonticallyContradicts specifically, and not of its superproperty: a CONTRARY pair confers two Duties, never a Duty and its opposite, so contraries have no Hohfeldian face at all. Under the subproperty axiom the pair is also in norma:deonticallyConflictsWith, which is what a query over the derived graph will find. The two are NOT independent evidence of a conflict, and must not be presented as such: both are computed from the same deontic closure, so their agreement is an internal coherence check on the two joins — worth running, since either can be written wrongly — and not a second confirmation of the conflict itself. Independent evidence would have to come from outside the closure, such as from the legal text.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">THE COUNTERPARTY MUST BE COMPARED, because legal positions are directed. What the comparison does with silence is a separate decision: a counterparty that no annotator named is read as NOT DISAGREEING rather than as a mismatch, which lets oppositions surface in corpora where the counterparty is not yet annotated, at the cost of an opposition that a later annotation may refute. That reading is non-monotonic and a derivation that adopts it records normad:OpenCounterparty. One agent may bear a Duty toward B concerning X and at the same time hold a Privilege against C concerning ¬X, and those are two distinct jural relations rather than an opposition — Hohfeld's own multital analysis. Comparing holders alone would collapse them and report a contradiction where none exists.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The second axis of Hohfeld's square, and the counterpart of norma:isCorrelativeOf. The two must not be confused: a correlative is the same jural relation seen from the other party, concerning the same action, whereas an opposite is held by the same party toward the same party and concerns the negated action. Correlativity therefore swaps holder and counterparty, while opposition preserves both and negates the content.</skos:scopeNote>
  </owl:ObjectProperty>


  <!-- Defeasibility object properties: defeat, prevalence, normative rank, and cases -->
  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#defeatedNorm">
    <rdfs:label xml:lang="en">defeated norm</rdfs:label>
    <rdfs:comment xml:lang="en">Links a defeater to the normative content whose normative effect it withdraws. Deliberately not functional, because a single repeal may withdraw a block of norms; enforce the cardinality your domain requires with SHACL.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isDefeatedBy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isDefeatedBy">
    <rdfs:label xml:lang="en">is defeated by</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to a defeater that withdraws its normative effect.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#defeatedNorm"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#defeatingNorm">
    <rdfs:label xml:lang="en">defeating norm</rdfs:label>
    <rdfs:comment xml:lang="en">Links a defeater to the normative content that performs the overriding. Required in practice: a defeater that names none contributes no edge to norma:prevailsOver, so the defeat it records stays invisible in the flat prevalence digraph and cannot itself be defeated. Where the source expresses a carve-out without granting a liberty, state it as a norma:ConstitutiveRule rather than leaving this property empty.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isDefeatingNormOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isDefeatingNormOf">
    <rdfs:label xml:lang="en">is defeating norm of</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to a defeater in which it performs the overriding.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#defeatingNorm"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#appliesWhen">
    <rdfs:label xml:lang="en">applies when</rdfs:label>
    <rdfs:comment xml:lang="en">Links a defeater to a trigger event that activates it. The range is norma:TriggerEvent rather than norma:ConditionOutcome so that the gate identifies both the legal condition and the branch it takes: an outcome value on its own is shared by every condition in the graph and therefore identifies nothing.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isGateOfDefeater"/>
    <skos:scopeNote xml:lang="en">For the same reason a defeater whose defeating norm is invalid — repealed, or carrying a lifecycle status that excludes it — withdraws nothing. The defeated norm then simply remains applicable: it never lost its own validity, which is the same principle that bars a repealed repealing norm from reviving what it repealed.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The condition of an exception may be annotated in two places, and a consumer must read them in CONJUNCTION. This property gates the defeat relation: it says when the defeater reaches the defeated norm. The activation of the defeating norm, through norma:activatesNorm, says whether that norm is operative in the case at all. A norm the case does not trigger is not operative and therefore defeats nothing, however its defeater is gated — so an evaluation that honoured only this property would let an untriggered exception withdraw its rule. Requiring both lets an annotator state the condition in either place and still get the right answer, and where the two differ it yields their conjunction, which is the conservative reading.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isGateOfDefeater">
    <rdfs:label xml:lang="en">is gate of defeater</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trigger event to a defeater it activates.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#Defeater"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#appliesWhen"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasResolutionPrinciple">
    <rdfs:label xml:lang="en">has resolution principle</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a conflict defeater with the legal principle that orients it. Not functional: lex specialis and lex posterior may be invoked together, and they may point in opposite directions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#ConflictDefeater"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#ResolutionPrinciple"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isResolutionPrincipleOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isResolutionPrincipleOf">
    <rdfs:label xml:lang="en">is resolution principle of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resolution principle to conflict defeaters it orients.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#ResolutionPrinciple"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#ConflictDefeater"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasResolutionPrinciple"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#prevailsOver">
    <rdfs:label xml:lang="en">prevails over</rdfs:label>
    <rdfs:comment xml:lang="en">Shortcut: links defeating normative content to the normative content it defeats, whenever a defeater relates the two. Implemented as the OWL 2 property chain isDefeatingNormOf composed with defeatedNorm, in the same way as norma:triggersNorm. Two things are lost in the flattening, and only one of them is recoverable: the kind of defeat, which clients retrieve by traversing the reified Defeater node or by using the typed subproperties, and the gate norma:appliesWhen, which has no shortcut at all. This property is therefore the UNGATED projection of the defeat digraph — the static ordering over the whole normative system. Case-relative evaluation must traverse the reified Defeater, never this shortcut, or every defeater would count as applicable in every case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isPrevailedOverBy"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#isDefeatingNormOf"/>
      <rdf:Description rdf:about="https://w3id.org/def/norma-o#defeatedNorm"/>
    </owl:propertyChainAxiom>
    <skos:scopeNote xml:lang="en">Annotators assert Defeaters and, where convenient, the shortcuts norma:isExceptionTo and norma:supersedes. The annotation graph never carries norma:prevailsOver, its typed subproperties, prevalence levels, or defeat status: these are consequences of what has been asserted. A compilation step may materialise them, together with the stratification, in a separate derived artefact that is regenerated rather than maintained by hand — the same arrangement as the generated SWRL rule file. Materialising them back into the annotation graph would desynchronise them from the normative system from which they follow.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Transitivity is deliberately not declared, for two independent reasons. Technically, a property defined by a property chain is non-simple in OWL 2 DL and cannot also be asymmetric or irreflexive. Substantively, defeat is not transitive: if A defeats B and B defeats C, then C is reinstated, because B is itself withdrawn, and a transitive closure asserting that A defeats C would destroy precisely the reinstatement that consumers must compute.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isPrevailedOverBy">
    <rdfs:label xml:lang="en">is prevailed over by</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to normative content that prevails over it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#prevailsOver"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#directlyPrevailsOver">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label xml:lang="en">directly prevails over</rdfs:label>
    <rdfs:comment xml:lang="en">Superproperty of the asserted prevalence shortcuts. Declared asymmetric and irreflexive so that no norm prevails over itself and two norms cannot each be asserted to prevail directly over the other.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#prevailsOver"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <skos:scopeNote xml:lang="en">A deliberately partial guard: it catches self-loops and two-cycles among asserted shortcuts only. Full acyclicity of the defeat digraph is not expressible in OWL 2 DL and must be checked by the consuming application, where a cycle signals an antinomy to be resolved by a norma:ResolutionPrinciple or reported as irresoluble.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#exceptionPrevailsOver">
    <rdfs:label xml:lang="en">exception prevails over</rdfs:label>
    <rdfs:comment xml:lang="en">Typed prevalence edge for undercutting defeat, so that the kind of defeat survives the flattening of the reified Defeater into the norm-to-norm digraph. It is entailed wherever the norma:isExceptionTo shortcut is used, and materialised by the compilation step in the derived artefact for defeat stated through a reified norma:ExceptionDefeater; annotators never assert it directly.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#prevailsOver"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#conflictPrevailsOver">
    <rdfs:label xml:lang="en">conflict prevails over</rdfs:label>
    <rdfs:comment xml:lang="en">Typed prevalence edge for rebutting defeat resolved by a priority principle. Materialised by the compilation step in the derived artefact and never asserted by annotators: rebutting defeat always goes through a reified norma:ConflictDefeater, which carries the resolution principle.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#prevailsOver"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#temporalPrevailsOver">
    <rdfs:label xml:lang="en">temporal prevails over</rdfs:label>
    <rdfs:comment xml:lang="en">Typed prevalence edge for repeal. It is entailed wherever the norma:supersedes shortcut is used, and materialised by the compilation step for repeal stated through a reified norma:TemporalDefeater. Consumers apply it as a validity filter over the normative system rather than as a step of the case-specific prevalence ordering.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#prevailsOver"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isExceptionTo">
    <rdfs:label xml:lang="en">is exception to</rdfs:label>
    <rdfs:comment xml:lang="en">Low-ceremony shortcut stating that the subject norm is a carve-out from the object norm, without reifying a Defeater. Mint a norma:ExceptionDefeater instead when the carve-out needs a condition, a principle, or provenance of its own.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#directlyPrevailsOver"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/norma-o#exceptionPrevailsOver"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has rank</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a legal source with exactly one rank in the hierarchy of sources. Rank is a property of the source rather than of the individual norm; norms carry the denormalised copy norma:fromRank.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isRankOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isRankOf">
    <rdfs:label xml:lang="en">is rank of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a normative rank to the legal sources classified with it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasRank"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#fromRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">from rank</rdfs:label>
    <rdfs:comment xml:lang="en">Denormalised normative rank copied from the norm's legal source, in the same way as norma:fromRegulation and norma:fromArticle. A property chain over hasLegalSource and hasRank is deliberately not used, because it would make the property non-simple and therefore unable to be functional.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasNormStrength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has norm strength</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a normative content item with exactly one strength value, stating whether it admits defeat.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormStrength"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isNormStrengthOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isNormStrengthOf">
    <rdfs:label xml:lang="en">is norm strength of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a strength value to normative content classified with it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormStrength"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasNormStrength"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasAssignedParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has assigned party</rdfs:label>
    <rdfs:comment xml:lang="en">Links a role assignment to the single party that occupies the role.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalParty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isAssignedPartyOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isAssignedPartyOf">
    <rdfs:label xml:lang="en">is assigned party of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a party to the role assignments that place it in a role.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalParty"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasAssignedParty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#hasAssignedRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has assigned role</rdfs:label>
    <rdfs:comment xml:lang="en">Links a role assignment to the single role the party occupies.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalRole"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isAssignedRoleOf"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isAssignedRoleOf">
    <rdfs:label xml:lang="en">is assigned role of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a role to the role assignments that place a party in it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalRole"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#hasAssignedRole"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#holdsRoleAssignment">
    <rdfs:label xml:lang="en">holds role assignment</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fact pattern to a role assignment that holds in it: who acted, and in what capacity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#FactPattern"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isRoleAssignmentIn"/>
    <skos:scopeNote xml:lang="en">Together with norma:holdsTrigger this completes the description of a case: the triggers say what happened, the role assignments say in what capacity each party acted. A norm addressed to a role reaches, in that case, the parties the case places in that role; the reach itself is a consequence and belongs in a derived artefact, not here.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isRoleAssignmentIn">
    <rdfs:label xml:lang="en">is role assignment in</rdfs:label>
    <rdfs:comment xml:lang="en">Links a role assignment to the fact patterns in which it holds.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#FactPattern"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#holdsRoleAssignment"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#assignedUnderRule">
    <rdfs:label xml:lang="en">assigned under rule</rdfs:label>
    <rdfs:comment xml:lang="en">Links a role assignment to the normative content that justifies it: the constitutive rule under which this party counts as occupying this role in this case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isRuleOfRoleAssignment"/>
    <skos:scopeNote xml:lang="en">Not required by an axiom. An assignment may record a party’s original capacity, which no reclassifying rule confers and which the facts of the case simply state; it is the reclassified ones that need the citation. Enforce it where a corpus demands it with SHACL.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Without it an assignment is a bare assertion with no legal basis, which defeats the purpose of an ontology built for source traceability: a consumer asking why a party counts as a provider must be able to reach article 25(1) rather than take the annotator’s word for it. It also makes the assignment auditable against the rule, since the rule names the role it confers with norma:confersRole and the circumstances with its own activation conditions.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isRuleOfRoleAssignment">
    <rdfs:label xml:lang="en">is rule of role assignment</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to the role assignments it justifies.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#RoleAssignment"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#assignedUnderRule"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#establishesTrigger">
    <rdfs:label xml:lang="en">establishes trigger</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to a trigger event that HOLDS whenever that content applies: the institutional fact the content brings about. On a norma:ConstitutiveRule this is its counts-as conclusion expressed as a fact of the case, so that regulative norms conditioned on that fact become activated by it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isTriggerEstablishedBy"/>
    <skos:scopeNote xml:lang="en">Evaluation therefore ALTERNATES: the institutional facts established by the constitutive rules that apply are added to the case, and the regulative norms are evaluated against the case so augmented, until no new fact appears. The classic counts-as problem (Searle; Jones and Sergot). Because the set of established facts only grows, the alternation terminates; but a fact may gate a defeater that withdraws the very rule that established it, and a consumer must be told when that happened rather than shown a conclusion that quietly rests on it.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">This is what chains constitutive rules to regulative ones, and without it the two layers never meet. norma:confersRole covers the counts-as that attributes a ROLE; this covers the counts-as that establishes a FACT. Article 6(2) of Regulation (EU) 2024/1689 is the case that demands it: systems listed in Annex III count as high-risk, and the obligations of Articles 16 and 26 are conditioned on being high-risk rather than on being listed.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Why it cannot be replaced by annotating the fact in the norma:FactPattern: a fact asserted in the case is brute and no defeater can touch it, whereas an institutional fact is DEFEASIBLE. Article 6(3) withdraws the classification of Article 6(2), and the final subparagraph withdraws that withdrawal, so whether the system counts as high-risk is the outcome of evaluating a defeat chain. A regulative norm wired directly to the defeated rule would skip a rung: everything else depending on the same classification by another path would stay undefeated.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isTriggerEstablishedBy">
    <rdfs:label xml:lang="en">is trigger established by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trigger event to the normative content whose application establishes it as a fact of the case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#establishesTrigger"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#confersRole">
    <rdfs:label xml:lang="en">confers role</rdfs:label>
    <rdfs:comment xml:lang="en">Links normative content to a legal role it attributes. On a norma:ConstitutiveRule this is the rule’s constitutive effect: the role that the parties satisfying its circumstances come to occupy.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalRole"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isRoleConferredBy"/>
    <skos:scopeNote xml:lang="en">This is what gives norma:ConstitutiveRule a formal consequence instead of only a text. A definitional provision that constitutes a role, and a reclassifying provision such as article 25(1) of Regulation (UE) 2024/1689, both state which role results; the circumstances under which it results are the rule’s own activation conditions, through norma:activatesNorm, so a reclassification that the case does not trigger confers nothing.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Whether a particular party comes to occupy the role is not stated here. The rule says which role follows; norma:RoleAssignment in a norma:FactPattern says who occupies it in a case. Keeping the two apart is what lets one rule serve every case.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isRoleConferredBy">
    <rdfs:label xml:lang="en">is role conferred by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a legal role to the normative content that attributes it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalRole"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#confersRole"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#holdsTrigger">
    <rdfs:label xml:lang="en">holds trigger</rdfs:label>
    <rdfs:comment xml:lang="en">Links a fact pattern to a trigger event that fires in it, that is, to a legal condition together with the outcome it takes in the described case. The trigger events a fact pattern holds select the active subgraph of activation and defeat relations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#FactPattern"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#isHeldInFactPattern"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#isHeldInFactPattern">
    <rdfs:label xml:lang="en">is held in fact pattern</rdfs:label>
    <rdfs:comment xml:lang="en">Links a trigger event to fact patterns in which it fires.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#TriggerEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#FactPattern"/>
    <owl:inverseOf rdf:resource="https://w3id.org/def/norma-o#holdsTrigger"/>
  </owl:ObjectProperty>


  <!-- Deontic closure and weak permission object properties -->
  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsObligatory">
    <rdfs:label xml:lang="en">entails obligatory</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is obligatory, O(x).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <owl:propertyDisjointWith rdf:resource="https://w3id.org/def/norma-o#entailsNotObligatory"/>
    <skos:scopeNote xml:lang="en">Both members of each equivalent pair are materialised — F(x) alongside not-P(x) — so that queries succeed without reasoning; under reasoning they are the same relation.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Derived, never annotated. The closure is materialised by a rule set rather than entailed by OWL, because the equivalences that flip the action — F(x) equivalent to O(not-x), and P(x) to not-O(not-x) — would need property chains over norma:isNegationOf in both directions. That violates the regularity condition of OWL 2 DL, since it would require entailsObligatory to precede entailsForbidden and entailsForbidden to precede entailsObligatory at once, and it would make the properties non-simple, so they could no longer be declared disjoint. Only the two equivalences that keep the same action are asserted as axioms.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The eight norma:entails... properties make the Standard Deontic Logic closure of an annotated norm explicit, so that it can be queried without a reasoner. They are scoped to a single norm: each says what that norm implies about the action for its own legal agent, toward its own counterparty and under its own conditions — not what status the action holds in the normative system as a whole, which other norms may settle differently. Two norms entailing opposite statuses for the same action is a norm conflict, to be recorded with norma:deonticallyConflictsWith, and not an inconsistency.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsNotObligatory">
    <rdfs:label xml:lang="en">entails not obligatory</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is not obligatory, not-O(x). Follows from a prohibition of the action, or from a permission of its negation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsPermitted">
    <rdfs:label xml:lang="en">entails permitted</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is permitted, P(x). Equivalent to entailing that the action is not forbidden, and implied by an obligation of the action through the SDL axiom D.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <owl:equivalentProperty rdf:resource="https://w3id.org/def/norma-o#entailsNotForbidden"/>
    <owl:propertyDisjointWith rdf:resource="https://w3id.org/def/norma-o#entailsNotPermitted"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsNotPermitted">
    <rdfs:label xml:lang="en">entails not permitted</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is not permitted, not-P(x). Equivalent to entailing that the action is forbidden.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <owl:equivalentProperty rdf:resource="https://w3id.org/def/norma-o#entailsForbidden"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsForbidden">
    <rdfs:label xml:lang="en">entails forbidden</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is forbidden, F(x), equivalently that its negation is obligatory, O(not-x).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsNotForbidden">
    <rdfs:label xml:lang="en">entails not forbidden</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is not forbidden, not-F(x). Equivalent to entailing that the action is permitted.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsRecommended">
    <rdfs:label xml:lang="en">entails recommended</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is recommended.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
    <skos:scopeNote xml:lang="en">The recommendation operators receive no analogue of the SDL axiom D: nothing of the form Rec(x) implies not-Rec(not-x) is generated, because a non-binding operator licenses no such inference. Only the action-flipping analogy holds, so a recommendation of x entails that not-x is discouraged.</skos:scopeNote>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#entailsDiscouraged">
    <rdfs:label xml:lang="en">entails discouraged</rdfs:label>
    <rdfs:comment xml:lang="en">Derived: the regulative norm entails that the legal action is discouraged.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#aboutAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">about action</rdfs:label>
    <rdfs:comment xml:lang="en">Links a weak permission to the single legal action it concerns.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#WeakPermission"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#forAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">for agent</rdfs:label>
    <rdfs:comment xml:lang="en">Links a weak permission to the single legal agent for whom the action is not forbidden.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#WeakPermission"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#LegalAgent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://w3id.org/def/norma-o#inFactPattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">in fact pattern</rdfs:label>
    <rdfs:comment xml:lang="en">Links a weak permission to the single described case relative to which it was computed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#WeakPermission"/>
    <rdfs:range rdf:resource="https://w3id.org/def/norma-o#FactPattern"/>
  </owl:ObjectProperty>


  <!-- Datatype properties -->
  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#actionText">
    <rdfs:label xml:lang="en">action text</rdfs:label>
    <rdfs:comment xml:lang="en">Raw textual form of the regulated action as entered in the annotation template.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:scopeNote xml:lang="en">A LOW-CEREMONY SHORTCUT, and the derivation does not read it. The same holds for norma:agentText, norma:objectText, norma:conditionTrigger and the norma:from… literals: they record what the text said without committing to an individual, which is useful while annotating and useless for inference. A norm that carries only norma:actionText and no norma:hasLegalAction falls OUT of the deontic closure, confers no Hohfeldian position and blocks no weak permission. Mint the individuals as soon as the graph has to reason across norms.</skos:scopeNote>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#agentText">
    <rdfs:label xml:lang="en">agent text</rdfs:label>
    <rdfs:comment xml:lang="en">Raw textual form of the legal agent as entered in the annotation template.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#annotationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">annotation date</rdfs:label>
    <rdfs:comment xml:lang="en">Date on which the annotation activity took place. Convenience shortcut; for instant-level precision use `prov:startedAtTime`/`prov:endedAtTime` from PROV-O (both are valid on prov:Activity, unlike prov:generatedAtTime which is defined on prov:Entity).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#articleNumber">
    <rdfs:label xml:lang="en">article number</rdfs:label>
    <rdfs:comment xml:lang="en">Article, section, or equivalent unit number. Not functional: a single LegalSource may cover multiple articles.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#conditionStatement">
    <rdfs:label xml:lang="en">condition statement</rdfs:label>
    <rdfs:comment xml:lang="en">Plain-language formulation of the legal condition being evaluated. In the NORMA toolkit it is taken from the label of the annotated condition, but the property itself is independent of any authoring tool.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#conditionTrigger">
    <rdfs:label xml:lang="en">condition trigger</rdfs:label>
    <rdfs:comment xml:lang="en">Raw textual description of the condition under which the norm applies.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#confidenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">confidence score</rdfs:label>
    <rdfs:comment xml:lang="en">Confidence score the annotation activity assigned to its output, constrained to the closed interval [0,1]. Placed on the activity rather than the annotation entity to attribute uncertainty to the extraction process; downstream consumers traverse `prov:wasGeneratedBy` to reach it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#AnnotationActivity"/>
    <rdfs:range>
      <rdfs:Datatype>
        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <owl:withRestrictions rdf:parseType="Collection">
          <rdf:Description>
            <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
          </rdf:Description>
          <rdf:Description>
            <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</xsd:maxInclusive>
          </rdf:Description>
        </owl:withRestrictions>
      </rdfs:Datatype>
    </rdfs:range>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#deadline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">deadline</rdfs:label>
    <rdfs:comment xml:lang="en">Deadline, sunset date, end date, or textual temporal constraint associated with the normative content.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#deonticId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">deontic ID</rdfs:label>
    <rdfs:comment xml:lang="en">Unique identifier for a norm or constitutive rule within a regulation pack. Any stable local identifier is acceptable; the NORMA toolkit composes one from the modality notation and a slug of the annotated element label (e.g. OBL_Mark_AI_generated_content). Uniqueness is a producer invariant, not an OWL one; to enforce global uniqueness across graphs, declare InverseFunctionalProperty or add a SHACL uniqueness constraint.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#effectiveDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">effective date</rdfs:label>
    <rdfs:comment xml:lang="en">Date from which the normative content is effective.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#exception">
    <rdfs:label xml:lang="en">exception</rdfs:label>
    <rdfs:comment xml:lang="en">Exception or carve-out under which the norm does not apply.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:scopeNote xml:lang="en">Deprecated in favour of the defeasibility layer: use norma:ExceptionDefeater, or the norma:isExceptionTo shortcut, so that the carve-out carries its condition, its provenance, and a place in the prevalence digraph. Retained for backwards compatibility with published graphs and as a last-resort literal for carve-outs that have not yet been analysed.</skos:scopeNote>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#factStatement">
    <rdfs:label xml:lang="en">fact statement</rdfs:label>
    <rdfs:comment xml:lang="en">Plain-language statement of the constitutive rule.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#ConstitutiveRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#fromArticle">
    <rdfs:label xml:lang="en">from article</rdfs:label>
    <rdfs:comment xml:lang="en">Denormalised article identifier copied from the linked LegalSource.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#fromParagraph">
    <rdfs:label xml:lang="en">from paragraph</rdfs:label>
    <rdfs:comment xml:lang="en">Denormalised paragraph identifier copied from the linked LegalSource.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#fromRegulation">
    <rdfs:label xml:lang="en">from regulation</rdfs:label>
    <rdfs:comment xml:lang="en">Denormalised regulation name copied from the linked LegalSource for convenient querying and SWRL rule generation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#lastReviewDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">last review date</rdfs:label>
    <rdfs:comment xml:lang="en">Date of the most recent legal or editorial review of this annotation. A lifecycle property of the norm itself, not of the activity that created it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#normStatement">
    <rdfs:label xml:lang="en">norm statement</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable restatement of the norm or rule.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#objectText">
    <rdfs:label xml:lang="en">object text</rdfs:label>
    <rdfs:comment xml:lang="en">Raw textual form of the legal object as entered in the annotation template.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#originalText">
    <rdfs:label xml:lang="en">original text</rdfs:label>
    <rdfs:comment xml:lang="en">Verbatim legal text from the legal source.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#paragraphNumber">
    <rdfs:label xml:lang="en">paragraph number</rdfs:label>
    <rdfs:comment xml:lang="en">Paragraph, subsection, or equivalent granular locator. Not functional.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#rankLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">rank level</rdfs:label>
    <rdfs:comment xml:lang="en">Integer ordinal attached to a normative rank so that lex superior is computable by comparison. A higher level prevails over a lower one.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#regulationName">
    <rdfs:label xml:lang="en">regulation name</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the legal or regulatory source.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#regulationURI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">regulation URI</rdfs:label>
    <rdfs:comment xml:lang="en">URI identifying the legal source.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#LegalSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#sanction">
    <rdfs:label xml:lang="en">sanction</rdfs:label>
    <rdfs:comment xml:lang="en">Sanction or consequence associated with non-compliance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#RegulativeNorm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:scopeNote xml:lang="en">A literal, and deliberately nothing more: the VIOLATION of a norm is out of scope in this version. What a breach brings about — a compensatory obligation, a contrary-to-duty conditional of the form ‘if O(x) is violated then O(y)’ — is a central feature of defeasible deontic logics and is not represented here at all. A consumer can read the sanction text; nothing can compute with it, and no derivation rule consults it.</skos:scopeNote>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://w3id.org/def/norma-o#sourceURI">
    <rdfs:label xml:lang="en">source URI</rdfs:label>
    <rdfs:comment xml:lang="en">Denormalised URI copied from the linked LegalSource.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <rdfs:domain rdf:resource="https://w3id.org/def/norma-o#NormativeContent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>


  <!-- Controlled vocabulary schemes -->
  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#BindingForceScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">SKOS concept scheme grouping binding-force values used by NORMA regulative norms.</skos:definition>
    <skos:prefLabel xml:lang="en">Binding force scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Contractual"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#HardLaw"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#InternalPolicy"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#SoftLaw"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#ComplianceCriticalityScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">SKOS concept scheme grouping compliance criticality values used by NORMA regulative norms.</skos:definition>
    <skos:prefLabel xml:lang="en">Compliance criticality scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Critical"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#High"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Low"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Medium"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#ConditionOutcomeScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">Extensible SKOS scheme grouping condition outcome values used by NORMA trigger events.</skos:definition>
    <skos:prefLabel xml:lang="en">Condition outcome scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#FalseOutcome"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#TrueOutcome"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#ExtractionMethodScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">SKOS concept scheme grouping annotation extraction method values used by NORMA.</skos:definition>
    <skos:prefLabel xml:lang="en">Extraction method scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#LLMExtraction"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#ManualAnalyst"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#ManualLawyer"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#PatternMatching"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#RuleBased"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#NormStatusScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">SKOS concept scheme grouping lifecycle status values used by NORMA normative content.</skos:definition>
    <skos:prefLabel xml:lang="en">Norm status scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Active"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Disputed"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#NotYetInForce"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Superseded"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#NormStrengthScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">SKOS concept scheme grouping the norm strength values used by NORMA normative content.</skos:definition>
    <skos:prefLabel xml:lang="en">Norm strength scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Defeasible"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Strict"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#NormativeRankScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">Extensible SKOS concept scheme grouping the normative rank values used by NORMA legal sources. Extend it for jurisdictions whose hierarchy of sources needs finer distinctions.</skos:definition>
    <skos:prefLabel xml:lang="en">Normative rank scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#ConstitutionalRank"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#DelegatedRank"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#LegislativeRank"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#OrganisationalRank"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#RegulatoryRank"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#ResolutionPrincipleScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">SKOS concept scheme grouping the conflict resolution principles used by NORMA conflict defeaters.</skos:definition>
    <skos:prefLabel xml:lang="en">Resolution principle scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#LexPosterior"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#LexSpecialis"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#LexSuperior"/>
  </skos:ConceptScheme>

  <skos:ConceptScheme rdf:about="https://w3id.org/def/norma-o#ReviewStatusScheme">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/def/norma-o"/>
    <skos:definition xml:lang="en">SKOS concept scheme grouping review status values used by NORMA annotations.</skos:definition>
    <skos:prefLabel xml:lang="en">Review status scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#Approved"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#NotReviewed"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#PendingReview"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/def/norma-o#UnderReview"/>
  </skos:ConceptScheme>


  <!-- Controlled vocabulary individuals -->
  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Active">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormStatus"/>
    <rdfs:label xml:lang="en">Active</rdfs:label>
    <rdfs:comment xml:lang="en">Currently in force or active.</rdfs:comment>
    <skos:notation>ACTIVE</skos:notation>
    <skos:prefLabel xml:lang="en">Active</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#NotYetInForce">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormStatus"/>
    <rdfs:label xml:lang="en">Not Yet In Force</rdfs:label>
    <rdfs:comment xml:lang="en">Published or known but not yet effective.</rdfs:comment>
    <skos:notation>NOT_YET_IN_FORCE</skos:notation>
    <skos:prefLabel xml:lang="en">Not Yet In Force</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Superseded">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormStatus"/>
    <rdfs:label xml:lang="en">Superseded</rdfs:label>
    <rdfs:comment xml:lang="en">Replaced by another norm.</rdfs:comment>
    <skos:notation>SUPERSEDED</skos:notation>
    <skos:prefLabel xml:lang="en">Superseded</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#NotReviewed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ReviewStatus"/>
    <rdfs:label xml:lang="en">Not Reviewed</rdfs:label>
    <rdfs:comment xml:lang="en">Review status indicating that the normative content has not yet been reviewed.</rdfs:comment>
    <skos:notation>NOT_REVIEWED</skos:notation>
    <skos:prefLabel xml:lang="en">Not Reviewed</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#PendingReview">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ReviewStatus"/>
    <rdfs:label xml:lang="en">Pending Review</rdfs:label>
    <rdfs:comment xml:lang="en">Review status indicating that the annotation is waiting for review.</rdfs:comment>
    <skos:notation>PENDING_REVIEW</skos:notation>
    <skos:prefLabel xml:lang="en">Pending Review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#UnderReview">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ReviewStatus"/>
    <rdfs:label xml:lang="en">Under Review</rdfs:label>
    <rdfs:comment xml:lang="en">Review status indicating that the annotation is currently under legal, editorial, or analytical review.</rdfs:comment>
    <skos:notation>UNDER_REVIEW</skos:notation>
    <skos:prefLabel xml:lang="en">Under Review</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Moved from norma:NormStatus to norma:ReviewStatus in version 2.0. Reviewing an annotation does not change whether the norm itself is in force, so the value belongs to the review lifecycle of the annotation — between norma:PendingReview and norma:Approved — and not to the lifecycle of the normative content. Consumers of version 1.0 graphs that used it as a norm status should remap it.</skos:scopeNote>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Approved">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ReviewStatus"/>
    <rdfs:label xml:lang="en">Approved</rdfs:label>
    <rdfs:comment xml:lang="en">Review status indicating that the annotation has been validated and accepted.</rdfs:comment>
    <skos:notation>APPROVED</skos:notation>
    <skos:prefLabel xml:lang="en">Approved</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ReviewStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Disputed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormStatus"/>
    <rdfs:label xml:lang="en">Disputed</rdfs:label>
    <rdfs:comment xml:lang="en">Legally or interpretively disputed.</rdfs:comment>
    <skos:notation>DISPUTED</skos:notation>
    <skos:prefLabel xml:lang="en">Disputed</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormStatusScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#TrueOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ConditionOutcome"/>
    <rdfs:label xml:lang="en">True Outcome</rdfs:label>
    <rdfs:comment xml:lang="en">Condition outcome indicating that the condition holds, corresponding to a true or yes branch.</rdfs:comment>
    <skos:notation>TRUE</skos:notation>
    <skos:prefLabel xml:lang="en">True outcome</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ConditionOutcomeScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ConditionOutcomeScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#FalseOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ConditionOutcome"/>
    <rdfs:label xml:lang="en">False Outcome</rdfs:label>
    <rdfs:comment xml:lang="en">Condition outcome indicating that the condition does not hold, corresponding to a false or no branch.</rdfs:comment>
    <skos:notation>FALSE</skos:notation>
    <skos:prefLabel xml:lang="en">False outcome</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ConditionOutcomeScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ConditionOutcomeScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#HardLaw">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#BindingForce"/>
    <rdfs:label xml:lang="en">Hard Law</rdfs:label>
    <rdfs:comment xml:lang="en">Binding force category for legally binding instruments such as statutes, regulations, or enforceable legal acts.</rdfs:comment>
    <skos:notation>HARD_LAW</skos:notation>
    <skos:prefLabel xml:lang="en">Hard Law</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#SoftLaw">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#BindingForce"/>
    <rdfs:label xml:lang="en">Soft Law</rdfs:label>
    <rdfs:comment xml:lang="en">Binding force category for non-binding guidance, recommendations, codes of conduct, or policy instruments.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.estrellaproject.org/lkif-core/norm.owl#Soft_Law"/>
    <skos:notation>SOFT_LAW</skos:notation>
    <skos:prefLabel xml:lang="en">Soft Law</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Contractual">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#BindingForce"/>
    <rdfs:label xml:lang="en">Contractual</rdfs:label>
    <rdfs:comment xml:lang="en">Binding force category for obligations, permissions, or constraints arising from a contract or agreement.</rdfs:comment>
    <skos:notation>CONTRACTUAL</skos:notation>
    <skos:prefLabel xml:lang="en">Contractual</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#InternalPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#BindingForce"/>
    <rdfs:label xml:lang="en">Internal Policy</rdfs:label>
    <rdfs:comment xml:lang="en">Binding force category for internal organizational policies, procedures, or governance rules.</rdfs:comment>
    <skos:notation>INTERNAL_POLICY</skos:notation>
    <skos:prefLabel xml:lang="en">Internal Policy</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#BindingForceScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Critical">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticality"/>
    <rdfs:label xml:lang="en">Critical</rdfs:label>
    <rdfs:comment xml:lang="en">Compliance criticality level indicating that non-compliance may cause severe legal, financial, operational, or safety consequences.</rdfs:comment>
    <skos:notation>CRITICAL</skos:notation>
    <skos:prefLabel xml:lang="en">Critical</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#High">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticality"/>
    <rdfs:label xml:lang="en">High</rdfs:label>
    <rdfs:comment xml:lang="en">Compliance criticality level indicating a high level of legal, operational, or business risk in case of non-compliance.</rdfs:comment>
    <skos:notation>HIGH</skos:notation>
    <skos:prefLabel xml:lang="en">High</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Medium">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticality"/>
    <rdfs:label xml:lang="en">Medium</rdfs:label>
    <rdfs:comment xml:lang="en">Compliance criticality level indicating moderate compliance risk or impact.</rdfs:comment>
    <skos:notation>MEDIUM</skos:notation>
    <skos:prefLabel xml:lang="en">Medium</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Low">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticality"/>
    <rdfs:label xml:lang="en">Low</rdfs:label>
    <rdfs:comment xml:lang="en">Compliance criticality level indicating limited compliance risk or impact.</rdfs:comment>
    <skos:notation>LOW</skos:notation>
    <skos:prefLabel xml:lang="en">Low</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ComplianceCriticalityScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#LLMExtraction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ExtractionMethod"/>
    <rdfs:label xml:lang="en">LLM extraction</rdfs:label>
    <rdfs:comment xml:lang="en">Extraction method indicating that the annotation was produced using a large language model.</rdfs:comment>
    <skos:notation>LLM_EXTRACTION</skos:notation>
    <skos:prefLabel xml:lang="en">LLM extraction</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#RuleBased">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ExtractionMethod"/>
    <rdfs:label xml:lang="en">Rule-based extraction</rdfs:label>
    <rdfs:comment xml:lang="en">Extraction method indicating that the annotation was produced by deterministic rules.</rdfs:comment>
    <skos:notation>RULE_BASED</skos:notation>
    <skos:prefLabel xml:lang="en">Rule-based extraction</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#PatternMatching">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ExtractionMethod"/>
    <rdfs:label xml:lang="en">Pattern matching</rdfs:label>
    <rdfs:comment xml:lang="en">Extraction method indicating that annotation content was produced by matching textual or structural patterns.</rdfs:comment>
    <skos:notation>PATTERN_MATCHING</skos:notation>
    <skos:prefLabel xml:lang="en">Pattern matching</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#ManualAnalyst">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ExtractionMethod"/>
    <rdfs:label xml:lang="en">Manual annotation (analyst)</rdfs:label>
    <rdfs:comment xml:lang="en">Extraction method indicating that the annotation was created manually by a non-lawyer analyst.</rdfs:comment>
    <skos:notation>MANUAL_ANALYST</skos:notation>
    <skos:prefLabel xml:lang="en">Manual annotation (analyst)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#ManualLawyer">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ExtractionMethod"/>
    <rdfs:label xml:lang="en">Manual annotation (lawyer)</rdfs:label>
    <rdfs:comment xml:lang="en">Extraction method indicating that the annotation was created manually by a legal expert.</rdfs:comment>
    <skos:notation>MANUAL_LAWYER</skos:notation>
    <skos:prefLabel xml:lang="en">Manual annotation (lawyer)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ExtractionMethodScheme"/>
  </owl:NamedIndividual>


  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#LexSuperior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ResolutionPrinciple"/>
    <rdfs:label xml:lang="en">Lex superior</rdfs:label>
    <rdfs:comment xml:lang="en">Resolution principle giving precedence to the norm of higher rank in the hierarchy of sources.</rdfs:comment>
    <skos:notation>LEX_SUPERIOR</skos:notation>
    <skos:prefLabel xml:lang="en">Lex superior</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ResolutionPrincipleScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ResolutionPrincipleScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#LexSpecialis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ResolutionPrinciple"/>
    <rdfs:label xml:lang="en">Lex specialis</rdfs:label>
    <rdfs:comment xml:lang="en">Resolution principle giving precedence to the more specific norm over the more general one.</rdfs:comment>
    <skos:notation>LEX_SPECIALIS</skos:notation>
    <skos:prefLabel xml:lang="en">Lex specialis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ResolutionPrincipleScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ResolutionPrincipleScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#LexPosterior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#ResolutionPrinciple"/>
    <rdfs:label xml:lang="en">Lex posterior</rdfs:label>
    <rdfs:comment xml:lang="en">Resolution principle giving precedence to the later norm over the earlier one.</rdfs:comment>
    <skos:notation>LEX_POSTERIOR</skos:notation>
    <skos:prefLabel xml:lang="en">Lex posterior</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#ResolutionPrincipleScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#ResolutionPrincipleScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#ConstitutionalRank">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <rdfs:label xml:lang="en">Constitutional</rdfs:label>
    <rdfs:comment xml:lang="en">Rank of constitutional or founding instruments, including treaties where these head the legal order.</rdfs:comment>
    <norma:rankLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</norma:rankLevel>
    <skos:notation>CONSTITUTIONAL</skos:notation>
    <skos:prefLabel xml:lang="en">Constitutional</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#LegislativeRank">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <rdfs:label xml:lang="en">Legislative</rdfs:label>
    <rdfs:comment xml:lang="en">Rank of primary legislation: statutes, regulations, and equivalent legislative acts.</rdfs:comment>
    <norma:rankLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</norma:rankLevel>
    <skos:notation>LEGISLATIVE</skos:notation>
    <skos:prefLabel xml:lang="en">Legislative</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#RegulatoryRank">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <rdfs:label xml:lang="en">Regulatory</rdfs:label>
    <rdfs:comment xml:lang="en">Rank of secondary or implementing instruments issued under primary legislation.</rdfs:comment>
    <norma:rankLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</norma:rankLevel>
    <skos:notation>REGULATORY</skos:notation>
    <skos:prefLabel xml:lang="en">Regulatory</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#DelegatedRank">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <rdfs:label xml:lang="en">Delegated</rdfs:label>
    <rdfs:comment xml:lang="en">Rank of delegated acts, technical annexes, and equivalent instruments issued under a specific delegation.</rdfs:comment>
    <norma:rankLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</norma:rankLevel>
    <skos:notation>DELEGATED</skos:notation>
    <skos:prefLabel xml:lang="en">Delegated</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#OrganisationalRank">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormativeRank"/>
    <rdfs:label xml:lang="en">Organisational</rdfs:label>
    <rdfs:comment xml:lang="en">Rank of internal organisational instruments, which yield to every external source.</rdfs:comment>
    <norma:rankLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</norma:rankLevel>
    <skos:notation>ORGANISATIONAL</skos:notation>
    <skos:prefLabel xml:lang="en">Organisational</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormativeRankScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Strict">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormStrength"/>
    <rdfs:label xml:lang="en">Strict</rdfs:label>
    <rdfs:comment xml:lang="en">Strength value for a norm that admits no defeat, such as a peremptory or constitutional-core norm.</rdfs:comment>
    <skos:notation>STRICT</skos:notation>
    <skos:prefLabel xml:lang="en">Strict</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormStrengthScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormStrengthScheme"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://w3id.org/def/norma-o#Defeasible">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/def/norma-o#NormStrength"/>
    <rdfs:label xml:lang="en">Defeasible</rdfs:label>
    <rdfs:comment xml:lang="en">Strength value for a norm that may be withdrawn by an applicable defeater. The default reading when no strength is stated.</rdfs:comment>
    <skos:notation>DEFEASIBLE</skos:notation>
    <skos:prefLabel xml:lang="en">Defeasible</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/def/norma-o#NormStrengthScheme"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/def/norma-o#NormStrengthScheme"/>
  </owl:NamedIndividual>

