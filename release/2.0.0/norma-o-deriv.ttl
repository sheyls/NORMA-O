# Namespace: https://w3id.org/def/norma-o/deriv#
#
# NORMA-O Derivation module. Companion to https://w3id.org/def/norma-o.
#
# Scope: this module says nothing about law. It records *how* a derived graph
# was produced and *under which assumptions*, so that materialised conclusions
# — deontic closure, weak permissions, prevalence orderings — can be published
# without being mistaken for annotated fact, and can be reproduced.
#
# The legal-theoretical vocabulary itself stays in norma-o: a term belongs to
# the core ontology when it is part of the conceptual model, whether it is
# asserted by an annotator or derived by a reasoner or a rule set.

@prefix normad: <https://w3id.org/def/norma-o/deriv#> .
@prefix bibo:   <http://purl.org/ontology/bibo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix norma:  <https://w3id.org/def/norma-o#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Ontology metadata
# =============================================================================

<https://w3id.org/def/norma-o/deriv> a owl:Ontology ;
    rdfs:label "NORMA-O Derivation module"@en ;
    dcterms:title "NORMA-O Derivation: provenance and assumptions of derived normative conclusions"@en ;
    dcterms:description "A companion module to the NORMA ontology for describing derived normative graphs: the activity that materialised them, the rule set and its version, and — crucially — the non-monotonic assumptions under which the conclusions hold. NORMA-O states what norms mean and how they defeat one another; this module states under what reading a particular set of conclusions was computed, so that a published derived graph is reproducible and cannot be mistaken for annotated fact."@en ;
    dcterms:creator [ a foaf:Person ;
            foaf:name "Sheyla Leyva-Sánchez" ] ;
    dcterms:contributor [ a foaf:Person ;
            foaf:name "María Poveda-Villalón" ],
        [ a foaf:Person ;
            foaf:name "Víctor Rodríguez-Doncel" ] ;
    dcterms:bibliographicCitation "Leyva-Sánchez, S. et al. (2026). NORMA-O Derivation module (Version 1.0) [Ontology]. https://w3id.org/def/norma-o/deriv/1.0"@en ;
    dcterms:issued "2026-11-09"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-09"^^xsd:date ;
    dcterms:publisher [ a foaf:Organization ;
            foaf:name "NORMA project" ] ;
    dcterms:source <https://github.com/sheyls/NORMA-O> ;
    vann:preferredNamespacePrefix "normad" ;
    vann:preferredNamespaceUri "https://w3id.org/def/norma-o/deriv#" ;
    bibo:doi "10.5281/zenodo.24116269" ;
    bibo:status "Published"@en ;
    rdfs:comment "Companion module to NORMA-O 2.0 that describes derived normative graphs: the derivation activity, the rule set and version applied, the assumptions the conclusions depend on, and the prevalence orderings, norm evaluations and cycles they contain."@en ;
    rdfs:seeAlso <https://w3id.org/def/norma-o> ;
    owl:imports <https://w3id.org/def/norma-o>,
        <http://www.w3.org/ns/prov-o> ;
    owl:versionIRI <https://w3id.org/def/norma-o/deriv/1.0> ;
    owl:versionInfo "1.0" ;
    foaf:logo <https://raw.githubusercontent.com/sheyls/NORMA-O/main/release/2.0.0/norma-o-deriv-v1.svg> ;
    schema:includedInDataCatalog <https://zenodo.org/communities/norma> .

# =============================================================================
# Classes
# =============================================================================

normad:DerivationActivity a owl:Class ;
    rdfs:label "Derivation Activity"@en ;
    rdfs:comment "A provenance activity that materialises normative conclusions from a NORMA annotation graph: deontic closure, weak permissions, typed prevalence edges, or a prevalence ordering."@en ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:subClassOf prov:Activity,
        [ a owl:Restriction ;
            owl:onProperty normad:computedUnderAssumption ;
            owl:onClass normad:Assumption ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:scopeNote "Distinct from norma:AnnotationActivity, which produces annotations from legal sources. A DerivationActivity consumes an annotation graph and produces consequences of it; its output is regenerated rather than maintained, and must never be merged back into the annotation graph. Use prov:used for the input graph, prov:startedAtTime for the run, and normad:ruleSetVersion for the rule set that was applied."@en ;
    skos:scopeNote "At least one assumption must be recorded. A derived graph with no stated assumptions is not interpretable: the same annotation graph yields different conclusions under different readings of silence, of defeat, and of graph completeness."@en .

normad:Assumption a owl:Class ;
    rdfs:label "Assumption"@en ;
    rdfs:comment "A non-monotonic reading adopted by a derivation activity, without which its conclusions do not follow."@en ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:subClassOf skos:Concept ;
    skos:scopeNote "Extensible: add further assumptions as new derivation layers are defined. Each value names something the annotation graph does not state and the derivation nevertheless relies on."@en,
        "Some values are mutually exclusive — a closed and an open reading of the case, or defeat considered and not considered — but that exclusion constrains the set of values one activity may carry, which OWL cannot express: it is a constraint on the values of normad:computedUnderAssumption for a single subject. Validate it with SHACL."@en .

normad:PrevalenceOrdering a owl:Class ;
    rdfs:label "Prevalence Ordering"@en ;
    rdfs:comment "A computed stratification of a defeat digraph: the “ladder” obtained by flattening the asserted defeaters into prevalence edges and ordering the nodes topologically."@en ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:subClassOf prov:Entity ;
    skos:scopeNote "NORMA-O deliberately represents no prevalence level and no defeat status: norma:FactPattern states that the resulting applicability follows from the described facts and the asserted defeaters, and norma:prevailsOver states that a compilation step may materialise the stratification in a separate derived artefact. This class is that artefact’s root, which is why it lives in the module and not in the core ontology."@en,
        "Without normad:forFactPattern the ordering is the STATIC one over the whole normative system, computed on the ungated projection of the defeat digraph; with it, the ordering is case-relative and only the defeaters whose gate fires in that case contribute edges. The two are different graphs and must not be mixed: norma:prevailsOver is the ungated projection, because the property chain that defines it drops norma:appliesWhen, so case evaluation has to traverse the reified norma:Defeater instead."@en,
        "Temporal defeat is applied before the ordering is built, not as an edge in it. norma:TemporalDefeater bears on validity rather than applicability, so a norm it withdraws is absent from the system being stratified."@en,
        "Temporal defeat is also applied FLATLY, where defeat inside the ordering is evaluated under grounded semantics, and the asymmetry is substantive rather than technical: repealing a repealing norm does not revive the norm it repealed, so a chain in which w1 repeals w2 and w2 repealed w3 leaves both w2 and w3 outside the system. A norm merely rendered inapplicable by an exception is reinstated when that exception falls, because it never left the system; a repealed norm has left it. The reading is a DEFAULT recorded as an assumption, not a universal claim. It follows the civil-law tradition, where article 2.2 of the Spanish Civil Code states it expressly, but interpretation acts differ across jurisdictions and nothing in the ontology settles the question: a consumer whose jurisdiction provides otherwise overrides the reading and says so in the activity’s assumptions."@en .

normad:NormEvaluation a owl:Class ;
    rdfs:label "Norm Evaluation"@en ;
    rdfs:comment "The outcome computed for one norm within one prevalence ordering: its level in the ladder and whether the norm applies to the case."@en ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:subClassOf prov:Entity,
        [ a owl:Restriction ;
            owl:onProperty normad:evaluatedNorm ;
            owl:onClass norma:NormativeContent ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty normad:inOrdering ;
            owl:onClass normad:PrevalenceOrdering ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty normad:hasApplicabilityStatus ;
            owl:onClass normad:ApplicabilityStatus ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:scopeNote "Reified following the W3C n-ary relation pattern, as norma:TriggerEvent, norma:LegalPosition, norma:Defeater and norma:WeakPermission are. Reification is not optional here: one norm has as many outcomes as there are cases evaluated, so the status cannot be a property of the norm itself."@en,
        "The status is optional, and its absence is meaningful: an evaluation belonging to the STATIC ordering carries a level and no status, because the static ladder orders the normative system without deciding any case. Only a case-relative ordering yields a status."@en .

normad:ApplicabilityStatus a owl:Class ;
    rdfs:label "Applicability Status"@en ;
    rdfs:comment "The label assigned to a norm by evaluating a described case: whether the norm applies to it, and if not, why not."@en ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:subClassOf skos:Concept ;
    skos:scopeNote "Named for APPLICABILITY and not for being in force, because NORMA-O separates the two and this evaluation settles only the second: in legal usage a norm is in force as a matter of temporal validity, which norma:TemporalDefeater and norma:NormStatus govern, whereas what a case decides is whether the norm reaches that case. Calling an excepted norm “not in force” would contradict the very distinction the defeasibility layer is built on, since an exception leaves the norm in the system."@en,
        "Five values, and three different reasons a norm may fail to apply, which a consumer must be able to tell apart: it may have left the normative system (normad:Invalid), it may be in the system but untriggered by the facts of the case (normad:NotActivated), or it may be triggered and then set aside by a defeater (normad:Defeated). The values are assigned in that order of precedence, so that the most basic reason is the one reported: validity first, activation next, and the defeat labelling only for norms that are valid and activated."@en .

normad:PrevalenceCycle a owl:Class ;
    rdfs:label "Prevalence Cycle"@en ;
    rdfs:comment "A cycle found in a defeat digraph, reported rather than resolved. Full acyclicity is not expressible in OWL 2 DL, so it is checked by the compilation step: Kahn’s algorithm yields the stratification and the set of nodes it cannot order, while the cycles themselves are the non-trivial strongly connected components of that set."@en ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:subClassOf prov:Entity,
        [ a owl:Restriction ;
            owl:onProperty normad:involvesNorm ;
            owl:onClass norma:NormativeContent ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ] ;
    skos:scopeNote "A cycle is not automatically an error. Per norma:ConflictDefeater, two conflict defeaters relating the same pair in opposite directions under DIFFERENT resolution principles are a second-degree conflict in Bobbio’s sense: the criteria are genuinely unordered for that pair, and the compilation step must report one ordering per admissible policy instead of silently choosing one. The same pair asserted under the SAME principle is, by contrast, a contradiction in the annotation. normad:CycleKind records which reading applies."@en,
        "Lying on a cycle does NOT by itself leave a norm undecided, and the two must not be conflated. Grounded semantics still decides a cycle that is attacked from outside it: where a and b defeat each other and an undefeated c defeats a, the labelling is c applicable, a defeated and b applicable, because b is reinstated once its only attacker falls. Conversely a norm OFF the cycle whose only attackers lie on an undecided one is itself undecided. So normad:Undecided tracks what the fixpoint leaves unlabelled, not cycle membership, and this class reports the cycle as a finding about the annotation independently of how the norms on it end up labelled."@en .

normad:CycleKind a owl:Class ;
    rdfs:label "Cycle Kind"@en ;
    rdfs:comment "The legal reading of a cycle in the defeat digraph."@en ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:subClassOf skos:Concept .

# =============================================================================
# Properties
# =============================================================================

normad:computedUnderAssumption a owl:ObjectProperty ;
    rdfs:label "computed under assumption"@en ;
    rdfs:comment "Links a derivation activity to an assumption its conclusions depend on. Not functional: a derivation typically relies on several."@en ;
    rdfs:domain normad:DerivationActivity ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range normad:Assumption ;
    owl:inverseOf normad:isAssumptionOf .

normad:isAssumptionOf a owl:ObjectProperty ;
    rdfs:label "is assumption of"@en ;
    rdfs:comment "Links an assumption to the derivation activities that rely on it."@en ;
    rdfs:domain normad:Assumption ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range normad:DerivationActivity ;
    owl:inverseOf normad:computedUnderAssumption .

normad:ruleSetVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "rule set version"@en ;
    rdfs:comment "Identifier of the rule set, and of its version, applied by a derivation activity. Two runs that report the same rule set version over the same input graph must produce the same output graph."@en ;
    rdfs:domain normad:DerivationActivity ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range xsd:string .

normad:derivedGraph a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "derived graph"@en ;
    rdfs:comment "Name of the graph into which a derivation activity wrote its conclusions. Keeping derived conclusions in a named graph of their own is what allows them to be regenerated wholesale without touching the annotation graph."@en ;
    rdfs:domain normad:DerivationActivity ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range xsd:anyURI .

normad:forFactPattern a owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "for fact pattern"@en ;
    rdfs:comment "Links a prevalence ordering to the single described case it was computed for. Absent on the static ordering over the whole normative system."@en ;
    rdfs:domain normad:PrevalenceOrdering ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range norma:FactPattern .

normad:evaluatedNorm a owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "evaluated norm"@en ;
    rdfs:comment "Links an evaluation to the normative content it is about."@en ;
    rdfs:domain normad:NormEvaluation ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range norma:NormativeContent .

normad:inOrdering a owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "in ordering"@en ;
    rdfs:comment "Links an evaluation to the prevalence ordering it belongs to."@en ;
    rdfs:domain normad:NormEvaluation ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range normad:PrevalenceOrdering .

normad:hasApplicabilityStatus a owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "has applicability status"@en ;
    rdfs:comment "Associates an evaluation with at most one applicability status: the outcome the case yields for that norm."@en ;
    rdfs:domain normad:NormEvaluation ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range normad:ApplicabilityStatus .

normad:involvesNorm a owl:ObjectProperty ;
    rdfs:label "involves norm"@en ;
    rdfs:comment "Links a reported cycle to a norm lying on it."@en ;
    rdfs:domain normad:PrevalenceCycle ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range norma:NormativeContent .

normad:hasCycleKind a owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "has cycle kind"@en ;
    rdfs:comment "Associates a reported cycle with its legal reading."@en ;
    rdfs:domain normad:PrevalenceCycle ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range normad:CycleKind .

normad:citesCompetingPrinciple a owl:ObjectProperty ;
    rdfs:label "cites competing principle"@en ;
    rdfs:comment "Links a reported cycle to a resolution principle cited by one of the conflict defeaters on it. Two or more values are what make the cycle a second-degree conflict rather than an annotation error."@en ;
    rdfs:domain normad:PrevalenceCycle ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range norma:ResolutionPrinciple .

normad:inCycle a owl:ObjectProperty ;
    rdfs:label "in cycle"@en ;
    rdfs:comment "Links a prevalence ordering to a cycle found while computing it."@en ;
    rdfs:domain normad:PrevalenceOrdering ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range normad:PrevalenceCycle .

normad:reachesParty a owl:ObjectProperty ;
    rdfs:label "reaches party"@en ;
    rdfs:comment "Links a norm evaluation to a concrete party the evaluated norm reaches in that case: either the norm addresses that party directly, or it addresses a role the case places the party in."@en ;
    rdfs:domain normad:NormEvaluation ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range norma:LegalParty ;
    skos:scopeNote "Reach and applicability are separate questions, and both are needed to answer “what applies to this party”. This property says the norm is ADDRESSED to the party in the case; normad:hasApplicabilityStatus says whether it applies at all. A norm may reach a party and still be normad:Defeated, normad:NotActivated or normad:Invalid, so a consumer joins the two rather than reading either alone."@en,
        "Case-relative by construction, because norma:RoleAssignment is: the same party is reached by different norms in different cases, which is the point of a provision such as article 25(1) of Regulation (EU) 2024/1689. Computed, never annotated — asserting it would desynchronise it from the roles and the facts it follows from."@en .

normad:prevalenceLevel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "prevalence level"@en ;
    rdfs:comment "The rung of the ladder: 0 for a norm that nothing prevails over, and otherwise one more than the highest level among the norms that prevail over it. Longest-path layering, so the level is canonical for a given digraph."@en ;
    rdfs:domain normad:NormEvaluation ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:scopeNote "A low level means nothing defeats the norm, not that the norm prevails: a norm at level 0 may still be invalid or untriggered, and a norm at a higher level may well apply because everything that defeats it is itself defeated. The level orders the digraph; normad:hasApplicabilityStatus says what the case yields. Computed on the CONDENSATION of the digraph into strongly connected components, so every norm in the system receives a rung: a cycle contracts to a single node and the norms on it share its level. Layering on the digraph itself would leave the acyclic DESCENDANTS of a cycle without a level, although their position in the ladder is perfectly determined by the norms above and below them."@en .

normad:isAcyclic a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "is acyclic"@en ;
    rdfs:comment "Whether the defeat digraph of this ordering was found to be acyclic. Reported, never assumed: it is the by-product of the topological sort."@en ;
    rdfs:domain normad:PrevalenceOrdering ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range xsd:boolean .

normad:stratumCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "stratum count"@en ;
    rdfs:comment "Number of rungs in the ladder: one more than the highest prevalence level reached."@en ;
    rdfs:domain normad:PrevalenceOrdering ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    rdfs:range xsd:nonNegativeInteger .

# =============================================================================
# Controlled vocabulary individuals
# =============================================================================

normad:ClosedCaseDescription a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Closed case description"@en ;
    rdfs:comment "Silence in a norma:FactPattern about a legal condition is read as that condition not holding, so a norm conditioned on it counts as inactive."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "CLOSED_CASE" ;
    skos:prefLabel "Closed case description"@en ;
    skos:scopeNote "The description of the case is taken to be complete. This is what makes a conclusion case-relative and precise — a conditional prohibition does not block in the cases where its condition is not activated — but it also means an incompletely described case yields conclusions that are stronger than the facts warrant. Completeness of the fact pattern is a data-quality obligation on the producer, not something the derivation can check."@en ;
    skos:topConceptOf normad:AssumptionScheme .

normad:ClosedGraph a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Closed graph"@en ;
    rdfs:comment "The absence of a norm from the evaluated graph is read as the absence of that norm from the normative system: negation by failure over the graph at hand."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "CLOSED_GRAPH" ;
    skos:prefLabel "Closed graph"@en ;
    skos:scopeNote "Every weak permission depends on this assumption, since a weak permission is the absence of a prohibition. Pair it with a bounded completeness claim about which sources were analysed, or the conclusion is only as strong as the graph is complete."@en ;
    skos:topConceptOf normad:AssumptionScheme .

normad:ReinstatementNotComputed a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Reinstatement not computed"@en ;
    rdfs:comment "Defeat was applied one level deep: a norm was treated as withdrawn whenever an applicable defeater exists, without checking whether that defeater is itself withdrawn."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "NO_REINSTATEMENT" ;
    skos:prefLabel "Reinstatement not computed"@en ;
    skos:scopeNote "Where a defeat chain is longer than one step, the conclusions are wrong: if A defeats B and B defeats C, then C is reinstated, and a one-level reading reports C as withdrawn. Computing reinstatement requires stratifying the prevalence digraph, which belongs to the evaluation layer, so a derivation that records this value is provisional for any case in which a defeater is itself defeated."@en ;
    skos:topConceptOf normad:AssumptionScheme .

normad:DefeatConsidered a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Defeat considered"@en ;
    rdfs:comment "Defeat relations were taken into account: norms withdrawn by an applicable defeater were treated as not holding for the case."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "DEFEAT_CONSIDERED" ;
    skos:prefLabel "Defeat considered"@en ;
    skos:scopeNote "Pairs with normad:DefeatNotConsidered, which is recorded when defeat was skipped. Absence of both is not to be read as either: this is an open-world vocabulary, and inferring a reading from a missing value is the very thing the module exists to prevent. An activity recording neither has simply not stated what it did."@en ;
    skos:topConceptOf normad:AssumptionScheme .

normad:Applicable a owl:NamedIndividual,
        skos:Concept,
        normad:ApplicabilityStatus ;
    rdfs:label "Applicable"@en ;
    rdfs:comment "The norm is valid, is activated by the facts of the case, and every defeater reaching it is itself defeated — or none reaches it. It applies."@en ;
    skos:inScheme normad:ApplicabilityStatusScheme ;
    skos:notation "APPLICABLE" ;
    skos:prefLabel "Applicable"@en ;
    skos:scopeNote "Reinstatement lands here. A norm set aside by a defeater whose own defeating norm is defeated becomes applicable again, which is why norma:prevailsOver is deliberately not transitive."@en ;
    skos:topConceptOf normad:ApplicabilityStatusScheme .

normad:Defeated a owl:NamedIndividual,
        skos:Concept,
        normad:ApplicabilityStatus ;
    rdfs:label "Defeated"@en ;
    rdfs:comment "The norm is valid and activated, but at least one defeater reaching it has a defeating norm that is itself applicable. It does not apply to this case."@en ;
    skos:inScheme normad:ApplicabilityStatusScheme ;
    skos:notation "DEFEATED" ;
    skos:prefLabel "Defeated"@en ;
    skos:scopeNote "Being defeated in a case says nothing about validity: the norm remains a member of the normative system and applies in cases where the defeater does not reach it. Contrast normad:Invalid."@en ;
    skos:topConceptOf normad:ApplicabilityStatusScheme .

normad:Undecided a owl:NamedIndividual,
        skos:Concept,
        normad:ApplicabilityStatus ;
    rdfs:label "Undecided"@en ;
    rdfs:comment "The asserted defeaters do not fix a label for the norm: the grounded fixpoint leaves it neither applicable nor defeated."@en ;
    skos:inScheme normad:ApplicabilityStatusScheme ;
    skos:notation "UNDECIDED" ;
    skos:prefLabel "Undecided"@en ;
    skos:scopeNote "Not an error value, and NOT a synonym for lying on a cycle. A cycle attacked from outside is still decided, while a norm off any cycle whose only attackers are undecided is itself undecided. What this value tracks is what the fixpoint leaves unlabelled; the cycle itself is reported separately with normad:PrevalenceCycle."@en,
        "Choosing a winner here would require a policy the ontology does not fix. Preferred or stable semantics would select one; see normad:GroundedSemantics."@en ;
    skos:topConceptOf normad:ApplicabilityStatusScheme .

normad:NotActivated a owl:NamedIndividual,
        skos:Concept,
        normad:ApplicabilityStatus ;
    rdfs:label "Not activated"@en ;
    rdfs:comment "The norm is valid but the facts of the case do not trigger it: none of the trigger events that activate it fires in the described case."@en ;
    skos:inScheme normad:ApplicabilityStatusScheme ;
    skos:notation "NOT_ACTIVATED" ;
    skos:prefLabel "Not activated"@en ;
    skos:scopeNote "Distinguished from normad:Defeated because the reasons differ and so do the remedies: an untriggered norm is simply silent about this case, whereas a defeated one spoke and was overridden. Collapsing the two would also report an untriggered norm as applicable merely because nothing defeats it, which is the conclusion this value exists to prevent."@en,
        "Several trigger events activating one norm are read in DISJUNCTION, as elsewhere in NORMA: the norm is activated if any of them fires. A norm with no activation condition at all is unconditional and never carries this value."@en ;
    skos:topConceptOf normad:ApplicabilityStatusScheme .

normad:Invalid a owl:NamedIndividual,
        skos:Concept,
        normad:ApplicabilityStatus ;
    rdfs:label "Invalid"@en ;
    rdfs:comment "The norm is not a member of the normative system being evaluated: it carries a lifecycle status that excludes it, or a temporal defeater has repealed it."@en ;
    skos:inScheme normad:ApplicabilityStatusScheme ;
    skos:notation "INVALID" ;
    skos:prefLabel "Invalid"@en ;
    skos:scopeNote "Reported rather than omitted. Leaving a repealed norm out of the evaluation would make it indistinguishable from a norm absent from the graph, and a consumer asking why a norm does not apply deserves the answer. This is the one value that concerns validity rather than applicability, and it is case-independent: a norm outside the system is outside it in every case."@en ;
    skos:topConceptOf normad:ApplicabilityStatusScheme .

normad:SecondDegreeConflict a owl:NamedIndividual,
        skos:Concept,
        normad:CycleKind ;
    rdfs:label "Second-degree conflict"@en ;
    rdfs:comment "The norms on the cycle are related by conflict defeaters citing different resolution principles, so the criteria themselves are unordered for that pair."@en ;
    skos:inScheme normad:CycleKindScheme ;
    skos:notation "SECOND_DEGREE" ;
    skos:prefLabel "Second-degree conflict"@en ;
    skos:scopeNote "A legal phenomenon in Bobbio's sense, not an annotation defect. The compilation step reports one prevalence ordering per admissible policy; normad:citesCompetingPrinciple names the criteria in competition."@en ;
    skos:topConceptOf normad:CycleKindScheme .

normad:AnnotationContradiction a owl:NamedIndividual,
        skos:Concept,
        normad:CycleKind ;
    rdfs:label "Annotation contradiction"@en ;
    rdfs:comment "The cycle is formed by conflict defeaters citing the SAME resolution principle in opposite directions, which one principle cannot sustain."@en ;
    skos:inScheme normad:CycleKindScheme ;
    skos:notation "ANNOTATION_CONTRADICTION" ;
    skos:prefLabel "Annotation contradiction"@en ;
    skos:scopeNote "An annotation defect to be fixed at source, unlike normad:SecondDegreeConflict."@en ;
    skos:topConceptOf normad:CycleKindScheme .

normad:IrresolubleAntinomy a owl:NamedIndividual,
        skos:Concept,
        normad:CycleKind ;
    rdfs:label "Irresoluble antinomy"@en ;
    rdfs:comment "The cycle involves defeat that cites no resolution principle at all, typically a loop of exception defeaters, so nothing in the annotation orients it."@en ;
    skos:inScheme normad:CycleKindScheme ;
    skos:notation "IRRESOLUBLE" ;
    skos:prefLabel "Irresoluble antinomy"@en ;
    skos:topConceptOf normad:CycleKindScheme .

normad:DefeatNotConsidered a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Defeat not considered"@en ;
    rdfs:comment "Defeat relations were ignored: every valid and activated norm was treated as applying, whatever defeaters reach it."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "DEFEAT_NOT_CONSIDERED" ;
    skos:prefLabel "Defeat not considered"@en ;
    skos:scopeNote "A legitimate reading for a fast or partial derivation, and the explicit complement of normad:DefeatConsidered, which exists so that no consumer has to infer the reading from a missing value. Conclusions recorded under it are wrong in exactly the cases the defeasibility layer exists to handle, such as an exception that exempts the agent, so they are provisional. Mutually exclusive with normad:DefeatConsidered; validate with SHACL."@en ;
    skos:topConceptOf normad:AssumptionScheme .

normad:InstitutionalFactsChained a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Institutional facts chained"@en ;
    rdfs:comment "The facts established by the constitutive rules that apply were fed back into the case, and the regulative norms were evaluated against the case so augmented."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "FACTS_CHAINED" ;
    skos:prefLabel "Institutional facts chained"@en ;
    skos:scopeNote "Its absence means norma:establishesTrigger was ignored and only the brute facts of the case were used. Conclusions computed that way are wrong wherever a regulative norm is conditioned on an institutional fact, which in Regulation (EU) 2024/1689 is the central case: the obligations of Articles 16 and 26 hang on being high-risk, and that is settled by the defeat chain of Article 6."@en,
        "The alternation terminates because the set of established facts only grows. What it cannot do is undo: a fact may gate a defeater that withdraws the very rule that established it, and the fact stays in the case. A derivation that detects this reports it rather than presenting a conclusion that quietly rests on a withdrawn rule."@en ;
    skos:topConceptOf normad:AssumptionScheme .

normad:OpenCounterparty a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Open counterparty"@en ;
    rdfs:comment "A counterparty that no annotator named is read as not disagreeing, rather than as a mismatch, when two norms or two legal positions are compared."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "OPEN_COUNTERPARTY" ;
    skos:prefLabel "Open counterparty"@en ;
    skos:scopeNote "Needed because norma:hasCounterparty is sparse in practice: a corpus annotated without it would yield no equivalence, no contradiction and no jural opposition at all. The permissive reading lets those surface, at the cost of a relation that a later annotation may refute, which makes it non-monotonic. Producers that annotate the counterparty throughout get the strict reading for free and need not record this value."@en ;
    skos:topConceptOf normad:AssumptionScheme .

normad:GroundedSemantics a owl:NamedIndividual,
        skos:Concept,
        normad:Assumption ;
    rdfs:label "Grounded semantics"@en ;
    rdfs:comment "Defeat was evaluated under Dung's grounded semantics: the unique minimal complete labelling, computed as a monotone fixpoint."@en ;
    skos:inScheme normad:AssumptionScheme ;
    skos:notation "GROUNDED" ;
    skos:prefLabel "Grounded semantics"@en ;
    skos:scopeNote "Recorded instead of normad:ReinstatementNotComputed once reinstatement is actually computed. The choice of semantics is not neutral: on a cyclic fragment, preferred or stable semantics would select winners where grounded semantics reports normad:Undecided, so a consumer comparing two derived graphs must compare their assumptions first."@en,
        "Computed as a monotone fixpoint and deliberately NOT in topological order. A single pass in topological order is wrong wherever a cycle is attacked from outside it: the norms on the cycle are then decided after all, and a norm downstream of them has to be labelled from those decisions, which a pass that skipped the unorderable nodes never made."@en ;
    skos:topConceptOf normad:AssumptionScheme .

# =============================================================================
# Other declarations
# =============================================================================

normad:ApplicabilityStatusScheme a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    skos:definition "SKOS concept scheme grouping the labels a case evaluation may assign to a norm: whether it applies, and if not, whether because it is outside the system, untriggered, defeated, or left undecided."@en ;
    skos:hasTopConcept normad:Applicable,
        normad:Defeated,
        normad:Invalid,
        normad:NotActivated,
        normad:Undecided ;
    skos:prefLabel "Applicability status scheme"@en .

normad:CycleKindScheme a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    skos:definition "SKOS concept scheme grouping the legal readings of a cycle in the defeat digraph."@en ;
    skos:hasTopConcept normad:AnnotationContradiction,
        normad:IrresolubleAntinomy,
        normad:SecondDegreeConflict ;
    skos:prefLabel "Cycle kind scheme"@en .

normad:AssumptionScheme a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/def/norma-o/deriv> ;
    skos:definition "Extensible SKOS concept scheme grouping the non-monotonic assumptions that NORMA derivation activities may rely on."@en ;
    skos:hasTopConcept normad:ClosedCaseDescription,
        normad:ClosedGraph,
        normad:DefeatConsidered,
        normad:DefeatNotConsidered,
        normad:GroundedSemantics,
        normad:OpenCounterparty,
        normad:InstitutionalFactsChained,
        normad:ReinstatementNotComputed ;
    skos:prefLabel "Assumption scheme"@en .

