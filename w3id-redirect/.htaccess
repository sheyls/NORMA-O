Options -MultiViews +FollowSymLinks
RewriteEngine on

# ──────────────────────────────────────────────────────────────────────────────
# NORMA-O ontology redirect
# Maintainer: Sheyla Leyva-Sánchez <sheylvsz01@gmail.com>
# GitHub:     https://github.com/sheyls/NORMA-O
# ──────────────────────────────────────────────────────────────────────────────

# Content negotiation must happen here at w3id, because GitHub Pages does not
# execute the generated documentation .htaccess files after a redirect.

# Version IRI: https://w3id.org/def/norma-o/1.0
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/index-en.html [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.nt [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.owl [R=303,L,NE]

RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.owl [R=303,L,NE]

# Unversioned ontology IRI: https://w3id.org/def/norma-o
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/development/norma-ontology-v1.rdf/documentation/ontology.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/development/norma-ontology-v1.rdf/documentation/index-en.html [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/development/norma-ontology-v1.rdf/documentation/ontology.nt [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/development/norma-ontology-v1.rdf/documentation/ontology.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/development/norma-ontology-v1.rdf/documentation/ontology.owl [R=303,L,NE]

RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/development/norma-ontology-v1.rdf/documentation/ontology.owl [R=303,L,NE]
