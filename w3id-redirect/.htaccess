Options -MultiViews +FollowSymLinks
RewriteEngine on

# ──────────────────────────────────────────────────────────────────────────────
# NORMA-O ontology redirect
# Maintainer: Sheyla Leyva-Sánchez <sheylvsz01@gmail.com>
# GitHub:     https://github.com/sheyls/NORMA-O
# ──────────────────────────────────────────────────────────────────────────────

# Content negotiation must happen here at w3id, because GitHub Pages does not
# execute the generated documentation .htaccess files after a redirect.

# Version IRI: https://w3id.org/def/norma-o/1.0
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/index-en.html [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.nt [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.owl [R=303,L,NE]

RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/ontology.owl [R=303,L,NE]

# Version 2.0 and the derivation module: documentation generated by OnToology
# (WIDOCO) and published on the gh-pages branch, as for version 1.0.

# Version IRI: https://w3id.org/def/norma-o/2.0
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^2\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^2\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/index-en.html [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^2\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.nt [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^2\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^2\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.owl [R=303,L,NE]

RewriteRule ^2\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.owl [R=303,L,NE]

# Derivation module, version IRI: https://w3id.org/def/norma-o/deriv/1.0
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^deriv/1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^deriv/1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/index-en.html [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^deriv/1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.nt [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^deriv/1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^deriv/1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.owl [R=303,L,NE]

RewriteRule ^deriv/1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.owl [R=303,L,NE]

# Derivation module IRI (latest): https://w3id.org/def/norma-o/deriv
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^deriv/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^deriv/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/index-en.html [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^deriv/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.nt [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^deriv/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^deriv/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.owl [R=303,L,NE]

RewriteRule ^deriv/?$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-o-deriv.rdf/documentation/ontology.owl [R=303,L,NE]

# Unversioned ontology IRI (latest, currently 2.0): https://w3id.org/def/norma-o
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/index-en.html [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.nt [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.owl [R=303,L,NE]

RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/release/2.0.0/norma-ontology-v2.rdf/documentation/ontology.owl [R=303,L,NE]
