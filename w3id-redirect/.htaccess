Options +FollowSymLinks
RewriteEngine on

# ──────────────────────────────────────────────────────────────────────────────
# NORMA-O ontology redirect
# Maintainer: Sheyla Leyva-Sánchez <sheylvsz01@gmail.com>
# GitHub:     https://github.com/sheyls/NORMA-O
# ──────────────────────────────────────────────────────────────────────────────

# Redirect versioned IRI /1.0 → release 1.0.0 documentation
RewriteRule ^1\.0/?$ https://sheyls.github.io/NORMA-O/OnToology/release/1.0.0/norma-ontology-v1.rdf/documentation/index-en.html [R=303,L]

# Redirect root IRI → latest (development) documentation
RewriteRule ^$ https://sheyls.github.io/NORMA-O/OnToology/development/norma-ontology-v1.rdf/documentation/index-en.html [R=303,L]
